---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const movies = await getCollection('movies');
const notable = [...movies].sort((a, b) => b.data.year - a.data.year).slice(0, 6);

const shortdramaAll = await getCollection('shortdrama');
const shortdramaPublished = shortdramaAll.filter((e) => e.data.status === 'published').slice(0, 3);

const awards = await getCollection('awards');

// Real journal content — the same three articles published in full on
// /news (src/pages/news.astro). There's no per-article route yet (news.astro
// is a single static page, not a content collection), so every card here
// links to /news rather than a slug that doesn't exist. Reusing the actual
// published text rather than inventing homepage-only copy.
const journal = [
  {
    label: 'Editorial',
    title: 'RESET makes the case for the one-person AI film crew',
    excerpt: "Max Barskih's RESET — written, directed, and entirely produced solo using Higgsfield AI — is the clearest sign yet that a single filmmaker can now credibly deliver a multi-location sci-fi short without a crew.",
    date: 'Sep 22, 2026',
    datetime: '2026-09-22',
    image: '/images/posters/reset-wide.webp',
  },
  {
    label: 'News',
    title: "What Echo Hunter's SAG-AFTRA sign-off actually means",
    excerpt: "Echo Hunter was produced with explicit performer consent and guild sign-off for re-rendering a live performance with Arcana AI's video model.",
    date: 'Jun 2, 2025',
    datetime: '2025-06-02',
    image: '/images/posters/echo-hunter-wide.webp',
  },
  {
    label: 'News',
    title: 'Toys "R" Us and the first wave of AI brand films',
    excerpt: "The Sora-produced Toys “R” Us spot was one of the first major brand commercials built with a text-to-video model.",
    date: 'May 10, 2024',
    datetime: '2024-05-10',
    image: undefined,
  },
];
---
<BaseLayout title="AI Movie Base" description="Discover AI-generated movies, AI films and series from filmmakers worldwide. Explore notable works, creator stories, AI short dramas and film festivals.">
  <style>
    /* ---- Hero ---- */
    /* Full-bleed to the true viewport edge regardless of <main>'s own
       1200px max-width — a plain negative margin only cancels main's
       padding, so on any screen wider than 1200px it left a visible gutter
       on each side (same bug already fixed on the genre hero). */
    .hero { width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; margin-top: -2rem; min-height: 420px; overflow: hidden; background: var(--soft) url(/images/home-hero.webp) center right / cover no-repeat; }
    /* The photo itself already fades to white on its left ~40%, which is
       exactly where heroCopy sits — this thin extra gradient just
       guarantees contrast for the text over any screen width/crop. */
    .hero::after {
      content: "";
      position: absolute; inset: 0;
      background: linear-gradient(90deg, var(--bg) 0%, var(--bg) 14%, rgba(255,255,255,.55) 30%, rgba(255,255,255,0) 50%);
    }
    .heroIn { position: relative; z-index: 1; min-height: 420px; display: flex; align-items: center; max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
    .heroCopy { max-width: 480px; padding: 40px 0; }
    .hero .eyebrow { font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--muted2); }
    .hero h1 { font-size: clamp(42px,5.2vw,68px); line-height: .99; letter-spacing: -0.03em; margin: 14px 0 18px; }
    .hero p { color: var(--muted); font-size: .96rem; line-height: 1.6; margin: 0 0 22px; max-width: 460px; }
    .heroActions { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 42px; font-size: .78rem; font-weight: 700; padding: 11px 18px; border-radius: 3px; border: 1px solid var(--line); background: #fff; color: var(--ink); }
    .btn.primary { background: var(--black); color: #fff; border-color: var(--black); }
    .btn:hover { opacity: .85; color: inherit; }

    /* ---- Shared section chrome ---- */
    .section { padding: 28px 0 29px; border-top: 1px solid var(--line); }
    .sectionHead { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 14px; }
    .sectionHead h2 { font-size: clamp(26px,3vw,32px); line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 4px; }
    .sectionHead .intro { color: var(--muted); font-size: .8rem; margin: 0; }
    .sectionHead .more { white-space: nowrap; font-size: .78rem; color: var(--ink); font-weight: 600; }
    .sectionHead .more:hover { text-decoration: underline; }

    /* ---- Notable movies ---- */
    .filmGrid { display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: 15px; }
    .filmGrid a { display: flex; flex-direction: column; min-width: 0; color: inherit; }
    /* Vertical poster cards — the poster's own 2/3 ratio, never cropped to
       a different shape (see README note on the earlier wide-crop version
       of this grid, which forced real 16:9 art into a near-square box). */
    .filmGrid img, .filmGrid .posterFallback { width: 100%; aspect-ratio: 2/3; object-fit: cover; border-radius: 4px; background: var(--soft); display: block; }
    .filmGrid strong { font-family: var(--serif); font-size: .92rem; margin-top: 9px; line-height: 1.22; font-weight: 700; }
    .filmGrid .muted { color: var(--muted2); font-size: .74rem; margin-top: 3px; }
    .filmGrid .tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 7px; }
    .filmGrid .tags span { background: var(--soft); color: var(--muted); border-radius: 3px; font-size: .64rem; padding: 3px 7px; }

    /* ---- Journal ---- */
    .journalGrid { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 22px; }
    .story { display: block; color: inherit; text-decoration: none; }
    .story img, .story .storyFallback { width: 100%; aspect-ratio: 1.75/1; object-fit: cover; border-radius: 4px; background: var(--soft); display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: .8rem; font-weight: 700; text-align: center; padding: 10px; }
    .story small { display: block; margin-top: 9px; font-size: .62rem; text-decoration: underline; letter-spacing: .06em; color: var(--muted2); text-transform: uppercase; }
    .story strong { display: block; font-family: var(--serif); font-size: 1.12rem; line-height: 1.15; margin: 5px 0 8px; color: var(--ink); font-weight: 700; }
    .story p { color: var(--muted); font-size: .76rem; line-height: 1.5; margin: 0 0 9px; }
    .story time { font-size: .7rem; color: var(--muted2); }

    /* ---- Short drama ---- */
    .shortLayout { display: grid; grid-template-columns: 1.05fr 1.45fr; gap: 38px; align-items: center; }
    .shortLayout h2 { font-size: 2.1rem; margin: 10px 0 12px; }
    .shortLayout p { color: var(--muted); font-size: .88rem; line-height: 1.55; margin: 0 0 14px; }
    .shortImages { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; }
    .shortImages a { display: block; }
    .shortImages img, .shortImages .dramaFallback { width: 100%; aspect-ratio: .66; object-fit: cover; border-radius: 4px; background: var(--soft); display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: .72rem; font-weight: 700; text-align: center; padding: 8px; }

    /* ---- Festivals ---- */
    .festivalGrid { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 10px; }
    .festivalCard { display: flex; align-items: center; gap: 10px; min-height: 77px; border: 1px solid var(--line); border-radius: 5px; padding: 12px; background: #fff; }
    .festivalCard:hover { border-color: #aab8c6; }
    .fmark { width: 41px; flex: none; text-align: center; font-size: 1.7rem; font-weight: 900; letter-spacing: -0.1em; color: var(--ink); }
    .festivalCard strong { display: block; font-family: var(--serif); font-size: .76rem; line-height: 1.15; font-weight: 700; }
    .festivalCard span { display: block; color: var(--muted2); font-size: .64rem; margin-top: 4px; }

    /* ---- Newsletter (full-bleed dark, matching the footer) ---- */
    .newsletter { background: var(--black); color: #fff; margin: 0 -2rem; }
    .newsletterIn { max-width: 1200px; margin: 0 auto; padding: 28px 2rem; display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: center; }
    .newsletter .eyebrow { font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #9aa4b2; }
    .newsletter h2 { font-size: 1.7rem; line-height: 1.12; margin: 6px 0; }
    .newsletter p { font-size: .8rem; color: #b8c1cc; margin: 0; }
    .newsletter form { display: flex; }
    .newsletter input { flex: 1; min-width: 0; background: #232a32; border: 1px solid #3b444e; border-radius: 4px 0 0 4px; color: #fff; padding: 12px; font-size: .86rem; }
    .newsletter button { border: 0; border-radius: 0 4px 4px 0; padding: 0 21px; background: #fff; color: #111; font-weight: 700; cursor: pointer; }
    .newsletter .fineprint { font-size: .68rem; color: #8b94a1; margin-top: 7px; }
    .newsletter #subscribeNotice { font-size: .76rem; color: #9ec2ff; min-height: 1.1em; margin-top: 5px; }

    @media (max-width: 900px) {
      .filmGrid { grid-template-columns: repeat(3,minmax(0,1fr)); }
      .journalGrid { grid-template-columns: 1fr; }
      .shortLayout { grid-template-columns: 1fr; }
      .festivalGrid { grid-template-columns: repeat(3,minmax(0,1fr)); }
      .newsletterIn { grid-template-columns: 1fr; }
    }
    @media (max-width: 650px) {
      .festivalGrid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    }
  </style>

  <section class="hero">
    <div class="heroIn">
      <div class="heroCopy">
        <div class="eyebrow">Discover AI movies, series &amp; the people behind them</div>
        <h1>A new era<br />of cinema is<br />already here.</h1>
        <p>AIMB is an independent platform for AI-generated movies, AI-assisted films and series. Discover remarkable works, the creators behind them, festival recognition and the emerging tools shaping a new cinematic language.</p>
        <div class="heroActions">
          <a class="btn primary" href="/movies">Explore AI Movies &amp; Series →</a>
          <a class="btn" href="/short-drama">Explore AI Short Drama</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="sectionHead">
      <div>
        <h2>Notable AI Movies &amp; Series</h2>
        <p class="intro">Discover noteworthy AI-generated movies, films and series from our growing database.</p>
      </div>
      <a class="more" href="/movies">Explore all titles →</a>
    </div>
    <div class="filmGrid">
      {notable.map((movie) => (
        <a href={`/movies/${movie.id}`} aria-label={`Read about ${movie.data.title}`}>
          {movie.data.poster ? (
            <img src={movie.data.poster} alt={movie.data.title} loading="lazy" />
          ) : (
            <div class="posterFallback">{movie.data.title}</div>
          )}
          <strong>{movie.data.title}</strong>
          <span class="muted">{movie.data.year}</span>
          {movie.data.genres.length > 0 && (
            <span class="tags">{movie.data.genres.slice(0, 2).map((g) => <span>{g}</span>)}</span>
          )}
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="sectionHead">
      <div>
        <h2>From the Journal</h2>
        <p class="intro">Articles, interviews and practical guides exploring the people and ideas shaping AI films.</p>
      </div>
      <a class="more" href="/news">View all articles →</a>
    </div>
    <div class="journalGrid">
      {journal.map((j) => (
        <a class="story" href="/news">
          {j.image ? <img src={j.image} alt={j.title} loading="lazy" /> : <div class="storyFallback">{j.title}</div>}
          <small>{j.label}</small>
          <strong>{j.title}</strong>
          <p>{j.excerpt}</p>
          <time datetime={j.datetime}>{j.date}</time>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="shortLayout">
      <div>
        <div class="eyebrow">Vertical stories · Global audience</div>
        <h2>Discover AI Short Dramas</h2>
        <p>Explore a new form of vertical, episodic storytelling. AI short dramas combine compact stories, new production techniques and emerging creative voices.</p>
        <a class="more" href="/short-drama">Explore AI Short Drama →</a>
      </div>
      <div class="shortImages">
        {Array.from({ length: 3 }).map((_, i) => {
          const d = shortdramaPublished[i];
          return d ? (
            <a href={`/shortdrama/${d.id}`}>
              {d.data.poster ? <img src={d.data.poster} alt={d.data.title} loading="lazy" /> : <div class="dramaFallback">{d.data.title}</div>}
            </a>
          ) : (
            <a href="/short-drama"><div class="dramaFallback">Coming soon</div></a>
          );
        })}
      </div>
    </div>
  </section>

  {awards.length > 0 && (
    <section class="section">
      <div class="sectionHead">
        <div>
          <h2>AI Film Festivals</h2>
          <p class="intro">Explore international festivals recognizing AI-generated movies and AI-assisted films.</p>
        </div>
        <a class="more" href="/awards">View all festivals →</a>
      </div>
      <div class="festivalGrid">
        {awards.map((a) => (
          <a class="festivalCard" href={`/awards/${a.id}`}>
            <b class="fmark">{a.data.name.charAt(0)}</b>
            <div><strong>{a.data.name}</strong><span>{a.data.location ?? ''}</span></div>
          </a>
        ))}
        <a class="festivalCard" href="/awards">
          <b class="fmark">+</b>
          <div><strong>More festivals</strong><span>View the full directory</span></div>
        </a>
      </div>
    </section>
  )}

  <section class="newsletter">
    <div class="newsletterIn">
      <div>
        <div class="eyebrow">Stay updated</div>
        <h2>Stay in the Loop</h2>
        <p>A monthly edit of AI movies, creator stories and film festival news.</p>
      </div>
      <div>
        <form id="newsletterForm">
          <input type="email" aria-label="Email address" placeholder="Your email address" required />
          <button type="submit">Subscribe</button>
        </form>
        <p class="fineprint">Unsubscribe anytime. Newsletter service is not connected yet.</p>
        <p id="subscribeNotice" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <script is:inline>
    document.getElementById('newsletterForm')?.addEventListener('submit', function (e) {
      e.preventDefault();
      var notice = document.getElementById('subscribeNotice');
      if (notice) notice.textContent = "Thanks — newsletter delivery isn't connected yet, so nothing was sent.";
    });
  </script>
</BaseLayout>
