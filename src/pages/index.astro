---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const movies = await getCollection('movies');
// Notable is otherwise fully computed (newest first, no hand-picked
// slugs — see the comment below), but "1001 Aladdin and The Lamp" only
// ever led this row because of an alphabetical tie-break among a pile of
// same-year films, not real curation. Swapped out for "You Became CEO of
// Zara" by explicit request; everything else in the row is still decided
// by the normal sort.
const NOTABLE_EXCLUDE = new Set(['1001-aladdin-and-the-lamp', 'alien-invasion-ep3-total-war-begins']);
const NOTABLE_PINNED = ['you-became-ceo-of-zara', 'the-elevator'];
const notablePool = movies.filter((m) => !NOTABLE_EXCLUDE.has(m.id));
const pinned = NOTABLE_PINNED.map((slug) => notablePool.find((m) => m.id === slug)).filter(
  (m): m is CollectionEntry<'movies'> => Boolean(m)
);
const rest = notablePool
  .filter((m) => !NOTABLE_PINNED.includes(m.id))
  .sort((a, b) => b.data.year - a.data.year);
const notable = [...pinned, ...rest].slice(0, 6);

// Award-winning films: any movie whose real `awards` field is non-empty,
// excluding anything already shown above in Notable so the two homepage
// grids don't just repeat each other. No hand-picked slugs here — this is
// computed from the catalog so it stays correct as new winners are added.
const notableIds = new Set(notable.map((m) => m.id));
const awardWinners = movies
  .filter((m) => (m.data.awards?.length ?? 0) > 0 && !notableIds.has(m.id))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 6);

const shortdramaAll = await getCollection('shortdrama');
const shortdramaPublished = shortdramaAll.filter((e) => e.data.status === 'published').slice(0, 3);

const awards = await getCollection('awards');

// AI Film Lists: the real /lists collection (all four exist today — two
// hand-curated, two mechanically grouped "starter lists", see
// src/content/lists and the README). Covers are a Letterboxd-style fanned
// poster stack built from each list's own real movie posters (up to 6,
// however many actually have one) rather than a single cropped cover —
// matching the homepage reference's list-card art without inventing
// artwork for lists that don't have six real posters.
const homeLists = (await getCollection('lists')).slice(0, 4);
function listPosters(list: CollectionEntry<'lists'>, max = 6) {
  return list.data.movies
    .map((slug) => movies.find((m) => m.id === slug))
    .filter((m): m is CollectionEntry<'movies'> => Boolean(m?.data.poster))
    .slice(0, max);
}

// "2026 · AI Movie · Sci-Fi" style single-line taxonomy, as in the homepage
// reference, built from the movie's own real year/type/genre fields.
function taxonomy(movie: CollectionEntry<'movies'>) {
  const parts = [String(movie.data.year), movie.data.type === 'series' ? 'AI Series' : 'AI Movie'];
  if (movie.data.genres.length > 0) parts.push(movie.data.genres[0]);
  return parts.join(' · ');
}

// Real journal content, shared with /news and /news/[slug] (the `articles`
// content collection, src/content/articles) so the homepage teaser, the
// listing and each article's own permalink never drift out of sync.
const journal = (await getCollection('articles'))
  .sort((a, b) => new Date(b.data.datetime).getTime() - new Date(a.data.datetime).getTime())
  .slice(0, 3);
---
<BaseLayout title="AI Movie Base" description="Discover AI-generated movies, AI films and series from filmmakers worldwide. Explore notable works, creator stories, AI short dramas and film festivals.">
  <style>
    /* ---- Hero ---- */
    /* Full-bleed to the true viewport edge regardless of <main>'s own
       1200px max-width — a plain negative margin only cancels main's
       padding, so on any screen wider than 1200px it left a visible gutter
       on each side (same bug already fixed on the genre hero). */
    /* Dark, photographic hero — eclipse-and-tree artwork with a radial
       vignette for text contrast, replacing the earlier light crop-fade
       treatment per the new homepage reference. Horizontal full-bleed
       comes from the shared .full-bleed class (see BaseLayout.astro);
       this rule only owns the hero's own vertical/visual properties. */
    .hero { margin-top: -2rem; min-height: 420px; overflow: hidden; background: #080b11 url(/images/home-hero.webp) center center / cover no-repeat; }
    .hero::after {
      content: "";
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 54% 85% at 50% 46%, transparent 18%, rgba(5,7,13,.13) 57%, rgba(3,5,10,.76) 100%);
    }
    .heroIn { position: relative; z-index: 1; min-height: 420px; display: flex; align-items: center; max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
    .heroCopy { max-width: 480px; padding: 40px 0; }
    .hero .eyebrow {
      font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
      width: fit-content; max-width: 100%;
      background: linear-gradient(105deg,#ffc18a 0%,#ee8a55 40%,#ffb77e 73%,#e4774d 100%);
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 1px 5px rgba(0,0,0,.4));
    }
    .hero h1 { color: #fff; font-size: clamp(42px,5.2vw,68px); line-height: .99; letter-spacing: -0.03em; margin: 14px 0 18px; text-shadow: 0 2px 14px rgba(0,0,0,.65); }
    .hero p { color: #fff; font-size: .96rem; line-height: 1.6; margin: 0 0 22px; max-width: 460px; text-shadow: 0 2px 14px rgba(0,0,0,.65); }
    .heroActions { display: flex; gap: 10px; flex-wrap: wrap; }
    .heroLink { display: inline-flex; align-items: center; gap: 9px; font-size: .95rem; font-weight: 700; color: #fff; text-decoration: none; text-shadow: 0 2px 14px rgba(0,0,0,.65); transition: color .2s ease; }
    .heroLink .arrow { font-weight: 900; transition: color .2s ease, transform .2s ease; }
    .heroLink:hover, .heroLink:focus-visible { color: #cf6246; }
    .heroLink:hover .arrow, .heroLink:focus-visible .arrow { transform: translateX(6px); }

    /* ---- Shared section chrome ---- */
    /* The whole heading is one clickable link (title + chevron), the same
       pattern as the reference's `.section-title-link` — no separate
       "View all" link floating on the right. */
    .section { padding: 28px 0 29px; border-top: 1px solid var(--line); }
    .sectionHead { margin-bottom: 14px; }
    .sectionTitleLink { display: inline-flex; align-items: center; gap: 13px; color: inherit; text-decoration: none; }
    .sectionTitleLink h2 { font-size: clamp(26px,3vw,32px); line-height: 1.1; letter-spacing: -0.02em; margin: 0; }
    .sectionTitleLink .arrow { font-weight: 900; font-size: 1.3rem; line-height: 1; color: var(--ink); transition: color .2s ease, transform .2s ease; }
    .sectionTitleLink:hover .arrow, .sectionTitleLink:focus-visible .arrow { color: #cf6246; transform: translateX(6px); }
    .sectionHead .intro { color: var(--muted); font-size: .8rem; margin: 8px 0 0; max-width: 680px; }

    /* ---- Notable movies / Award-winning films ---- */
    .filmGrid { display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: 15px; }
    .filmGrid a { display: flex; flex-direction: column; min-width: 0; color: inherit; }
    /* Vertical poster cards — the poster's own 2/3 ratio, never cropped to
       a different shape (see README note on the earlier wide-crop version
       of this grid, which forced real 16:9 art into a near-square box). */
    .filmGrid img, .filmGrid .posterFallback { width: 100%; aspect-ratio: 2/3; object-fit: cover; border-radius: 5px; border: 1px solid var(--line); background: var(--soft); display: block; transition: transform .2s ease, box-shadow .2s ease; }
    .filmGrid a:hover img { transform: translateY(-3px); box-shadow: 0 8px 23px rgba(0,0,0,.1); }
    .filmGrid a:hover strong, .filmGrid a:focus-visible strong { color: #cf6246; }
    .filmGrid strong { font-family: var(--serif); font-size: .92rem; margin-top: 10px; line-height: 1.22; font-weight: 700; }
    .filmGrid .taxonomy { display: block; margin-top: 5px; font-size: .72rem; color: var(--muted2); }

    /* ---- AI Film Lists — fanned poster stack, like the reference ---- */
    .listsGrid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 22px 16px; }
    .listsGrid .listCard { display: block; color: inherit; }
    .listsGrid .listArt { position: relative; isolation: isolate; overflow: hidden; aspect-ratio: 1.39/1; background: #fff; border: 1px solid var(--line); border-radius: 6px; }
    .listsGrid .listCover { position: absolute; top: 0; bottom: 0; height: 100%; object-fit: cover; object-position: center; box-shadow: -2px 0 9px rgba(0,0,0,.15); }
    .listsGrid .posterFallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: .64rem; font-weight: 700; text-align: center; padding: 8px; }
    .listsGrid h3 { font-family: var(--serif); font-size: .96rem; line-height: 1.2; margin: 10px 0 0; font-weight: 700; }
    .listsGrid .listCard:hover h3 { color: #cf6246; }
    .listsGrid .count { font-size: .68rem; color: var(--muted2); margin: 4px 0 0; }
    .listsGrid .placeholderTag { display: inline-block; font-size: .56rem; text-transform: uppercase; letter-spacing: .04em; background: var(--soft); color: var(--muted2); border-radius: 4px; padding: 2px 5px; margin-left: 4px; vertical-align: middle; }

    /* ---- Journal ---- */
    .journalGrid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 22px; }
    .story { display: block; color: inherit; text-decoration: none; }
    .story img, .story .storyFallback { width: 100%; aspect-ratio: 1.75/1; object-fit: cover; border-radius: 4px; background: var(--soft); display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: .8rem; font-weight: 700; text-align: center; padding: 10px; }
    .story small { display: block; margin-top: 9px; font-size: .62rem; text-decoration: underline; letter-spacing: .06em; color: var(--muted2); text-transform: uppercase; }
    .story strong { display: block; font-family: var(--serif); font-size: 1.12rem; line-height: 1.15; margin: 5px 0 8px; color: var(--ink); font-weight: 700; }
    .story:hover strong, .story:focus-visible strong { color: #cf6246; }
    .story p { color: var(--muted); font-size: .76rem; line-height: 1.5; margin: 0 0 9px; }
    .story time { font-size: .7rem; color: var(--muted2); }

    /* ---- Short drama ---- */
    .shortLayout { display: grid; grid-template-columns: minmax(0,1fr) 350px; gap: 40px; align-items: center; }
    .shortCopy h2 { font-size: clamp(30px,3vw,40px); margin: 0 0 11px; }
    .shortHeadingLink { display: inline-flex; align-items: center; gap: 13px; text-decoration: none; }
    .shortHeadingLink .label { color: var(--ink); }
    .shortHeadingLink .arrow { font-weight: 900; font-size: 1.3rem; line-height: 1; color: var(--ink); transition: color .2s ease, transform .2s ease; }
    .shortHeadingLink:hover .arrow, .shortHeadingLink:focus-visible .arrow { color: #cf6246; transform: translateX(6px); }
    .shortCopy p { color: var(--muted); font-size: .88rem; line-height: 1.55; margin: 0; max-width: 480px; }
    .shortGallery { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10px; background: var(--soft); border-radius: 8px; padding: 10px; }
    .shortGallery a { display: block; }
    .shortGallery img, .shortGallery .dramaFallback { width: 100%; aspect-ratio: 2/3; object-fit: cover; border-radius: 4px; background: #fff; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: .68rem; font-weight: 600; text-align: center; padding: 8px; }

    /* ---- Festivals ---- */
    .festivalGrid { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 10px; }
    .festivalCard { display: flex; align-items: center; gap: 10px; min-height: 77px; border: 1px solid var(--line); border-radius: 5px; padding: 12px; background: #fff; }
    .festivalCard:hover, .festivalCard:focus-visible { border-color: #aab8c6; }
    .festivalCard:hover strong, .festivalCard:focus-visible strong { color: #cf6246; }
    .fmark { width: 41px; flex: none; text-align: center; font-size: 1.7rem; font-weight: 900; letter-spacing: -0.1em; color: var(--ink); }
    .festivalCard strong { display: block; font-family: var(--serif); font-size: .76rem; line-height: 1.15; font-weight: 700; }
    .festivalCard span { display: block; color: var(--muted2); font-size: .64rem; margin-top: 4px; }

    /* ---- Newsletter (full-bleed dark, matching the footer) ---- */
    /* Horizontal full-bleed comes from the shared .full-bleed class (see
       BaseLayout.astro). It has no vertical margin of its own: the
       zero-gap join with the footer below is controlled in one place,
       by BaseLayout zeroing <main>'s bottom padding on pages that
       contain this section — see BaseLayout.astro for that rule. */
    .newsletter { background: var(--black); color: #fff; }
    .newsletterIn { max-width: 1200px; margin: 0 auto; padding: 28px 2rem; display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: center; }
    .newsletter .eyebrow { font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #9aa4b2; }
    .newsletter h2 { font-size: 1.7rem; line-height: 1.12; margin: 6px 0; }
    .newsletter p { font-size: .8rem; color: #b8c1cc; margin: 0; }
    .newsletter form { display: flex; }
    .newsletter input { flex: 1; min-width: 0; background: #232a32; border: 1px solid #a94a38; border-radius: 4px 0 0 4px; color: #fff; padding: 12px; font-size: .86rem; }
    .newsletter input:focus, .newsletter input:focus-visible { outline: 2px solid #ec8c66; outline-offset: 2px; border-color: #ec8c66; }
    .newsletter button {
      border: 1px solid #be6044; border-radius: 0 4px 4px 0; padding: 0 21px; font-weight: 700; cursor: pointer;
      background: linear-gradient(112deg,#ab3f34 0%,#df754d 35%,#ffc18a 63%,#dc6847 100%); color: #27100d;
      transition: filter .2s ease, box-shadow .2s ease;
    }
    .newsletter button:hover, .newsletter button:focus-visible { filter: brightness(1.08); box-shadow: 0 3px 15px rgba(216,164,59,.35); }
    .newsletter .fineprint { font-size: .68rem; color: #8b94a1; margin-top: 7px; }
    .newsletter #subscribeNotice { font-size: .76rem; color: #ffc18a; min-height: 1.1em; margin-top: 5px; }

    @media (max-width: 900px) {
      .filmGrid { grid-template-columns: repeat(3,minmax(0,1fr)); }
      .journalGrid { grid-template-columns: 1fr; }
      .shortLayout { grid-template-columns: 1fr; }
      .shortGallery { max-width: 420px; }
      .festivalGrid { grid-template-columns: repeat(3,minmax(0,1fr)); }
      .newsletterIn { grid-template-columns: 1fr; }
      .listsGrid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    }
    @media (max-width: 650px) {
      .festivalGrid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    }
  </style>

  <section class="hero full-bleed">
    <div class="heroIn">
      <div class="heroCopy">
        <div class="eyebrow">AIMB — made by people, for people.</div>
        <h1>A new era<br />of cinema is<br />already here</h1>
        <p>AIMB is an independent platform for AI-generated movies, AI-assisted films and series. Discover remarkable works, the creators behind them, festival recognition and the emerging tools shaping a new cinematic language.</p>
        <div class="heroActions">
          <a class="heroLink" href="/movies">Explore AI Movies &amp; Series <span class="arrow" aria-hidden="true">❯</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="sectionHead">
      <a class="sectionTitleLink" href="/movies">
        <h2>Notable AI Movies &amp; Series</h2>
        <span class="arrow" aria-hidden="true">❯</span>
      </a>
      <p class="intro">Discover noteworthy AI-generated movies, films and series from our growing database.</p>
    </div>
    <div class="filmGrid">
      {notable.map((movie) => (
        <a href={`/movies/${movie.id}`} aria-label={`Read about ${movie.data.title}`}>
          {movie.data.poster ? (
            <img src={movie.data.poster} alt={movie.data.title} loading="lazy" />
          ) : (
            <div class="posterFallback">{movie.data.title}</div>
          )}
          <strong>{movie.data.title}</strong>
          <span class="taxonomy">{taxonomy(movie)}</span>
        </a>
      ))}
    </div>
  </section>

  {awardWinners.length > 0 && (
    <section class="section">
      <div class="sectionHead">
        <a class="sectionTitleLink" href="/lists/award-winners-nominees">
          <h2>Award-Winning AI Films</h2>
          <span class="arrow" aria-hidden="true">❯</span>
        </a>
        <p class="intro">AI-generated films recognized with a real festival win or selection in the catalog.</p>
      </div>
      <div class="filmGrid">
        {awardWinners.map((movie) => (
          <a href={`/movies/${movie.id}`} aria-label={`Read about ${movie.data.title}`}>
            {movie.data.poster ? (
              <img src={movie.data.poster} alt={movie.data.title} loading="lazy" />
            ) : (
              <div class="posterFallback">{movie.data.title}</div>
            )}
            <strong>{movie.data.title}</strong>
            <span class="taxonomy">{taxonomy(movie)}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <div class="sectionHead">
      <a class="sectionTitleLink" href="/news">
        <h2>From the Journal</h2>
        <span class="arrow" aria-hidden="true">❯</span>
      </a>
      <p class="intro">Articles, interviews and practical guides exploring the people and ideas shaping AI films.</p>
    </div>
    <div class="journalGrid">
      {journal.map((j) => (
        <a class="story" href={`/news/${j.id}`}>
          {j.data.image ? <img src={j.data.image} alt={j.data.title} loading="lazy" /> : <div class="storyFallback">{j.data.title}</div>}
          <small>{j.data.label}</small>
          <strong>{j.data.title}</strong>
          <p>{j.data.excerpt}</p>
          <time datetime={j.data.datetime}>{j.data.date}</time>
        </a>
      ))}
    </div>
  </section>

  {homeLists.length > 0 && (
    <section class="section">
      <div class="sectionHead">
        <a class="sectionTitleLink" href="/lists">
          <h2>AI Film Lists</h2>
          <span class="arrow" aria-hidden="true">❯</span>
        </a>
        <p class="intro">Explore AIMB collections of award-winning, editor-selected and genre-defining AI films.</p>
      </div>
      <div class="listsGrid">
        {homeLists.map((list) => {
          const posters = listPosters(list);
          const n = posters.length;
          return (
            <a class="listCard" href={`/lists/${list.id}`}>
              <div class="listArt">
                {n > 0 ? posters.map((m, i) => {
                  const w = i === 0 ? 50 : 50 / Math.max(n - 1, 1);
                  const left = i === 0 ? 0 : 50 + (i - 1) * (50 / Math.max(n - 1, 1));
                  return (
                    <img class="listCover" src={m.data.poster} alt="" loading="lazy" style={`left:${left}%; width:${w}%; z-index:${i + 1};`} />
                  );
                }) : <div class="posterFallback">{list.data.name}</div>}
              </div>
              <h3>{list.data.name}{list.data.placeholder && <span class="placeholderTag">starter list</span>}</h3>
              <p class="count">{list.data.movies.length} films{list.data.placeholder ? '' : ' · ' + list.data.description}</p>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="section">
    <div class="shortLayout">
      <div class="shortCopy">
        <h2><a class="shortHeadingLink" href="/short-drama"><span class="label">Discover AI Short Dramas</span><span class="arrow" aria-hidden="true">❯</span></a></h2>
        <p>Explore a new form of vertical, episodic storytelling. AI short dramas combine compact stories, new production techniques and emerging creative voices.</p>
      </div>
      <div class="shortGallery">
        {Array.from({ length: 3 }).map((_, i) => {
          const d = shortdramaPublished[i];
          return d ? (
            <a href={`/shortdrama/${d.id}`}>
              {d.data.poster ? <img src={d.data.poster} alt={d.data.title} loading="lazy" /> : <div class="dramaFallback">{d.data.title}</div>}
            </a>
          ) : (
            <a href="/short-drama"><div class="dramaFallback">Coming soon</div></a>
          );
        })}
      </div>
    </div>
  </section>

  {awards.length > 0 && (
    <section class="section">
      <div class="sectionHead">
        <a class="sectionTitleLink" href="/awards">
          <h2>AI Film Festivals</h2>
          <span class="arrow" aria-hidden="true">❯</span>
        </a>
        <p class="intro">Explore international festivals recognizing AI-generated movies and AI-assisted films.</p>
      </div>
      <div class="festivalGrid">
        {awards.map((a) => (
          <a class="festivalCard" href={`/awards/${a.id}`}>
            <b class="fmark">{a.data.name.charAt(0)}</b>
            <div><strong>{a.data.name}</strong><span>{a.data.location ?? ''}</span></div>
          </a>
        ))}
        <a class="festivalCard" href="/awards">
          <b class="fmark">+</b>
          <div><strong>More festivals</strong><span>View the full directory</span></div>
        </a>
      </div>
    </section>
  )}

  <section class="newsletter full-bleed">
    <div class="newsletterIn">
      <div>
        <div class="eyebrow">Stay updated</div>
        <h2>Stay in the Loop</h2>
        <p>A monthly edit of AI movies, creator stories and film festival news.</p>
      </div>
      <div>
        <form id="newsletterForm">
          <input type="email" aria-label="Email address" placeholder="Your email address" required />
          <button type="submit">Subscribe</button>
        </form>
        <p class="fineprint">Unsubscribe anytime. Newsletter service is not connected yet.</p>
        <p id="subscribeNotice" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <script is:inline>
    document.getElementById('newsletterForm')?.addEventListener('submit', function (e) {
      e.preventDefault();
      var notice = document.getElementById('subscribeNotice');
      if (notice) notice.textContent = "Thanks — newsletter delivery isn't connected yet, so nothing was sent.";
    });
  </script>
</BaseLayout>
