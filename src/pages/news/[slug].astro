---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { imageDims } from '../../lib/images';

export async function getStaticPaths() {
  const movies = await getCollection('movies');
  const articles = await getCollection('articles');
  return articles.map((article) => {
    const featured = article.data.featuredMovieSlug
      ? movies.find((m) => m.id === article.data.featuredMovieSlug)
      : undefined;
    const related = articles.filter((other) => other.id !== article.id).slice(0, 3);
    return {
      params: { slug: article.id },
      props: { article, featured, related },
    };
  });
}

interface Props {
  article: CollectionEntry<'articles'>;
  featured?: CollectionEntry<'movies'>;
  related: CollectionEntry<'articles'>[];
}
const { article, featured, related } = Astro.props;
const a = article.data;

const headings = ((a.contentBlocks ?? []).filter((b) => b.type === 'heading')) as {
  type: 'heading'; id: string; text: string; tocLabel?: string;
}[];

// A ranked-list feature (see "Most Popular AI Series in 2026") has no
// heading blocks to build an "On This Page" nav from — instead its own
// listSummary block ("Inside this list") becomes the right-rail nav,
// with each numbered item linking to its matching rankedEntry's anchor
// by position (both arrays are authored in the same order).
const listSummary = (a.contentBlocks ?? []).find((b) => b.type === 'listSummary') as
  | { type: 'listSummary'; title: string; items: string[]; note?: string }
  | undefined;
const rankedEntries = ((a.contentBlocks ?? []).filter((b) => b.type === 'rankedEntry')) as {
  type: 'rankedEntry'; id?: string;
}[];
const listSummaryLinks = listSummary
  ? listSummary.items.map((item, i) => ({ label: item, href: rankedEntries[i]?.id ? `#${rankedEntries[i].id}` : undefined }))
  : [];
const hasSideNav = headings.length > 0 || !!listSummary;
---
<BaseLayout title={a.title} description={a.excerpt} image={a.image} imageAlt={a.imageAlt ?? a.title} ogType="article">
  <style>

    .masthead { max-width: 820px; margin: 0 0 30px; }
    .masthead .kicker { color: #cf6246; font-size: .72rem; letter-spacing: .15em; text-transform: uppercase; font-weight: 800; margin-bottom: 18px; }
    .masthead h1 { font: 400 clamp(36px,4.6vw,58px)/1.08 var(--serif); letter-spacing: -.03em; margin: 0 0 20px; }
    .masthead .lede { max-width: 700px; font: 19px/1.55 var(--serif); color: var(--muted); margin: 0 0 20px; }
    .articleMeta { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; font-size: .78rem; color: var(--muted2); border-top: 1px solid var(--line); padding-top: 16px; }
    .metaAuthor { display: flex; align-items: center; gap: 10px; }
    .authorIcon { background: var(--ink); color: #fff; border-radius: 50%; width: 32px; height: 32px; display: grid; place-items: center; font-size: 9px; font-weight: 800; }
    .articleMeta strong { color: var(--ink); }
    .shareTools { margin-left: auto; display: flex; gap: 7px; }
    .shareTools button { width: 32px; height: 32px; border: 1px solid var(--line); background: #fff; border-radius: 50%; font-size: .8rem; cursor: pointer; color: var(--muted); }
    .shareTools button:hover { color: #cf6246; border-color: #d5a08f; }

    .heroFigure { max-width: 1000px; margin: 28px 0 0; }
    .heroFigure img { width: 100%; height: auto; max-height: 480px; object-fit: cover; display: block; border-radius: 4px; }
    .heroFigure .fallback { width: 100%; aspect-ratio: 16/9; border-radius: 4px; background: var(--soft); display: flex; align-items: center; justify-content: center; color: var(--muted); font: 700 1rem var(--serif); }
    .heroFigure figcaption { color: var(--muted2); font-size: .72rem; margin-top: 9px; line-height: 1.6; }

    .articleWithToc { position: relative; display: grid; grid-template-columns: minmax(0,700px) minmax(0,210px); gap: 50px; max-width: 980px; margin: 40px 0 0; align-items: start; }
    .articleWithToc .articleContent { width: 100%; min-width: 0; margin: 0; }
    .articleToc { position: sticky; top: 24px; min-width: 0; align-self: start; }
    .articleTocInner { border-left: 1px solid var(--line); padding: 2px 0 6px 16px; }
    .articleTocTitle { color: var(--ink); font-size: .85rem; font-weight: 800; letter-spacing: -.01em; margin: 0 0 16px; }
    .articleTocLink { display: block; color: var(--muted2); font-size: .72rem; line-height: 1.5; padding: 6px 0 6px 11px; margin-left: -17px; border-left: 2px solid transparent; }
    .articleTocLink:hover { color: #cf6246; border-left-color: #cf6246; }
    .articleTocLink--plain { cursor: default; }
    .articleTocLink--plain:hover { color: var(--muted2); border-left-color: transparent; }
    .articleTocNote { font-size: .66rem; line-height: 1.6; color: var(--muted2); margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--line); }
    @media (max-width: 960px) {
      .articleWithToc { grid-template-columns: minmax(0,700px); gap: 0; }
      .articleToc { display: none; }
    }
    .articleWithToc.noToc { grid-template-columns: minmax(0,700px); }

    .articleContent { width: min(100%,700px); margin: 40px 0 0; font: 18px/1.8 var(--serif); color: #2c333c; }
    .articleContent p { margin: 0 0 24px; }
    .articleContent p a { color: #b74e34; border-bottom: 1px solid #dba58f; }
    .articleContent .leadPara { font-size: 1.1rem; color: #262d34; }
    .articleContent h2 { font: 400 1.85rem/1.22 var(--serif); letter-spacing: -.01em; color: var(--ink); margin: 42px 0 18px; scroll-margin-top: 28px; }

    .viewerQuote { margin: 24px 0 36px; border-left: 3px solid #cf6246; padding: 2px 0 2px 22px; }
    .viewerQuote blockquote { margin: 0; font: italic 1.25rem/1.55 var(--serif); color: #30343a; }
    .viewerQuote figcaption { margin-top: 10px; font-size: .72rem; color: var(--muted2); }

    .characterComparisons { margin: 26px 0 28px; display: grid; gap: 26px; }
    .characterComparison h3 { font: 400 1.5rem/1.25 var(--serif); margin: 0 0 10px; color: var(--ink); }
    .characterComparison h3 span { font-size: .72rem; color: var(--muted2); margin-left: 8px; font-family: Arial, sans-serif; }
    .characterFramePair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .compareFrame { margin: 0; background: var(--soft); overflow: hidden; border-radius: 4px; aspect-ratio: 1.35; }
    .compareFrame img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .characterComparisonCaption { font-size: .72rem; color: var(--muted2); margin: 9px 0 0; }
    @media (max-width: 650px) {
      .characterFramePair { gap: 7px; }
      .characterComparison h3 span { display: block; margin: 3px 0 0; }
    }

    .comparisonBlock { margin: 26px 0; padding: 18px; background: var(--soft); border: 1px solid var(--line); border-radius: 5px; font-family: Arial, sans-serif; }
    .comparisonLabel { font: 700 .68rem Arial, sans-serif; letter-spacing: .09em; text-transform: uppercase; color: #bf6349; margin-bottom: 14px; }
    .comparisonBlock table { width: 100%; border-collapse: collapse; font: .8rem/1.5 Arial, sans-serif; }
    .comparisonBlock th, .comparisonBlock td { border-bottom: 1px solid var(--line); padding: 11px 6px; text-align: left; vertical-align: top; }
    .comparisonBlock th { font-size: .68rem; color: var(--muted2); }
    .comparisonNote { font: .68rem/1.7 Arial, sans-serif; color: var(--muted2); margin: 11px 0 0; }

    .articleNote { font: .75rem/1.7 Arial, sans-serif; color: var(--muted2); border-top: 1px solid var(--line); padding-top: 15px; margin: 30px 0; }
    .articleNote strong { color: var(--ink); }

    .rankedEntry { margin: 0 0 30px; padding-bottom: 26px; border-bottom: 1px solid var(--line); scroll-margin-top: 28px; }
    .rankedEntry:last-of-type { border-bottom: 0; margin-bottom: 0; }
    .rankedMedia { border-radius: 6px; overflow: hidden; background: var(--soft); margin-bottom: 16px; }
    .rankedMedia img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; }
    /* Poster-media variant: a small 2:3 poster beside the text instead of
       a full-width 16:9 still, for lists built from catalog poster art. */
    .rankedEntryPoster { display: grid; grid-template-columns: 180px 1fr; gap: 24px; align-items: start; }
    .rankedEntryPoster .rankedMedia { margin-bottom: 0; }
    .rankedEntryPoster .rankedMedia img { aspect-ratio: 2/3; }
    @media (max-width: 560px) {
      .rankedEntryPoster { grid-template-columns: 110px 1fr; gap: 16px; }
    }
    .rankBadge { display: inline-flex; align-items: center; justify-content: center; min-width: 32px; height: 32px; padding: 0 4px; border-radius: 999px; background: #f4e5cc; color: #8b5810; font: 700 .9rem Arial, sans-serif; margin-bottom: 10px; }
    .rankedEntry h3 { font: 400 1.5rem/1.2 var(--serif); margin: 0 0 7px; color: var(--ink); }
    .rankedEntry h3 a:hover { color: #cf6246; }
    .rankedGenre, .rankedStudio { font: .78rem Arial, sans-serif; color: var(--muted2); margin: 0 0 4px; }
    .rankedGenre strong, .rankedStudio strong { color: var(--muted); font-weight: 700; }
    .rankedBody p { font-size: 1rem; line-height: 1.7; }
    .rankedBody em { font-style: italic; }
    .rankedBody a { color: #b74e34; border-bottom: 1px solid #dba58f; }

    .featuredFilm { display: grid; grid-template-columns: 110px minmax(0,1fr) auto; gap: 20px; align-items: center; margin: 32px 0 36px; padding: 16px; background: var(--soft); border: 1px solid var(--line); border-radius: 5px; width: min(100%,700px); }
    .featuredFilm img { display: block; aspect-ratio: 2/3; width: 110px; height: 165px; object-fit: cover; border-radius: 3px; }
    .featuredFilm small { display: block; font-size: 10px; font-weight: 800; letter-spacing: .1em; color: #cf6246; margin-bottom: 8px; }
    .featuredFilm h3 { font: 400 1.4rem var(--serif); margin: 0 0 5px; }
    .featuredFilm p { font-size: .78rem; color: var(--muted); margin: 0; }
    .filmAction { display: inline-block; border: 1px solid #d5a18e; border-radius: 3px; padding: 10px 13px; color: #963f2c; background: #fff; font-size: .72rem; font-weight: 700; white-space: nowrap; }
    .filmAction:hover { background: #cf6246; color: #fff; }

    .articleEnd { width: min(100%,700px); margin: 40px 0 0; padding: 20px 0; border-top: 1px solid var(--line); display: flex; align-items: center; gap: 13px; font-size: .78rem; color: var(--muted); }
    .articleEnd strong { color: var(--ink); }
    .articleEnd a { margin-left: auto; color: #cf6246; font-weight: 700; }

    .relatedSection { max-width: 1104px; margin: 56px 0 0; }
    .relatedSection h2 { font: 400 1.9rem var(--serif); margin: 0 0 18px; }
    .relatedGrid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; }
    .relatedCard { border-radius: 8px; padding: 10px 10px 14px; margin: -10px; transition: transform .22s ease, box-shadow .22s ease; color: inherit; display: block; }
    .relatedCard:hover { transform: translateY(-4px); box-shadow: 0 12px 26px rgba(15,20,25,.1); }
    .relatedImage { overflow: hidden; border-radius: 5px; background: var(--soft); aspect-ratio: 16/10; }
    .relatedImage img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .relatedImage .fallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; padding: 8px; color: var(--muted); font: 700 .78rem var(--serif); }
    .relatedCard h3 { font: 400 1.15rem/1.25 var(--serif); margin: 11px 0 5px; }
    .relatedCard small { color: var(--muted2); font-size: .72rem; }

    .statsRow { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 0; margin: 28px 0 40px; padding: 17px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font-family: Arial, sans-serif; }
    .statItem { padding: 5px 12px 5px 17px; border-right: 1px solid var(--line); }
    .statItem:first-child { padding-left: 0; }
    .statItem:last-child { border-right: 0; }
    .statItem strong { display: block; font-size: 1.55rem; font-weight: 700; line-height: 1.25; color: var(--ink); }
    .statItem span { display: block; margin-top: 4px; font: .68rem/1.5 Arial, sans-serif; color: var(--muted2); }

    .filmCard { overflow: hidden; margin: 0 0 24px; border: 1px solid var(--line); border-radius: 4px; background: #fff; font-family: Arial, sans-serif; }
    .filmCardImage { position: relative; display: block; aspect-ratio: 16/9; overflow: hidden; background: var(--soft); }
    .filmCardImage img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
    .filmCardImage:hover img { transform: scale(1.03); }
    .awardLabel { position: absolute; bottom: 11px; left: 11px; background: rgba(15,18,20,.88); color: #fff; padding: 6px 10px; border-radius: 3px; font: 700 .68rem Arial, sans-serif; }
    .filmCardBody { padding: 18px 20px 20px; }
    .filmRole { font: .68rem Arial, sans-serif; color: var(--muted2); margin: 0 0 6px; }
    .filmCard h3 { font: 400 1.5rem/1.2 var(--serif); margin: 0 0 9px; color: var(--ink); }
    .filmCard h3 a:hover { color: #cf6246; }
    .filmCardBody p { font: .8rem/1.65 Arial, sans-serif; color: var(--muted); margin: 0 0 11px; }
    .filmCardLink { color: #b9543b; font: 700 .72rem Arial, sans-serif; }

    .filmGrid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 15px; margin: 22px 0 30px; }
    .filmGrid .filmCard { margin: 0; }
    .filmGrid .filmCardBody { padding: 15px; }
    .filmGrid .filmCard h3 { font-size: 1.3rem; }
    .filmGrid .filmCardBody p { font-size: .72rem; }

    .mentionsGrid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; margin: 24px 0 36px; }
    .mention { border: 1px solid var(--line); border-radius: 4px; overflow: hidden; font-family: Arial, sans-serif; }
    .mentionImage { display: block; aspect-ratio: 16/9; background: var(--soft); overflow: hidden; }
    .mentionImage img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
    .mentionImage:hover img { transform: scale(1.03); }
    .mentionBody { padding: 14px; }
    .mentionLabel { font: 700 .62rem Arial, sans-serif; letter-spacing: .04em; text-transform: uppercase; color: #b95f47; }
    .mention h3 { font: 400 1.25rem/1.26 var(--serif); margin: 6px 0; color: var(--ink); }
    .mention h3 a:hover { color: #cf6246; }
    .mention p { font: .72rem/1.6 Arial, sans-serif; color: var(--muted2); margin: 0; }

    .linkBanner { margin: 22px 0 36px !important; padding: 18px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font: 700 .8rem/1.6 Arial, sans-serif !important; }
    .linkBanner a { color: #b74e34; }
    .linkBanner a:hover { text-decoration: underline; }

    .ctaBlock { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 20px 0; margin: 30px 0; display: flex; flex-direction: column; gap: 10px; font-family: Arial, sans-serif; }
    .ctaBlock a { font: 700 .8rem Arial, sans-serif; color: #b85039; }
    .ctaBlock a:hover { text-decoration: underline; }

    @media (max-width: 760px) {
      .masthead h1 { font-size: 36px; }
      .masthead .lede { font-size: 17px; }
      .featuredFilm { grid-template-columns: 80px 1fr; }
      .featuredFilm img { width: 80px; height: 120px; }
      .filmAction { grid-column: 2; justify-self: start; }
      .relatedGrid { grid-template-columns: 1fr; }
      .statsRow { padding: 11px 0; }
      .statItem { padding: 5px 8px; }
      .statItem strong { font-size: 1.25rem; }
      .filmGrid, .mentionsGrid { grid-template-columns: 1fr; }
    }
  </style>

  <Breadcrumbs items={[
    { name: 'Home', url: '/' },
    { name: 'Journal', url: '/news' },
    { name: a.title, url: `/news/${article.id}` },
  ]} />

  <article>
    <header class="masthead">
      <div class="kicker">AIMB Journal / {a.label}</div>
      <h1>{a.title}</h1>
      <p class="lede">{a.excerpt}</p>
      <div class="articleMeta">
        <div class="metaAuthor">
          <span class="authorIcon">AIMB</span>
          <span><strong>AIMB Editorial</strong><br />{a.label} · <time datetime={a.datetime}>{a.date}</time></span>
        </div>
        <div class="shareTools">
          <button aria-label="Share article" id="shareButton" title="Share">↗</button>
          <button aria-label="Copy link" id="copyButton" title="Copy link">⌁</button>
        </div>
      </div>
    </header>

    <figure class="heroFigure">
      {a.image ? <img src={a.image} alt={a.imageAlt ?? a.title} width={imageDims(a.image)?.width} height={imageDims(a.image)?.height} /> : <div class="fallback">{a.title}</div>}
      {a.heroCaption && <figcaption>{a.heroCaption}</figcaption>}
    </figure>

    {a.contentBlocks && a.contentBlocks.length > 0 ? (
      <div class={hasSideNav ? "articleWithToc" : "articleWithToc noToc"}>
        <div class="articleContent">
          {a.contentBlocks.map((block) => {
            switch (block.type) {
              case 'lead':
                return <p class="leadPara" set:html={block.text} />;
              case 'paragraph':
                return <p set:html={block.text} />;
              case 'heading':
                return <h2 id={block.id}>{block.text}</h2>;
              case 'quote':
                return (
                  <figure class="viewerQuote">
                    <blockquote>“{block.text}”</blockquote>
                    <figcaption>{block.author}</figcaption>
                  </figure>
                );
              case 'characterComparisons':
                return (
                  <div class="characterComparisons" aria-label="Character consistency across episodes">
                    {block.characters.map((c) => (
                      <section class="characterComparison">
                        <h3>{c.name} <span>{c.subtitle}</span></h3>
                        <div class="characterFramePair">
                          {c.frames.map((f) => (
                            <figure class="compareFrame">
                              <img src={f.image} alt={f.alt} loading="lazy" width={imageDims(f.image)?.width} height={imageDims(f.image)?.height} />
                            </figure>
                          ))}
                        </div>
                        <p class="characterComparisonCaption">{c.caption}</p>
                      </section>
                    ))}
                  </div>
                );
              case 'comparisonTable':
                return (
                  <div class="comparisonBlock">
                    <div class="comparisonLabel">{block.label}</div>
                    <table>
                      <thead>
                        <tr>{block.columns.map((col) => <th>{col}</th>)}</tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                        ))}
                      </tbody>
                    </table>
                    {block.note && <p class="comparisonNote">{block.note}</p>}
                  </div>
                );
              case 'note':
                return (
                  <p class="articleNote">
                    {block.label && <strong>{block.label} </strong>}
                    {block.text}
                  </p>
                );
              case 'listSummary':
                // Rendered as the right-rail nav instead (see the
                // .articleToc aside below), not inline in the body.
                return null;
              case 'rankedEntry':
                return (
                  <article class={`rankedEntry ${block.mediaAspect === 'poster' ? 'rankedEntryPoster' : ''}`} id={block.id}>
                    <div class="rankedMedia">
                      {block.imageHref ? (
                        <a href={block.imageHref}><img src={block.image} alt={block.imageAlt} loading="lazy" width={imageDims(block.image)?.width} height={imageDims(block.image)?.height} /></a>
                      ) : (
                        <img src={block.image} alt={block.imageAlt} loading="lazy" width={imageDims(block.image)?.width} height={imageDims(block.image)?.height} />
                      )}
                    </div>
                    <div class="rankedBody">
                      <div class="rankBadge">{block.rank}</div>
                      <h3>{block.href ? <a href={block.href}>{block.title}</a> : block.title}</h3>
                      <p class="rankedGenre"><strong>Genre:</strong> {block.genre}</p>
                      {block.studio && (
                        <p class="rankedStudio">
                          Studio: {block.studio.href ? <a href={block.studio.href}>{block.studio.name}</a> : block.studio.name}
                        </p>
                      )}
                      {block.paragraphs.map((p) => <p set:html={p} />)}
                    </div>
                  </article>
                );
              case 'stats':
                return (
                  <div class="statsRow">
                    {block.items.map((s) => (
                      <div class="statItem"><strong>{s.value}</strong><span>{s.label}</span></div>
                    ))}
                  </div>
                );
              case 'filmSpotlight':
                return (
                  <article class="filmCard">
                    <a class="filmCardImage" href={block.href}>
                      <img src={block.image} alt={block.imageAlt} loading="lazy" width={imageDims(block.image)?.width} height={imageDims(block.image)?.height} />
                      <span class="awardLabel">{block.awardLabel}</span>
                    </a>
                    <div class="filmCardBody">
                      <div class="filmRole">{block.role}</div>
                      <h3><a href={block.href}>{block.title}</a></h3>
                      <p>{block.text}</p>
                      <a class="filmCardLink" href={block.href}>{block.linkLabel} <span aria-hidden="true">↗</span></a>
                    </div>
                  </article>
                );
              case 'filmGrid':
                return (
                  <div class="filmGrid">
                    {block.cards.map((c) => (
                      <article class="filmCard">
                        <a class="filmCardImage" href={c.href}>
                          <img src={c.image} alt={c.imageAlt} loading="lazy" width={imageDims(c.image)?.width} height={imageDims(c.image)?.height} />
                          <span class="awardLabel">{c.awardLabel}</span>
                        </a>
                        <div class="filmCardBody">
                          <div class="filmRole">{c.role}</div>
                          <h3><a href={c.href}>{c.title}</a></h3>
                          <p>{c.text}</p>
                          <a class="filmCardLink" href={c.href}>{c.linkLabel} <span aria-hidden="true">↗</span></a>
                        </div>
                      </article>
                    ))}
                  </div>
                );
              case 'mentions':
                return (
                  <div class="mentionsGrid">
                    {block.items.map((m) => (
                      <article class="mention">
                        <a class="mentionImage" href={m.href}><img src={m.image} alt={m.imageAlt} loading="lazy" width={imageDims(m.image)?.width} height={imageDims(m.image)?.height} /></a>
                        <div class="mentionBody">
                          <div class="mentionLabel">{m.label}</div>
                          <h3><a href={m.href}>{m.title}</a></h3>
                          <p>{m.text}</p>
                        </div>
                      </article>
                    ))}
                  </div>
                );
              case 'linkBanner':
                return <p class="linkBanner"><a href={block.href}>{block.text}</a></p>;
              case 'cta':
                return (
                  <div class="ctaBlock">
                    {block.links.map((l) => <a href={l.href}>{l.text}</a>)}
                  </div>
                );
              default:
                return null;
            }
          })}
        </div>
        {headings.length > 0 && (
          <aside class="articleToc" aria-label="On this page">
            <nav class="articleTocInner" aria-label="Article sections">
              <div class="articleTocTitle">On This Page</div>
              {headings.map((h) => (
                <a class="articleTocLink" href={`#${h.id}`}>{h.tocLabel ?? h.text}</a>
              ))}
            </nav>
          </aside>
        )}
        {headings.length === 0 && listSummary && (
          <aside class="articleToc" aria-label={listSummary.title}>
            <nav class="articleTocInner" aria-label={listSummary.title}>
              <div class="articleTocTitle">{listSummary.title}</div>
              {listSummaryLinks.map((item, i) =>
                item.href ? (
                  <a class="articleTocLink" href={item.href}>{i + 1}. {item.label}</a>
                ) : (
                  <span class="articleTocLink articleTocLink--plain">{i + 1}. {item.label}</span>
                )
              )}
              {listSummary.note && <p class="articleTocNote">{listSummary.note}</p>}
            </nav>
          </aside>
        )}
      </div>
    ) : (
      <div class="articleContent">
        {a.body.map((p) => <p>{p}</p>)}
      </div>
    )}

    {featured && (
      <aside class="featuredFilm" aria-label="Featured film">
        <a href={`/movies/${featured.id}`}>
          {featured.data.poster ? <img src={featured.data.poster} alt={featured.data.title} width={imageDims(featured.data.poster)?.width} height={imageDims(featured.data.poster)?.height} /> : <div />}
        </a>
        <div>
          <small>Featured AI Film</small>
          <h3>{featured.data.title}</h3>
          <p>Explore the film profile, credits and related works on AIMB.</p>
        </div>
        <a class="filmAction" href={`/movies/${featured.id}`}>View film profile ↗</a>
      </aside>
    )}

    <div class="articleEnd">
      <span class="authorIcon">AIMB</span>
      <span><strong>AIMB Editorial</strong><br />Independent AI cinema coverage</span>
      <a href="/news">More from the Journal →</a>
    </div>
  </article>

  {related.length > 0 && (
    <section class="relatedSection" aria-labelledby="related-heading">
      <h2 id="related-heading">Related Articles</h2>
      <div class="relatedGrid">
        {related.map((r) => (
          <a class="relatedCard" href={`/news/${r.id}`}>
            <div class="relatedImage">
              {r.data.image ? <img src={r.data.image} alt={r.data.title} loading="lazy" width={imageDims(r.data.image)?.width} height={imageDims(r.data.image)?.height} /> : <div class="fallback">{r.data.title}</div>}
            </div>
            <h3>{r.data.title}</h3>
            <small>{r.data.label} · {r.data.date}</small>
          </a>
        ))}
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: a.title,
    description: a.excerpt,
    datePublished: a.datetime,
    author: { '@type': 'Organization', name: 'AIMB Journal' },
    publisher: { '@type': 'Organization', name: 'AIMB', url: 'https://www.aimoviebase.com' },
    isPartOf: { '@type': 'WebSite', name: 'AIMovieBase', url: 'https://www.aimoviebase.com' },
  })} />

  <script is:inline>
    (function () {
      const shareButton = document.getElementById('shareButton');
      const copyButton = document.getElementById('copyButton');
      async function copyArticleLink() {
        try { await navigator.clipboard.writeText(location.href); }
        catch (e) {
          const t = document.createElement('textarea');
          t.value = location.href;
          document.body.appendChild(t);
          t.select();
          document.execCommand('copy');
          t.remove();
        }
      }
      shareButton?.addEventListener('click', async () => {
        if (navigator.share) {
          try { await navigator.share({ title: document.title, url: location.href }); return; }
          catch (e) { if (e.name === 'AbortError') return; }
        }
        await copyArticleLink();
      });
      copyButton?.addEventListener('click', copyArticleLink);
    })();
  </script>
</BaseLayout>
