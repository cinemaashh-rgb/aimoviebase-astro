---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Contact AI Movie Base.">
  <h1 style="margin-top:34px">Contact</h1>
  <p class="lede" style="color:var(--muted); max-width:700px; line-height:1.6; font-size:1.05rem; margin-bottom:16px;">Found an error in a film's description, want to report a broken page, or suggest a film for the catalog — reach out to us.</p>
  <p class="lede" style="color:var(--fg); font-size:1.05rem;">Email: <a href="mailto:contact@aimoviebase.com" style="color:var(--accent); font-weight:600;">contact@aimoviebase.com</a></p>
</BaseLayout>
