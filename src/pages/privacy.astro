---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy" description="Privacy policy for AI Movie Base.">
  <h1 style="margin-top:34px">Privacy Policy</h1>
  <p class="lede" style="color:var(--muted); max-width:700px; line-height:1.6; font-size:1.05rem; margin-bottom:16px;">This page describes what data the AI Movie Base website collects about visitors and how it is used.</p>

  <h2>What data is collected</h2>
  <p class="lede" style="color:var(--muted); max-width:700px; line-height:1.6; margin-bottom:16px;">The site may use standard web analytics (page views, referral source, device type) to understand what content interests our audience.</p>

  <h2>Cookies</h2>
  <p class="lede" style="color:var(--muted); max-width:700px; line-height:1.6;">The site may use cookies for basic analytics and to remember user preferences. Data is not shared with third parties for advertising purposes.</p>
</BaseLayout>
