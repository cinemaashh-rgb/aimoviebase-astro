---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('awards');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const a = entry.data;
---
<BaseLayout title={a.name} description={a.description}>
  <style>
    /* This page's layout and proportions are pulled from the real Astana
       festival-page design mockup (aimb_astana_festival_2026.html) — sizes,
       spacing, colors and the badge/card shapes below are copied from its
       own <style> block, not approximated. Only the content differs: real
       catalog images instead of its illustrative stock art, and no
       "Finalists" section (see the note at the bottom of this page). */
    .crumb { font-size: .78rem; color: var(--muted); margin: 18px 0 20px; }
    .intro { display: grid; grid-template-columns: minmax(0,1fr) 315px; gap: 44px; align-items: start; padding-bottom: 26px; border-bottom: 1px solid var(--line); margin-bottom: 28px; }
    .intro h1 { font-size: clamp(38px,5vw,60px); line-height: 1.04; letter-spacing: -0.03em; margin: 0 0 14px; }
    .intro .lead { color: var(--muted); font-size: 1rem; line-height: 1.6; max-width: 640px; }
    .detailsBox { background: var(--soft); border: 1px solid var(--line); border-radius: 8px; padding: 6px 20px; font-size: .82rem; }
    .detailsBox .row { display: grid; grid-template-columns: 20px 1fr; gap: 10px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .detailsBox .row:last-child { border-bottom: 0; }
    .detailsBox .row svg { width: 17px; height: 17px; stroke: var(--muted); fill: none; stroke-width: 1.8; }
    .detailsBox .label { color: var(--muted); font-size: .78rem; margin-bottom: 2px; }
    .detailsBox .val { font-weight: 600; color: var(--ink); }
    .stats { display: grid; grid-template-columns: repeat(auto-fit,minmax(150px,1fr)); gap: 14px; margin: 0 0 24px; }
    .statCard { border: 1px solid var(--line); border-radius: 8px; padding: 16px; text-align: center; }
    .statCard .value { font-size: 1.15rem; font-weight: 800; font-family: var(--serif); }
    .statCard .label { font-size: .74rem; color: var(--muted); margin-top: 4px; }
    .section { margin-top: 31px; padding-top: 26px; border-top: 1px solid var(--line); }
    .sectionLabel { text-transform: uppercase; letter-spacing: .055em; font-size: .7rem; color: var(--muted); margin-bottom: 6px; }
    .section h2 { font-size: clamp(26px,3vw,34px); line-height: 1.1; margin: 0 0 8px; }
    .section .sectionLede { color: var(--muted); font-size: .88rem; margin: 0 0 15px; }
    /* align-items: start keeps each card hugging its own content — without
       it, a CSS grid row stretches every card to match its tallest sibling,
       so a winner with a real poster on file (The First Honest Day) was
       forcing huge empty whitespace onto the cards beside it for winners
       we have no verified art for (SITARA) rather than those cards just
       being shorter. */
    .winnerGrid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; align-items: start; }
    .winnerCard { background: var(--soft); border: 1px solid var(--line); border-radius: 7px; overflow: hidden; }
    .winnerCard.grandPrize { background: #fdfaf3; }
    .winnerCard .cardImage { margin: 9px 9px 0; aspect-ratio: 1.85; border-radius: 5px; background: var(--line); overflow: hidden; display: block; }
    .winnerCard .cardImage img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .winnerCard .winnerBody { padding: 10px 14px 15px; }
    .chip { display: inline-flex; font-size: .68rem; padding: 5px 10px; border-radius: 4px; background: #e0e2e5; color: #1f2530; }
    .chip.grand { background: #f9ce74; }
    .chip.third { background: #e6b39d; }
    .winnerCard .wtitle { font-size: 1.15rem; font-weight: 700; font-family: var(--serif); margin: 7px 0 2px; }
    .winnerCard .director { font-size: .82rem; color: var(--muted); }
    .prize { margin-top: 12px; border-top: 1px solid var(--line); padding-top: 12px; }
    .prize .amount { font-size: 1.3rem; font-weight: 700; font-family: var(--serif); }
    .prize .label { font-size: .72rem; color: var(--muted); }
    /* "Additional Awards"-style rows (ported from the real festival-page
       mockup) — used for every section after the first, i.e. award
       categories that aren't the headline grand/second/third placements.
       A real movie poster is used as the thumbnail when we have one on
       file for that winner; otherwise the row stays text-only rather
       than filling the slot with the mockup's own illustrative stock art,
       which that file's own disclaimer says isn't real festival imagery. */
    .awardRows { display: grid; grid-template-columns: 1fr 1fr; gap: 0 34px; }
    .awardRow { display: flex; gap: 18px; align-items: center; padding: 9px 0; border-top: 1px solid var(--line); }
    .awardRow .rowThumb { flex: none; width: 170px; height: 88px; border-radius: 5px; overflow: hidden; display: block; background: var(--soft); }
    .awardRow .rowThumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .awardRow .eyebrow { font-size: .7rem; text-transform: uppercase; letter-spacing: .045em; color: var(--muted); }
    .awardRow h3 { font-size: 1.2rem; font-family: var(--serif); margin: 4px 0 0; }
    .awardRow .director { font-size: .82rem; color: var(--muted); margin-top: 2px; }
    .notesGrid { display: grid; grid-template-columns: repeat(auto-fit,minmax(260px,1fr)); gap: 14px; }
    .noteRow { display: flex; gap: 14px; border: 1px solid var(--line); border-radius: 8px; padding: 12px; align-items: center; }
    .noteRow .poster { flex: 0 0 48px; width: 48px; height: 72px; border-radius: 5px; overflow: hidden; background: var(--soft); }
    .noteRow .poster img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .noteRow .cat { font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted2); }
    .noteRow strong { display: block; font-size: .88rem; margin: 2px 0; }
    .noteRow .by { font-size: .78rem; color: var(--muted); }
    @media (max-width: 850px) { .awardRow .rowThumb { width: 120px; height: 80px; } }
    @media (max-width: 760px) {
      .intro { grid-template-columns: 1fr; }
      .winnerGrid { grid-template-columns: 1fr; }
      .awardRows { grid-template-columns: 1fr; }
    }
  </style>

  <p class="crumb"><a href="/awards">Festivals &amp; Awards</a> › {a.name}</p>

  <div class="intro">
    <div>
      <h1>{a.name}</h1>
      <p class="lead">{a.lead || a.description}</p>
    </div>
    <div class="detailsBox">
      {a.dates && (
        <div class="row">
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M7 2v6M17 2v6M3 10h18"></path></svg>
          <div><div class="label">Dates</div><div class="val">{a.dates}</div></div>
        </div>
      )}
      {a.location && (
        <div class="row">
          <svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
          <div><div class="label">Location</div><div class="val">{a.location}</div></div>
        </div>
      )}
      {a.organizer && (
        <div class="row">
          <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"></circle><path d="M2 21v-2a7 7 0 0 1 14 0v2M16 5a3 3 0 0 1 0 6M19 21v-2a6 6 0 0 0-3-5"></path></svg>
          <div><div class="label">Organized by</div><div class="val">{a.organizer}</div></div>
        </div>
      )}
      {a.siteUrl && (
        <div class="row">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c-6 6-6 12 0 18M12 3c6 6 6 12 0 18"></path></svg>
          <div><div class="label">Official website</div><div class="val"><a href={a.siteUrl} target="_blank" rel="noopener noreferrer" style="color:var(--blue);">{a.siteUrl.replace('https://', '')} ↗</a></div></div>
        </div>
      )}
    </div>
  </div>

  {a.stats.length > 0 && (
    <div class="stats">
      {a.stats.map((s) => <div class="statCard"><div class="value">{s.value}</div><div class="label">{s.label}</div></div>)}
    </div>
  )}

  {a.sections.map((section, sIndex) => {
    const chipClass = (place: string) => {
      const p = place.toLowerCase();
      if (p.includes('first') || p.includes('grand')) return 'grand';
      if (p.includes('second')) return 'second';
      if (p.includes('third')) return 'third';
      return '';
    };
    // The first section is the headline competition (Grand Prix / Second /
    // Third, etc.) and keeps the card-grid treatment. Every section after
    // that is a set of individual award categories (Best Character, Best
    // Story, ...) — ported from the real festival-page mockup's
    // "Additional Awards" layout, a compact two-column row list instead of
    // repeating the same big cards for a dozen small awards.
    const isSpotlight = sIndex === 0;
    return (
      <section class="section">
        {section.eyebrow && <div class="sectionLabel">{section.eyebrow}</div>}
        <h2>{section.label}</h2>
        {section.lede && <p class="sectionLede">{section.lede}</p>}
        {isSpotlight ? (
          <div class="winnerGrid">
            {section.winners.map((w) => (
              <div class={`winnerCard ${chipClass(w.place) === 'grand' ? 'grandPrize' : ''}`}>
                {w.poster && (
                  <a class="cardImage" href={w.movieSlug ? `/movies/${w.movieSlug}` : '#'}>
                    <img src={w.poster} alt="" loading="lazy" />
                  </a>
                )}
                <div class="winnerBody">
                  <span class={`chip ${chipClass(w.place)}`}>{w.place}</span>
                  <div class="wtitle">{w.movieSlug ? <a href={`/movies/${w.movieSlug}`} style="color:inherit;">{w.title}</a> : w.title}</div>
                  {w.director && <div class="director">By {w.directorSlug ? <a href={`/name/${w.directorSlug}`} style="color:var(--blue); font-weight:600;">{w.director}</a> : w.director}</div>}
                  {w.prize && (
                    <div class="prize">
                      <div class="amount">{w.prize}</div>
                      <div class="label">Prize</div>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="awardRows">
            {section.winners.map((w) => (
              <div class="awardRow">
                {w.poster && (
                  <a class="rowThumb" href={w.movieSlug ? `/movies/${w.movieSlug}` : '#'}>
                    <img src={w.poster} alt="" loading="lazy" />
                  </a>
                )}
                <div>
                  <div class="eyebrow">{w.place}</div>
                  <h3>{w.movieSlug ? <a href={`/movies/${w.movieSlug}`} style="color:inherit;">{w.title}</a> : w.title}</h3>
                  {w.director && <div class="director">By {w.directorSlug ? <a href={`/name/${w.directorSlug}`} style="color:var(--blue); font-weight:600;">{w.director}</a> : w.director}</div>}
                  {w.prize && <div class="director" style="margin-top:2px; font-weight:600; color:var(--ink);">{w.prize}</div>}
                </div>
              </div>
            ))}
          </div>
        )}

        {section.winners.some((w) => w.notes.length > 0) && (
          <div class="notesGrid" style="margin-top:16px;">
            {section.winners.flatMap((w) => w.notes).map((n) => (
              <div class="noteRow">
                {n.movieSlug && <a class="poster" href={`/movies/${n.movieSlug}`}><div style="width:100%;height:100%;background:var(--soft);"></div></a>}
                <div>
                  <div class="cat">{n.category}</div>
                  <strong>{n.movieSlug ? <a href={`/movies/${n.movieSlug}`} style="color:inherit;">{n.title}</a> : n.title}</strong>
                  {n.director && <div class="by">By {n.directorSlug ? <a href={`/name/${n.directorSlug}`} style="color:var(--blue);">{n.director}</a> : n.director}</div>}
                </div>
              </div>
            ))}
          </div>
        )}
      </section>
    );
  })}

  <section class="section">
    <h2>About {a.name}</h2>
    <p style="color:var(--ink); line-height:1.65; max-width:720px;">{a.description}</p>
    {a.siteUrl && <p style="margin-top:14px;"><a href={a.siteUrl} target="_blank" rel="noopener noreferrer" style="color:var(--blue); font-weight:600;">Official festival website →</a></p>}
  </section>

  <p style="color:var(--muted); font-size:.76rem; margin-top:30px; font-style:italic;">
    Source: {a.siteUrl ? a.siteUrl.replace('https://', '') : a.name}, as published by the festival. A "Finalists" section appeared in the original design mockup for this page but is omitted here — the mockup's finalist entries had no real titles or names behind them (self-disclaimed as placeholder content), so we're not fabricating that section rather than publishing unverified data.
  </p>
</BaseLayout>
