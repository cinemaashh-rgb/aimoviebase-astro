---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { imageDims } from '../../lib/images';

const awards = await getCollection('awards');
const movies = await getCollection('movies');

// Only link a winner to a movie page when it's actually in the catalog —
// a `winner` entry with no `movieSlug` is a real-world festival result
// this catalog hasn't ingested yet, so it renders as plain text instead
// of a fabricated link (see AIMF's "Awaiting results" below, handled via
// `pending` instead).
function movieExists(slug: string | undefined) {
  return slug ? movies.some((m) => m.id === slug) : false;
}
function moviePoster(slug: string | undefined) {
  return slug ? movies.find((m) => m.id === slug)?.data.poster : undefined;
}

const byId = (id: string) => awards.find((a) => a.id === id);
const aaiff = byId('aaiff');
const runway = byId('runway-aiff');
const reply = byId('reply-aiff');

// Directory data for every festival shown on this page. The two with a
// full detail page (AAIFF, Runway) pull their name/location/dates from
// their own collection entry so the two stay in sync; the rest are
// directory-only entries (no /awards/<slug> page yet) that link out to
// the festival's own site instead of a 404.
const directory = [
  {
    name: aaiff!.data.name,
    slug: 'aaiff',
    logo: 'AAIFF',
    location: aaiff!.data.location,
    edition: 'October 2026',
    formats: ['In-Person'],
    fund: '$2,000,000',
    winner: { title: 'The First Honest Day', year: '2026', movieSlug: 'the-first-honest-day', note: 'Grand Prix' },
  },
  {
    name: 'Runway AI Film Festival',
    slug: 'runway-aiff',
    logo: 'Runway',
    location: 'New York / Los Angeles',
    edition: 'June 2026',
    formats: ['In-Person', 'Online'],
    fund: '$135,000+',
    winner: { title: 'A Face Only A Mother Could Love', year: '2026', movieSlug: 'a-face-only-a-mother-could-love', note: 'Grand Prix' },
  },
  {
    name: reply!.data.name,
    slug: 'reply-aiff',
    logo: 'Reply',
    location: reply!.data.location,
    edition: 'September 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'A Face Only A Mother Could Love', year: '2026', movieSlug: 'a-face-only-a-mother-could-love', note: '1st Place' },
  },
  {
    name: 'Higgsfield Global Film Festival',
    slug: 'higgsfield',
    logo: 'H',
    location: 'Online · Worldwide',
    edition: '2026 (results 1 Nov 2026)',
    formats: ['Online'],
    fund: '$1,000,000',
    winner: { title: 'Listen to Meh', year: '2026', movieSlug: 'listen-to-meh', note: '1st Place' },
  },
  {
    name: 'BIFAN — Bucheon International Fantastic Film Festival',
    url: 'https://www.bifan.kr/',
    logo: 'BIFAN',
    location: 'Bucheon, South Korea',
    edition: 'July 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Cornered', year: '2026', movieSlug: 'sinuca-de-bico', note: 'Best AI Film' },
  },
  {
    name: 'Busan International AI Film Festival',
    url: 'https://www.biaif.com/',
    logo: 'BIAIF',
    location: 'Busan, South Korea',
    edition: 'December 2025',
    formats: ['In-Person'],
    fund: '$3,000',
    winner: { title: 'Chairman', year: '2025', movieSlug: 'chairman', note: 'Audience Award' },
  },
  {
    name: 'Artificial Intelligence Media Festival',
    url: 'https://aimf.us/',
    logo: 'AIMF',
    location: 'Los Angeles, USA',
    edition: 'October 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Awaiting results', pending: true },
  },
  {
    name: 'Cinema Shift Festival',
    url: 'https://cinemashiftfestival.com/',
    logo: 'SHIFT',
    location: 'Toronto, Canada',
    edition: 'June 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Cornered', year: '2026', movieSlug: 'sinuca-de-bico', note: 'Best AI Narrative' },
  },
  {
    name: 'Bochnia International AI Film Festival',
    url: 'https://yingtu.art/en/opportunities/',
    logo: 'BIAIFF',
    location: 'Bochnia, Poland',
    edition: 'September 2026',
    formats: ['In-Person'],
    fund: '$2,500',
    winner: { title: 'Far Away Home', year: '2026', movieSlug: 'far-away-home', note: 'Grand Prix' },
  },
  // Upcoming festivals (Nov–Dec 2026) with no results yet — same `pending`
  // treatment as AIMF above, not guessed winners. No source URL was
  // available for these when added, so they render as plain text (no
  // `slug`/`url`), same as any other directory-only, non-linked entry.
  {
    name: 'AI International Film Festival',
    logo: 'AIIFF',
    location: 'Hefei, China',
    edition: 'Nov 12–15, 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Awaiting results', pending: true },
  },
  {
    name: 'African AI Film Festival',
    logo: 'AAFF',
    location: 'Los Angeles, USA',
    edition: 'Nov 21, 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Awaiting results', pending: true },
  },
  {
    name: 'AI London Film Festival',
    logo: 'AILFF',
    location: 'London, UK',
    edition: 'Nov 21, 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Awaiting results', pending: true },
  },
  {
    name: 'AI Film Fest Amsterdam',
    logo: 'AIFFA',
    location: 'Amsterdam, Netherlands',
    edition: 'Nov 26, 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Awaiting results', pending: true },
  },
  {
    name: 'Prague AI Film Festival (PAIFF)',
    logo: 'PAIFF',
    location: 'Prague, Czech Republic',
    edition: 'Nov 28, 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Awaiting results', pending: true },
  },
  {
    name: 'CINE PRAGUE AI Film Festival',
    logo: 'CPAIFF',
    location: 'Prague, Czech Republic',
    edition: 'Dec 1, 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Awaiting results', pending: true },
  },
  {
    name: 'Türkiye International AI Film Festival',
    logo: 'TIAIFF',
    location: 'Istanbul, Turkey',
    edition: 'Dec 7–9, 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Awaiting results', pending: true },
  },
  {
    name: 'African AI Film Festival — Kampala Screening',
    logo: 'AAFF',
    location: 'Kampala, Uganda',
    edition: 'Dec 12, 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Awaiting results', pending: true },
  },
  {
    name: 'Silicon Valley AI Film Festival — Korea',
    logo: 'SVAIFF',
    location: 'Seoul, South Korea',
    edition: 'Dec 17, 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Awaiting results', pending: true },
  },
  {
    name: 'AI Artist Festival',
    logo: 'AIAF',
    location: 'Beijing, China',
    edition: 'Dec 26–27, 2026',
    formats: ['In-Person'],
    fund: null,
    winner: { title: 'Awaiting results', pending: true },
  },
];

const initialCount = 6;
---
<BaseLayout title="Awards & Festivals" description="AI film awards and festivals: Astana AI Film Festival (AAIFF), Runway AI Film Festival, Reply AI Film Festival, Higgsfield Global Film Festival, BIFAN and more.">
  <style>
    /* Horizontal full-bleed comes from the shared .full-bleed class (see
       BaseLayout.astro); this rule only owns the hero's own
       vertical/visual properties. margin-top cancels out <main>'s own top
       padding so the hero sits flush under the dark header with no white
       gap above it — this only works because <Breadcrumbs> renders
       *inside* .awardsHeroIn (in white-on-dark `dark` mode, see below)
       rather than above the hero as a separate white-page element. */
    .awardsHero { margin-top: -2rem; margin-bottom: 30px; min-height: 270px; overflow: hidden; background: var(--black) url(/images/awards-hero.webp) center / cover no-repeat; color: #fff; }
    .awardsHero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, var(--black) 0%, var(--black) 22%, rgba(8,11,13,.78) 42%, rgba(8,11,13,.2) 68%, rgba(8,11,13,.05) 100%); }
    .awardsHeroIn { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; min-height: 270px; display: flex; align-items: center; padding: 36px 2rem; }
    .awardsHero .eyebrow { color: #cfd5df; }
    .awardsHero h1 { color: #fff; font-size: clamp(30px,4vw,46px); margin: 10px 0 14px; max-width: 520px; }
    .awardsHero p { color: #dde1e7; max-width: 540px; line-height: 1.55; font-size: .96rem; }

    .sectionHead { display: flex; align-items: center; justify-content: space-between; margin-bottom: 13px; }
    .sectionHead h2 { font-size: 1.4rem; margin: 0; }

    /* Featured Festivals — each card now carries a real photo/logo for its
       festival (organizer-supplied), with a dark gradient scrim so the
       badge/heading/copy stay legible on top, same treatment as the
       homepage hero and newsletter band. */
    .featuredGrid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; margin-bottom: 36px; }
    @media (max-width: 900px) { .featuredGrid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
    .featureCard { background: var(--black); border-radius: 8px; padding: 20px 18px; color: #fff; display: flex; flex-direction: column; justify-content: flex-end; min-height: 170px; position: relative; overflow: hidden; }
    /* Photo layer sits behind the gradient scrim on its own pseudo-element
       (rather than as the card's own background-image) so it can be
       dimmed with `filter` without touching the real text on top — the
       organizer artwork carries its own baked-in wordmarks, which read as
       a muted texture here instead of fighting our own heading. */
    .featureCard::before { content: ""; position: absolute; inset: 0; background: var(--art) center / cover no-repeat; filter: brightness(.45) saturate(.85); }
    .featureCard::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,11,13,.25) 0%, rgba(8,11,13,.4) 46%, rgba(8,11,13,.94) 100%); }
    .featureCard .tag, .featureCard h3, .featureCard p, .featureCard small { position: relative; z-index: 1; }
    .featureCard .tag { align-self: flex-start; background: #ffe6a8; color: #1a1710; font-weight: 700; border-radius: 6px; padding: 4px 9px; font-size: .62rem; letter-spacing: .02em; margin-bottom: auto; }
    .featureCard h3 { font-family: var(--serif); font-size: 1.25rem; margin: 10px 0 5px; text-shadow: 0 2px 10px rgba(0,0,0,.5); }
    .featureCard p { margin: 0 0 7px; font-size: .78rem; color: #e3e6ea; line-height: 1.4; text-shadow: 0 1px 8px rgba(0,0,0,.5); }
    .featureCard small { font-size: .72rem; color: #e8eaed; text-shadow: 0 1px 8px rgba(0,0,0,.5); }
    .featureCard:hover h3 { color: #fff; text-decoration: underline; }

    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    thead th { text-align: left; font-size: .64rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--muted2); background: var(--soft); padding: 11px 13px; }
    thead th:nth-child(1) { width: 27%; } thead th:nth-child(4) { width: 11%; }
    tbody td { padding: 10px 13px; border-top: 1px solid var(--line); font-size: .8rem; color: var(--ink); vertical-align: middle; }
    tbody tr.extra[hidden] { display: none; }
    .tableFrame { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; overflow-x: auto; }
    .fname { display: flex; align-items: center; gap: 11px; min-width: 0; }
    .flogo { flex: none; display: grid; place-items: center; width: 38px; height: 38px; background: var(--black); color: #fff; border-radius: 6px; font-size: .6rem; font-weight: 800; text-align: center; line-height: 1.1; padding: 2px; }
    .fname a { font-weight: 700; color: var(--ink); font-size: .82rem; display: block; }
    .fname a:hover { color: var(--blue); }
    .fnamePlain { font-weight: 700; color: var(--ink); font-size: .82rem; display: block; }
    .formatStack { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 5px; }
    .format { font-size: .72rem; white-space: nowrap; color: #3a58bf; background: #e9edff; padding: 4px 9px; border-radius: 999px; }
    .format.online { background: #e6f4ec; color: #287754; }
    .fund { display: inline-block; background: #d9f1df; color: #23583b; border-radius: 50px; padding: 3px 10px; font-size: .76rem; font-weight: 700; white-space: nowrap; }
    .fund.empty { background: var(--soft); color: var(--muted2); }
    .winner { display: flex; align-items: center; gap: 9px; }
    .winner-thumb { flex: none; width: 28px; height: 42px; object-fit: cover; border-radius: 4px; background: var(--soft); }
    .winner strong { display: block; font-size: .8rem; color: var(--ink); }
    .winner a { color: var(--ink); }
    .winner a:hover { color: var(--blue); }
    .winner small { color: var(--muted2); font-size: .72rem; }
    .winner .pending { color: var(--muted2); font-style: italic; }
    .loadWrap { text-align: center; padding: 20px 0 6px; }
    .load { border: 1px solid var(--line); background: #fff; border-radius: 8px; padding: 10px 28px; font-weight: 600; font-size: .85rem; cursor: pointer; }
    .load[hidden] { display: none; }
    .count { font-size: .76rem; color: var(--muted); margin-top: 8px; }

    @media (max-width: 760px) {
      .featuredGrid { grid-template-columns: 1fr; }
      /* The table was just squeezing six fixed-width columns into a
         narrow screen and overlapping text (see the reference's own
         mobile table→card rules) — stack each row as a card instead. */
      .tableFrame { border: 0; overflow: visible; }
      table { table-layout: auto; }
      thead { display: none; }
      tbody { display: grid; gap: 12px; }
      .festivalRow { display: block; border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; background: #fff; }
      .festivalRow.extra[hidden] { display: none; }
      tbody td { display: flex; justify-content: space-between; align-items: center; gap: 12px; border: 0; border-top: 1px solid var(--line); padding: 10px 0; text-align: right; min-width: 0; }
      tbody td:first-child { border-top: 0; display: block; text-align: left; padding-bottom: 10px; }
      tbody td:not(:first-child)::before { content: attr(data-label); flex: 0 0 38%; text-align: left; font-size: .68rem; font-weight: 700; color: var(--muted); }
      .winner { justify-content: flex-end; text-align: left; }
      .formatStack { align-items: flex-end; }
    }
  </style>

  <div class="awardsHero full-bleed">
    <div class="awardsHeroIn">
      <div>
        <Breadcrumbs dark items={[
          { name: 'Home', url: '/' },
          { name: 'Awards & Festivals', url: '/awards' },
        ]} />
        <div class="eyebrow">FESTIVALS &amp; AWARDS</div>
        <h1>Celebrating the Next Era of Cinema</h1>
        <p>From international competitions to online showcases, discover the events shaping AI filmmaking and the creators and films gaining recognition around the world.</p>
      </div>
    </div>
  </div>

  <div class="sectionHead"><h2>Featured Festivals</h2></div>
  <div class="featuredGrid">
    <a class="featureCard" href="/awards/aaiff" style="--art:url(/images/awards/aaiff-card.webp)">
      <span class="tag">FEATURED</span>
      <h3>AAIFF — Astana AI Film Festival</h3>
      <p>An international AI film festival with competition prizes and a fund for new productions.</p>
      <small>1–3 October 2026</small>
    </a>
    <a class="featureCard" href="/awards/runway-aiff" style="--art:url(/images/awards/runway-aiff-card.webp)">
      <span class="tag">FEATURED</span>
      <h3>Runway AI Film Festival</h3>
      <p>A global showcase of AI-driven films organized by Runway.</p>
      <small>2026 edition</small>
    </a>
    <a class="featureCard" href="/awards/reply-aiff" style="--art:url(/images/awards/reply-aiff-card.webp)">
      <span class="tag">FEATURED</span>
      <h3>Reply AI Film Festival</h3>
      <p>An international competition spotlighting AI-assisted storytelling.</p>
      <small>7 Sep 2026</small>
    </a>
    <a class="featureCard" href="/awards/higgsfield" style="--art:url(/images/awards/higgsfield-card.webp)">
      <span class="tag">FEATURED</span>
      <h3>Higgsfield Global Film Festival</h3>
      <p>A $1,000,000 online competition for original AI short films.</p>
    </a>
  </div>

  <div class="sectionHead"><h2>All Festivals</h2></div>
  <div class="tableFrame">
    <table>
      <thead><tr><th>Festival</th><th>Location</th><th>Latest edition</th><th>Format</th><th>Prize fund</th><th>Award-winning film</th></tr></thead>
      <tbody>
        {directory.map((f, i) => (
          <tr class={`festivalRow ${i >= initialCount ? 'extra' : ''}`} hidden={i >= initialCount}>
            <td data-label="Festival">
              <div class="fname">
                <span class="flogo">{f.logo}</span>
                {f.slug ? <a href={`/awards/${f.slug}`}>{f.name}</a> : <span class="fnamePlain">{f.name}</span>}
              </div>
            </td>
            <td data-label="Location">{f.location}</td>
            <td data-label="Latest edition">{f.edition}</td>
            <td data-label="Format"><span class="formatStack">{f.formats.map((fmt) => <span class={`format ${fmt === 'Online' ? 'online' : ''}`}>{fmt}</span>)}</span></td>
            <td data-label="Prize fund">{f.fund ? <span class="fund">{f.fund}</span> : <span class="fund empty">—</span>}</td>
            <td class="winner" data-label="Award-winning film">
              {!f.winner.pending && f.winner.movieSlug && movieExists(f.winner.movieSlug) ? (
                <>
                  {moviePoster(f.winner.movieSlug) && (
                    <img class="winner-thumb" src={moviePoster(f.winner.movieSlug)} alt={f.winner.title} loading="lazy" width={imageDims(moviePoster(f.winner.movieSlug))?.width} height={imageDims(moviePoster(f.winner.movieSlug))?.height} />
                  )}
                  <div>
                    <a href={`/movies/${f.winner.movieSlug}`}><strong>{f.winner.title}</strong></a>
                    <small>{f.winner.note ? `${f.winner.note} · ` : ''}{f.winner.year}</small>
                  </div>
                </>
              ) : !f.winner.pending && f.winner.year ? (
                <div>
                  <strong>{f.winner.title}</strong>
                  <small>{f.winner.note ? `${f.winner.note} · ` : ''}{f.winner.year}</small>
                </div>
              ) : (
                <span class="pending">{f.winner.title}</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="loadWrap">
    <button class="load" id="loadMore" type="button">Load more ↓</button>
    <div class="count" id="count">Showing {initialCount} of {directory.length} festivals</div>
  </div>

  <p style="color:var(--muted); font-size:.76rem; margin-top:22px;">Festival details checked against organizer sources (October 2026). Festivals without a dedicated page here link out to their own site. Award-winning films already in our catalog link to their page with a real poster; films not yet catalogued are shown by name only, and a pending result is shown as "Awaiting results" rather than guessed at.</p>

  <script is:inline define:vars={{ total: directory.length, initialCount }}>
    (function () {
      var btn = document.getElementById('loadMore');
      var count = document.getElementById('count');
      var extras = [].slice.call(document.querySelectorAll('tr.extra'));
      if (extras.length === 0) { btn.hidden = true; return; }
      btn.addEventListener('click', function () {
        extras.forEach(function (row) { row.hidden = false; });
        btn.hidden = true;
        count.textContent = 'Showing ' + total + ' of ' + total + ' festivals';
      });
    })();
  </script>
</BaseLayout>
