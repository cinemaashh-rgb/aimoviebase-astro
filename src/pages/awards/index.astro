---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const awards = await getCollection('awards');

// Festivals with a real detail page in this catalog (AAIFF, Runway AIFF).
const covered = awards.map((a) => ({
  id: a.id,
  name: a.data.name,
  location: a.data.location ?? '—',
  dates: a.data.dates ?? '—',
  fund: a.data.stats.find((s) => /fund|prize/i.test(s.label))?.value ?? null,
}));

// Festivals mentioned in the mockup / previously on the Awards index that
// don't have a dedicated detail page yet — shown in the same directory
// table, linking out to the festival's own site rather than a 404 on
// /awards/<slug>.
const other = [
  { name: 'Reply AI Film Festival', location: 'Venice, Italy', dates: '2025 edition', fund: null, url: 'https://www.reply.com/' },
  { name: 'Higgsfield Global Film Festival', location: 'Online', dates: '2026 edition', fund: '$1,000,000', url: 'https://higgsfield.ai/' },
  { name: 'BIFAN — Bucheon International Fantastic Film Festival', location: 'Bucheon, South Korea', dates: '2025 edition', fund: null, url: 'https://www.bifan.kr/' },
];
---
<BaseLayout title="Awards & Festivals" description="AI film awards and festivals: Astana AI Film Festival (AAIFF), Runway AI Film Festival (AIFF), Reply AI Film Festival, Higgsfield Global Film Festival, BIFAN and more.">
  <style>
    .awardsHero { margin: -2rem -2rem 30px; padding: 48px 2rem; background: var(--black); color: #fff; }
    .awardsHero .eyebrow { color: #cfd5df; }
    .awardsHero h1 { color: #fff; font-size: clamp(30px,4vw,46px); margin: 10px 0 12px; }
    .awardsHero p { color: #dde1e7; max-width: 560px; line-height: 1.55; }
    table { width: 100%; border-collapse: collapse; }
    thead th { text-align: left; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--muted2); background: var(--soft); padding: 11px 13px; }
    tbody td { padding: 11px 13px; border-top: 1px solid var(--line); font-size: .84rem; color: var(--ink); vertical-align: middle; }
    tbody tr.extra[hidden] { display: none; }
    .tableFrame { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; overflow-x: auto; }
    .fname a { font-weight: 700; color: var(--ink); }
    .fname a:hover { color: var(--blue); }
    .fund { display: inline-block; background: #d9f1df; color: #23583b; border-radius: 50px; padding: 3px 10px; font-size: .78rem; font-weight: 700; }
    .fund.empty { background: var(--soft); color: var(--muted2); }
    .loadWrap { text-align: center; padding: 20px 0 6px; }
    .load { border: 1px solid var(--line); background: #fff; border-radius: 8px; padding: 10px 28px; font-weight: 600; font-size: .85rem; cursor: pointer; }
    .load[hidden] { display: none; }
    .count { font-size: .76rem; color: var(--muted); margin-top: 8px; }
  </style>

  <div class="awardsHero">
    <div class="eyebrow">FESTIVALS &amp; AWARDS</div>
    <h1>Celebrating the Next Era of Cinema</h1>
    <p>From international competitions to online showcases, discover the events shaping AI filmmaking and the creators and films gaining recognition around the world.</p>
  </div>

  <div class="tableFrame">
    <table>
      <thead><tr><th>Festival</th><th>Location</th><th>Latest edition</th><th>Prize fund</th></tr></thead>
      <tbody id="festivalTable">
        {covered.map((f) => (
          <tr>
            <td class="fname"><a href={`/awards/${f.id}`}>{f.name}</a></td>
            <td>{f.location}</td>
            <td>{f.dates}</td>
            <td>{f.fund ? <span class="fund">{f.fund}</span> : <span class="fund empty">—</span>}</td>
          </tr>
        ))}
        {other.map((f, i) => (
          <tr class={i >= 1 ? 'extra' : ''} hidden={i >= 1}>
            <td class="fname"><a href={f.url} target="_blank" rel="noopener">{f.name} ↗</a></td>
            <td>{f.location}</td>
            <td>{f.dates}</td>
            <td>{f.fund ? <span class="fund">{f.fund}</span> : <span class="fund empty">—</span>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="loadWrap">
    <button class="load" id="loadMore" type="button">Load more ↓</button>
    <div class="count" id="count">Showing {covered.length + 1} of {covered.length + other.length} festivals</div>
  </div>

  <p style="color:var(--muted); font-size:.76rem; margin-top:22px;">Festivals without a dedicated page here link out to their own site. List will keep growing as more AI film festivals come online.</p>

  <script is:inline define:vars={{ total: covered.length + other.length, shownInitially: covered.length + 1 }}>
    (function () {
      var btn = document.getElementById('loadMore');
      var count = document.getElementById('count');
      var extras = [].slice.call(document.querySelectorAll('tr.extra'));
      if (extras.length === 0) { btn.hidden = true; return; }
      btn.addEventListener('click', function () {
        extras.forEach(function (row) { row.hidden = false; });
        btn.hidden = true;
        count.textContent = 'Showing ' + total + ' of ' + total + ' festivals';
      });
    })();
  </script>
</BaseLayout>
