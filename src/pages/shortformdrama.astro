---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('shortdrama');
const published = entries.filter((e) => e.data.status === 'published');
const categories = entries.filter((e) => e.data.status === 'coming-soon');
categories.sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<BaseLayout title="Short Form Drama" description="Vertical, episode-driven AI drama — bite-sized chapters built for phone screens.">
  <h1>AI Short Drama</h1>
  <p style="color:var(--muted); max-width:640px; line-height:1.5; margin-bottom:28px;">Vertical, episode-driven AI drama — bite-sized chapters built for phone screens.</p>

  <div class="movieGrid" style="max-width:700px">
    {published.map((entry) => (
      <a class="movieCard" href={`/shortdrama/${entry.id}`}>
        <img src={entry.data.poster} alt={entry.data.title} loading="lazy" />
        <div class="cardBody">
          <h3>{entry.data.title}</h3>
          <div class="meta">{entry.data.year} · {entry.data.episodes} episodes · {entry.data.platform}</div>
        </div>
      </a>
    ))}
  </div>

  {categories.length > 0 && (
    <>
      <h2 style="margin-top:2.5em">Browse by Category</h2>
      <div style="display:grid; gap:4px; max-width:700px;">
        {categories.map((entry) => (
          <a href={`/shortdrama/${entry.id}`} style="display:flex; align-items:center; gap:16px; padding:14px; border-radius:10px; color:inherit;">
            <div style="flex:1; min-width:0;">
              <div style="font-weight:700; font-size:1.02rem;">{entry.data.title}</div>
              <div style="color:var(--muted); font-size:.8rem;">{entry.data.tagline}</div>
            </div>
            <div style="color:var(--muted); font-size:1.1rem; flex-shrink:0;">›</div>
          </a>
        ))}
      </div>
    </>
  )}
</BaseLayout>
