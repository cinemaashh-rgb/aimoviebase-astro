---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" description="About AI Movie Base — a catalog of films made with generative AI.">
  <h1 style="margin-top:34px">About</h1>
  <p class="lede" style="color:var(--muted); max-width:700px; line-height:1.6; font-size:1.05rem; margin-bottom:18px;">AI Movie Base is a catalog of films made with generative AI: from short experimental clips to full narrative works. We bring them together in one place with reviews and detailed information about which tools and models were used to create each piece.</p>
  <p class="lede" style="color:var(--muted); max-width:700px; line-height:1.6; font-size:1.05rem;">This is a young, fast-moving genre, so we capture not just audience scores but the technical side too: which video, voice, and sound generation models were behind a project is as much a part of the film's story as its plot and direction.</p>
</BaseLayout>
