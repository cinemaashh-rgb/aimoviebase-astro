---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" description="Learn about AIMB, the independent guide to AI cinema: discovering films, documenting filmmakers and supporting thoughtful criticism.">
  <style>
    /* About AIMB — editorial layout from the reference, reusing the site's
       own ink/accent tokens instead of a separate local palette. */
    .aboutPage { color: var(--ink); font-family: var(--sans); }
    .aboutPage * { box-sizing: border-box; }

    .aboutBreadcrumb { font: 12px/1.5 var(--sans); color: var(--muted2); margin-bottom: 33px; }
    .aboutBreadcrumb a:hover { color: #cf6246; }
    .aboutBreadcrumb span { padding: 0 10px; }

    .aboutHero { padding: 24px 0 50px; border-bottom: 1px solid var(--line); max-width: 820px; }
    .aboutKicker { font: 700 11px/1.5 var(--sans); letter-spacing: .14em; color: #cf6246; text-transform: uppercase; }
    .aboutHero h1 { font: 400 clamp(52px,8vw,100px)/.98 var(--serif); letter-spacing: -.055em; margin: 21px 0 22px; color: var(--ink); }
    .aboutHero h1 em { font-style: normal; color: #cf6246; }
    .aboutLead { max-width: 650px; font: 400 clamp(20px,2.2vw,26px)/1.5 var(--serif); color: var(--muted); margin: 0; }
    .aboutAttribution { font: 700 11px var(--sans); letter-spacing: .08em; color: var(--muted2); display: flex; align-items: center; gap: 9px; margin-top: 28px; }
    .aboutDot { height: 7px; width: 7px; border-radius: 50%; background: #cf6246; }

    .aboutMainGrid { display: grid; grid-template-columns: minmax(0,1fr) 270px; gap: 70px; align-items: start; padding-top: 50px; }

    .aboutProseSection { margin: 0 0 60px; }
    .aboutSectionKicker { font: 700 11px/1.5 var(--sans); letter-spacing: .14em; color: #cf6246; }
    .aboutProseSection h2 { font: 400 clamp(29px,3.2vw,42px)/1.14 var(--serif); letter-spacing: -.03em; margin: 17px 0 23px; }
    .aboutProseSection p { font: 16px/1.88 var(--serif); color: #4e5866; margin: 0 0 19px; }
    .principles { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; margin: 30px 0 28px; }
    .principle { padding: 19px 17px; border: 1px solid #ece7e4; background: #fffaf7; border-radius: 3px; }
    .principle strong { display: block; font: 400 22px var(--serif); margin-bottom: 9px; color: var(--ink); }
    .principle p { font: 13px/1.7 var(--sans); color: var(--muted2); margin: 0; }
    .introLink { display: inline-flex; align-items: center; gap: 12px; font: 700 13px var(--sans); color: #cf6246; margin-top: 2px; }
    .introLink:hover { gap: 17px; color: #cf6246; }
    .joinBox { background: #fff7f2; border: 1px solid #f1e5dd; padding: 27px; margin-top: 28px; }
    .joinBox h3 { font: 400 25px/1.2 var(--serif); margin: 0 0 11px; }
    .joinBox p { font: 14px/1.7 var(--sans); color: var(--muted); margin: 0 0 21px; }
    .outlineButton { display: inline-flex; gap: 20px; align-items: center; font: 700 12px var(--sans); background: var(--ink); color: #fff; padding: 12px 17px; border-radius: 3px; }
    .outlineButton:hover { background: #cf6246; color: #fff; }

    .aboutSide { position: sticky; top: 24px; border-top: 2px solid var(--ink); padding-top: 18px; }
    .aboutSideKicker { color: var(--ink); margin-bottom: 14px; }
    .aboutContact { padding: 19px 0; border-bottom: 1px solid var(--line); }
    .aboutContact h3 { font: 400 21px/1.25 var(--serif); margin: 0 0 8px; color: var(--ink); }
    .aboutContact p { font: 13px/1.75 var(--sans); color: var(--muted); margin: 0 0 12px; }
    .aboutContact a { font: 700 12px var(--sans); color: #cf6246; display: inline-flex; gap: 12px; align-items: center; }
    .aboutContact a:hover { color: #a84730; gap: 16px; }
    .aboutSmallnote { font: 11px/1.7 var(--sans); color: var(--muted2); margin: 18px 0 0; }

    .aboutBottom { background: #fbf5f0; margin-top: 60px; padding: 46px 56px 50px; display: grid; grid-template-columns: 1fr auto; gap: 6px 35px; align-items: end; border-radius: 4px; }
    .aboutBottom > span { grid-column: 1/-1; font: 700 11px var(--sans); letter-spacing: .14em; color: #cf6246; }
    .aboutBottom h2 { font: 400 clamp(32px,4vw,50px)/1.1 var(--serif); letter-spacing: -.035em; margin: 12px 0 0; }
    .aboutBottom h2 em { color: #cf6246; font-style: normal; }
    .aboutBottom > a { display: flex; align-items: center; gap: 20px; background: var(--ink); color: #fff; font: 700 12px var(--sans); padding: 14px 19px; border-radius: 3px; white-space: nowrap; }
    .aboutBottom > a:hover { background: #cf6246; color: #fff; }

    @media (max-width: 850px) {
      .aboutMainGrid { gap: 35px; grid-template-columns: minmax(0,1fr) 240px; }
      .principles { grid-template-columns: 1fr; }
    }
    @media (max-width: 650px) {
      .aboutHero { padding: 10px 0 30px; }
      .aboutHero h1 { font-size: 56px; letter-spacing: -.06em; margin: 17px 0 16px; }
      .aboutLead { font-size: 19px; }
      .aboutMainGrid { display: block; padding-top: 30px; }
      .aboutProseSection { margin-bottom: 42px; }
      .aboutProseSection h2 { font-size: 30px; }
      .aboutProseSection p { font-size: 15px; }
      .aboutSide { position: static; margin-top: 8px; }
      .aboutBottom { padding: 26px 20px; display: block; }
      .aboutBottom h2 { font-size: 33px; margin: 13px 0 22px; }
      .aboutBottom > a { width: max-content; max-width: 100%; }
    }
  </style>

  <div class="aboutPage">
    <nav class="aboutBreadcrumb"><a href="/">Home</a><span>/</span>About AIMB</nav>

    <section class="aboutHero">
      <div class="aboutKicker">About / AI Movie Base</div>
      <h1>About <em>AIMB.</em></h1>
      <p class="aboutLead">AIMB brings film fans, independent makers, studios and critics together around AI movies and AI series — helping remarkable work find audiences worldwide.</p>
      <div class="aboutAttribution"><span class="aboutDot"></span> The independent guide to AI cinema</div>
    </section>

    <div class="aboutMainGrid">
      <div>
        <section class="aboutProseSection" id="mission" aria-labelledby="mission-h">
          <div class="aboutSectionKicker">01 / AIMB</div>
          <h2 id="mission-h">Our mission</h2>
          <p>Film has always progressed in tandem with technology. AI is opening up completely new avenues for imagining, creating and telling stories and a whole generation of filmmakers are now exploring what that means for cinema.</p>
          <p>AIMB (AI Movie Base) exists to help this nascent world find its audience. It's about bringing together film fans, independent makers, studios and critics around a new movement in film. The belief is that great work should be found, whether it's from a major studio or a first time filmmaker making in any part of the world.</p>
          <p>Our ambition is to give remarkable AI films a place to be seen, to be talked about and to be remembered and to help those stories reach people well beyond the communities in which they were created.</p>
        </section>

        <section class="aboutProseSection" id="what-we-do" aria-labelledby="what-we-do-h">
          <div class="aboutSectionKicker">02 / AIMB</div>
          <h2 id="what-we-do-h">What we do</h2>
          <p>AIMB is an independent discovery and editorial platform for AI-generated and AI-assisted movies and series. We bring films and series together with the context around them: the filmmakers, the studios, the production tools, the festivals, the selections and the stories. All of this is there to help the audience understand the work.</p>
          <div class="principles">
            <div class="principle"><strong>Discover</strong><p>Look at the standout AI films, series and short dramas from creators around the world.</p></div>
            <div class="principle"><strong>Document</strong><p>Link films to verified credits, filmmaking tools and festival accolades.</p></div>
            <div class="principle"><strong>Discuss</strong><p>Make space for considered criticism, new points of view and genuine discussion.</p></div>
          </div>
          <p style="margin-top:24px">AIMB is not a streaming service. We're a discovery platform to help audiences find films and find their way to the creators and platforms where they can watch them.</p>
          <a class="introLink" href="/movies">Explore AI movies <span aria-hidden="true">→</span></a>
        </section>

        <section class="aboutProseSection" id="community" aria-labelledby="community-h">
          <div class="aboutSectionKicker">03 / AIMB</div>
          <h2 id="community-h">Building a community around AI movies and AI series</h2>
          <p>New creative movements need more than just technology. They need an audience, they need conversation, they need criticism and they need people who are prepared to stand up for work that is worthy of attention.</p>
          <p>We want AIMB to be a meeting point for the curious viewer and the filmmaker. A place where you can discover new voices, track the development of the medium and engage in intelligent discussion about the films themselves rather than just the tools with which they are made.</p>
          <p>As AI movies and AI series develop, we hope to develop with them; to document the important work, to champion the independent talent and to help audiences around the world find the films that are worth watching.</p>
        </section>

        <section class="aboutProseSection" id="critics" aria-labelledby="critics-h">
          <div class="aboutSectionKicker">04 / AIMB</div>
          <h2 id="critics-h">Write for AIMB</h2>
          <p>We think AI films absolutely merit the same level of serious, independent scrutiny as any other form of cinema. Good criticism can help the audience to find the worthwhile films and can help the filmmakers to understand how their stories are being received.</p>
          <p>If you're a film critic, a journalist, a writer or just a very enthusiastic movie buff who's keen to review AI films we'd love to hear from you. A bit about yourself, what films you like etc would be useful and if you have any examples of your work already please do share those.</p>
          <div class="joinBox">
            <h3>Write reviews for AIMB</h3>
            <p>Send us a short introduction and, if you have them, examples of your writing.</p>
            <a class="outlineButton" href="mailto:contact@aimoviebase.com?subject=Writing%20for%20AIMB">Get in touch <span aria-hidden="true">↗</span></a>
          </div>
        </section>
      </div>

      <aside class="aboutSide">
        <div class="aboutSideKicker aboutSectionKicker">Contact &amp; contributions</div>
        <div class="aboutContact">
          <h3>Submit a film</h3>
          <p>Made an AI film or series? Share your work for consideration in the AIMB catalog.</p>
          <a href="/submit-film">Submit your film <span aria-hidden="true">→</span></a>
        </div>
        <div class="aboutContact">
          <h3>Write reviews for AIMB</h3>
          <p>Critics, journalists and film writers are welcome to pitch reviews and editorial stories.</p>
          <a href="mailto:contact@aimoviebase.com?subject=Writing%20for%20AIMB">Become a contributor <span aria-hidden="true">→</span></a>
        </div>
        <div class="aboutContact">
          <h3>Corrections &amp; updates</h3>
          <p>Found an incorrect credit, missing information or a broken link? Help us improve the catalog.</p>
          <a href="mailto:contact@aimoviebase.com?subject=Catalog%20correction">Report an update <span aria-hidden="true">→</span></a>
        </div>
        <div class="aboutContact" style="border-bottom:0">
          <h3>Partnerships &amp; media</h3>
          <p>For editorial collaborations, festivals, studios, tools and other business inquiries.</p>
          <a href="mailto:contact@aimoviebase.com?subject=Partnership%20inquiry">Contact AIMB <span aria-hidden="true">→</span></a>
        </div>
        <p class="aboutSmallnote">All submissions and editorial pitches are reviewed at AIMB's discretion.</p>
      </aside>
    </div>

    <section class="aboutBottom">
      <span>Explore AI cinema</span>
      <h2>Find your next<br /><em>remarkable film.</em></h2>
      <a href="/movies">Explore AI Movies <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</BaseLayout>
