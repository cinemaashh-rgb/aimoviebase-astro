---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" description="AIMB is an independent discovery platform for AI cinema: our mission, how we curate films, and how to write for AIMB.">
  <style>
    /* About AIMB — single-column editorial layout (aimb_about_us_writers_layout_fixed.html),
       reusing the site's own ink/accent tokens instead of the mockup's local palette. */
    .aboutPage { color: var(--ink); font-family: var(--sans); max-width: 820px; margin: 0 auto; }
    .aboutPage * { box-sizing: border-box; }

    .aboutBreadcrumb { font: 12px/1.5 var(--sans); color: var(--muted2); margin-bottom: 28px; }
    .aboutBreadcrumb a:hover { color: #cf6246; }
    .aboutBreadcrumb span { padding: 0 10px; }

    .aboutHero { padding: 15px 0 42px; border-bottom: 1px solid var(--line); }
    .aboutKicker { font: 700 11px/1.5 var(--sans); letter-spacing: .14em; color: #cf6246; text-transform: uppercase; }
    .aboutHero h1 { font: 400 clamp(44px,7.4vw,92px)/1.02 var(--serif); letter-spacing: -.05em; margin: 21px 0 22px; color: var(--ink); }
    .aboutHero h1 em { font-style: normal; color: #cf6246; }
    .aboutLead { max-width: 650px; font: 400 clamp(19px,2.2vw,26px)/1.5 var(--serif); color: var(--muted); margin: 0; }
    .aboutAttribution { font: 700 11px var(--sans); letter-spacing: .08em; color: var(--muted2); display: flex; align-items: center; gap: 9px; margin-top: 28px; }
    .aboutDot { height: 7px; width: 7px; border-radius: 50%; background: #cf6246; }

    .aboutMainGrid { padding-top: 45px; }
    .aboutProseSection { margin: 0 0 52px; }
    .aboutProseSection:last-child { margin-bottom: 35px; }
    .aboutSectionKicker { font: 700 11px/1.5 var(--sans); letter-spacing: .14em; color: #cf6246; }
    .aboutProseSection h2 { font: 400 clamp(29px,3.4vw,42px)/1.14 var(--serif); letter-spacing: -.03em; margin: 17px 0 23px; }
    .aboutProseSection p { font: 16px/1.88 var(--serif); color: #4e5866; margin: 0 0 19px; max-width: 760px; }

    /* ---- Write for AIMB application ---- */
    .writerApply { padding: 40px 0 10px; margin-top: 0; border-top: 1px solid var(--line); }
    .writerApply h2 { font: 400 clamp(31px,4.5vw,50px)/1.12 var(--serif); letter-spacing: -.035em; margin: 18px 0 20px; color: var(--ink); }
    .writerApply h2 em { font-style: normal; color: #cf6246; }
    .writerApply > p { font: 16px/1.75 var(--serif); color: #4e5866; margin: 0 0 14px; max-width: 720px; }
    .writerApplyForm { margin-top: 30px; }
    .writerApplyGrid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 18px; row-gap: 20px; }
    .writerField { display: flex; flex-direction: column; gap: 9px; min-width: 0; }
    .writerFieldWide { grid-column: 1/-1; }
    .writerField label { font: 700 12px/1.4 var(--sans); color: #343a41; }
    .writerField label span:not(.writerOptional) { color: #cf6246; }
    .writerOptional { font-weight: 400; color: #818a95; }
    .writerField input, .writerField textarea { display: block; width: 100%; min-height: 46px; padding: 13px 14px; border: 1px solid var(--line); border-radius: 3px; background: #fff; color: #1b1e23; font: 14px/1.5 var(--sans); outline: none; }
    .writerField textarea { resize: vertical; min-height: 130px; }
    .writerField input:focus, .writerField textarea:focus { border-color: #cf6246; box-shadow: 0 0 0 3px rgba(207,98,70,.1); }
    .writerApplyActions { display: flex; gap: 20px; flex-wrap: wrap; align-items: flex-start; margin-top: 24px; }
    .writerApplyButton { display: inline-flex; gap: 18px; align-items: center; justify-content: center; padding: 14px 21px; border: 0; border-radius: 4px; background: linear-gradient(112deg,#b54433,#e5784a 48%,#bb4c37); color: #fff; font: 700 12px var(--sans); cursor: pointer; transition: filter .2s ease; }
    .writerApplyButton:hover { filter: brightness(1.08); }
    .writerApplyNote { font: 12px/1.6 var(--sans); color: var(--muted2); margin: 0; max-width: 290px; }

    @media (max-width: 650px) {
      .aboutPage { width: calc(100% - 36px); }
      .aboutHero { padding: 0 0 29px; }
      .aboutHero h1 { font-size: clamp(44px,12vw,65px); line-height: 1.05; margin: 15px 0 17px; }
      .aboutLead { font-size: 18px; line-height: 1.55; }
      .aboutMainGrid { padding-top: 30px; }
      .aboutProseSection { margin-bottom: 41px; }
      .aboutProseSection h2 { font-size: clamp(29px,8vw,38px); line-height: 1.12; }
      .aboutProseSection p { font-size: 15px; line-height: 1.75; }
      .writerApply { padding: 31px 0 10px; }
      .writerApply h2 { font-size: clamp(31px,9vw,45px); line-height: 1.1; }
      .writerApplyGrid { grid-template-columns: minmax(0,1fr); row-gap: 17px; }
      .writerFieldWide { grid-column: 1; }
      .writerApplyActions { flex-direction: column; align-items: stretch; gap: 12px; }
      .writerApplyButton { width: 100%; min-height: 46px; }
      .writerApplyNote { max-width: 100%; }
    }
  </style>

  <div class="aboutPage">
    <nav class="aboutBreadcrumb"><a href="/">Home</a><span>/</span>About Us</nav>

    <section class="aboutHero">
      <div class="aboutKicker">About / AI Movie Base</div>
      <h1>Made by people.<br /><em>For people.</em></h1>
      <p class="aboutLead">AIMB is an independent guide to AI cinema. We discover, document and curate films worth watching — with human judgment at the center.</p>
      <div class="aboutAttribution"><span class="aboutDot"></span> The independent guide to AI cinema</div>
    </section>

    <div class="aboutMainGrid">
      <section class="aboutProseSection" id="mission" aria-labelledby="mission-h">
        <div class="aboutSectionKicker">01 / OUR MISSION</div>
        <h2 id="mission-h">Our mission</h2>
        <p>Film has always evolved alongside technology. Artificial intelligence is creating brand new pathways for conceiving, creating and sharing stories and an entire generation of filmmakers are getting to work exploring what that means for movies.</p>
        <p>AIMB exists to help this emerging world find its audience. It's about connecting film enthusiasts, independent artists, studios and critics around this new wave in cinema. If it's good, it should be found. Whether you made it yourself or it's from a Hollywood studio or anywhere in between.</p>
        <p>Our ambition is to give extraordinary AI films a home to be discovered, talked about and remembered. And help those stories find audiences far beyond the communities they were created in.</p>
        <p>Discover the standout AI films, series and shorts from around the world. Link to verified credits, learn about production tools and celebrate the festivals &amp; selections they have received. Create space for honest criticism, new perspectives and real discussion.</p>
        <p>We are not a streaming platform. AIMB is a discovery platform, built to help audiences find films and help films find their audience. By linking to the creators and platforms that can deliver the content to your homes.</p>
      </section>

      <section class="aboutProseSection" id="community" aria-labelledby="community-h">
        <div class="aboutSectionKicker">02 / OUR COMMUNITY</div>
        <h2 id="community-h">Building a creative community around AI generated cinema.</h2>
        <p>New waves of cinema need more than revolutionary technology. They need curious audiences. They need discussion, they need criticism and they need people who are willing to fight for great work and champion it to the world.</p>
        <p>We want AIMB to be where filmmakers and movie fans can come together. To discover new talent, watch the medium evolve and talk about movies from the perspective of the story; not just the technology used to tell it.</p>
        <p>As this new technology and these films evolve we want to evolve with them. To document their progress, champion the indie films that blow us away and help audiences all over the world find movies worth watching.</p>
      </section>
    </div>

    <section class="writerApply" aria-labelledby="writer-apply-title" id="write-for-aimb">
      <div class="aboutSectionKicker">03 / WRITE FOR AIMB</div>
      <h2 id="writer-apply-title">Love AI movies?<br /><em>Write about them.</em></h2>
      <p>We believe AI films deserve the same high standard of independent criticism as any other form of cinema. Good criticism allows the audience to find movies that are worth watching and helps filmmakers better understand how their work is received.</p>
      <p>If you're a film critic, filmmaker, writer or just a movie obsessive who loves watching (and writing about) AI movies then we want to hear from you. Shoot us an email with a little bit about yourself, the kinds of films you like to write about and if possible attach a few examples of your previous work.</p>

      <form class="writerApplyForm" id="writerApplication" method="post" action="mailto:contact@aimoviebase.com" enctype="text/plain">
        <div class="writerApplyGrid">
          <div class="writerField">
            <label for="writerName">Your name <span aria-hidden="true">*</span></label>
            <input type="text" id="writerName" name="Name" placeholder="Full name" autocomplete="name" required />
          </div>
          <div class="writerField">
            <label for="writerEmail">Email address <span aria-hidden="true">*</span></label>
            <input type="email" id="writerEmail" name="Email" placeholder="you@example.com" autocomplete="email" required />
          </div>
          <div class="writerField writerFieldWide">
            <label for="writerExperience">Tell us about yourself <span aria-hidden="true">*</span></label>
            <textarea id="writerExperience" name="About" rows="5" placeholder="What AI films interest you, and why would you like to review them for AIMB?" required></textarea>
          </div>
          <div class="writerField writerFieldWide">
            <label for="writerSamples">Writing samples or portfolio <span class="writerOptional">(optional)</span></label>
            <input type="url" id="writerSamples" name="Writing samples" placeholder="https://..." />
          </div>
        </div>
        <div class="writerApplyActions">
          <button class="writerApplyButton" type="submit">Apply to write for AIMB <span aria-hidden="true">↗</span></button>
          <p class="writerApplyNote">Your email app will open with a prepared application. You can review it before sending.</p>
        </div>
      </form>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About AIMB',
  })} />

  <script is:inline>
    /* No backend: compose an email draft instead. */
    (function () {
      var form = document.getElementById('writerApplication');
      if (!form) return;
      form.addEventListener('submit', function (event) {
        if (!form.reportValidity()) { event.preventDefault(); return; }
        event.preventDefault();
        var name = document.getElementById('writerName').value.trim();
        var email = document.getElementById('writerEmail').value.trim();
        var about = document.getElementById('writerExperience').value.trim();
        var samples = document.getElementById('writerSamples').value.trim();
        var subject = 'AIMB — Review Writer Application: ' + name;
        var body = ['Name: ' + name, 'Email: ' + email, '', 'About me and why I want to review AI films:', about, '', 'Writing samples / portfolio: ' + (samples || 'Not provided')].join('\n');
        window.location.href = 'mailto:contact@aimoviebase.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      });
    })();
  </script>
</BaseLayout>
