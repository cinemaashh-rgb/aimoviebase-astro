---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Terms of Use" description="Terms of use for AI Movie Base.">
  <h1 style="margin-top:34px">Terms of Use</h1>
  <p class="lede" style="color:var(--muted); max-width:700px; line-height:1.6; font-size:1.05rem; margin-bottom:16px;">By using the AI Movie Base website, you agree to the following terms.</p>

  <h2>Content</h2>
  <p class="lede" style="color:var(--muted); max-width:700px; line-height:1.6; margin-bottom:16px;">Descriptions, ratings, and reviews on the site are provided for informational purposes. Rights to the films themselves belong to their creators.</p>

  <h2>User Reviews</h2>
  <p class="lede" style="color:var(--muted); max-width:700px; line-height:1.6;">By posting a review, you confirm that it reflects your own opinion and does not infringe on the rights of third parties.</p>
</BaseLayout>
