---
import BaseLayout from '../layouts/BaseLayout.astro';

// NOTE: the original site rendered a per-user "X of Y watched" progress
// circle next to each list, but there was never an account system behind
// it — every visitor saw the same static mock numbers. Since user accounts
// (Supabase) are out of scope for this migration, we're dropping the fake
// progress UI here rather than reproducing numbers that don't mean
// anything yet, and keeping just the real list titles and counts.
const lists = [
  { emoji: '⭐', title: "AIMB Editor's Picks", count: 8 },
  { emoji: '🔥', title: 'Most Popular', count: 10 },
  { emoji: '🥇', title: 'Award Winners & Nominees', count: 5 },
  { emoji: '🎬', title: 'The Essential AI Shorts', count: 24 },
  { emoji: '🎭', title: 'SAG-AFTRA Approved: Real Performers, AI Visuals', count: 6 },
  { emoji: '🏆', title: 'AI Film Festival Selections', count: 18 },
  { emoji: '🎥', title: 'Solo Director Showcases', count: 9 },
  { emoji: '🛍️', title: 'Brand & Commercial AI Films', count: 11 },
  { emoji: '🧪', title: 'Experimental & No-Camera Filmmaking', count: 15 },
];
---
<BaseLayout title="Lists" description="Curated lists of AI-made films, by theme, by model, by festival selection.">
  <h1 style="margin-top:34px">Lists</h1>
  <p class="lede" style="color:var(--muted); max-width:700px; line-height:1.6; font-size:1.05rem; margin-bottom:28px;">Curated lists of AI-made films — by theme, by model, by festival selection.</p>

  {lists.map((l, i) => (
    <div style={`display:flex; align-items:center; gap:18px; padding:16px 14px; border-radius:10px; ${i % 2 === 1 ? 'background:var(--bg-elev);' : ''}`}>
      <div style="flex:0 0 64px; width:64px; height:64px; border-radius:10px; background:linear-gradient(135deg,#2a2e36,#1f2228); display:flex; align-items:center; justify-content:center; font-size:1.5rem;">{l.emoji}</div>
      <div style="flex:1; min-width:0;">
        <div style="font-weight:700; font-size:1.05rem; margin-bottom:2px;">{l.title}</div>
        <div style="color:var(--muted); font-size:.82rem;">{l.count} films</div>
      </div>
    </div>
  ))}

  <p class="lede" style="color:var(--muted); margin-top:28px;">More lists are on the way. In the meantime, browse the catalog by <a href="/genre/scifi" style="color:var(--accent);">genre</a>.</p>
</BaseLayout>
