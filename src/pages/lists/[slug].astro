---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const lists = await getCollection('lists');
  const movies = await getCollection('movies');
  return lists.map((list) => {
    const films = list.data.movies
      .map((slug) => movies.find((m) => m.id === slug))
      .filter((m): m is CollectionEntry<'movies'> => Boolean(m));
    // "Keep exploring" — up to 3 of the catalog's other real lists, so the
    // page always ends with somewhere real to go next rather than the
    // mockup's invented slugs for collections we don't have. Each one also
    // carries its own small poster fan (same idea as this page's own hero
    // `filmStack`) so "Keep exploring" reads as a preview of real films
    // rather than a plain text card.
    const related = lists
      .filter((l) => l.id !== list.id)
      .slice(0, 3)
      .map((r) => {
        const rFilms = r.data.movies
          .map((slug) => movies.find((m) => m.id === slug))
          .filter((m): m is CollectionEntry<'movies'> => Boolean(m));
        const posters = rFilms
          .map((f) => f.data.poster)
          .filter((p): p is string => Boolean(p))
          .slice(0, 5);
        return { entry: r, filmCount: r.data.movies.length, posters };
      });
    return {
      params: { slug: list.id },
      props: { list, films, related },
    };
  });
}

interface Props {
  list: CollectionEntry<'lists'>;
  films: CollectionEntry<'movies'>[];
  related: { entry: CollectionEntry<'lists'>; filmCount: number; posters: string[] }[];
}
const { list, films, related } = Astro.props;
const l = list.data;
const stackPosters = films.filter((f) => f.data.poster).slice(0, 5);

function meta(f: CollectionEntry<'movies'>) {
  const parts = [String(f.data.year)];
  if (f.data.duration) parts.push(f.data.duration);
  const line = parts.join(' · ');
  return f.data.director ? `${line} · By ${f.data.director.name}` : line;
}
---
<BaseLayout title={l.name} description={l.description}>
  <style>
    .crumb { font-size: .78rem; color: var(--muted2); margin: 0 0 22px; }
    .crumb a:hover { color: #cf6246; }
    .eyebrow { font-size: .68rem; font-weight: 800; letter-spacing: .15em; color: #cf6246; text-transform: uppercase; margin: 0 0 14px; }

    .heading { display: grid; grid-template-columns: minmax(0,1fr) 300px; gap: 32px; align-items: center; border-bottom: 1px solid var(--line); padding-bottom: 36px; margin-bottom: 10px; }
    .heading h1 { font: 400 clamp(38px,5.2vw,64px)/.98 var(--serif); letter-spacing: -0.03em; margin: 0 0 14px; }
    .heading h1 em { font-style: italic; color: #cf6246; }
    .lead { font: 1.15rem/1.5 var(--serif); color: var(--muted); max-width: 540px; margin: 0; }
    .byline { display: flex; gap: 14px; flex-wrap: wrap; font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted2); margin-top: 22px; }
    .byline b { color: var(--ink); }

    .featureArt { padding-top: 6px; }
    .filmStack { height: 210px; display: flex; justify-content: center; align-items: center; position: relative; }
    .filmStack img { width: 22%; aspect-ratio: 2/3; object-fit: cover; box-shadow: 0 10px 22px rgba(0,0,0,.14); border: 3px solid #fff; border-radius: 4px; margin-left: -14px; }
    .filmStack img:nth-child(1) { transform: rotate(-7deg); }
    .filmStack img:nth-child(2) { transform: rotate(-3deg) translateY(-10px); }
    .filmStack img:nth-child(3) { transform: rotate(2deg) translateY(6px); }
    .filmStack img:nth-child(4) { transform: rotate(6deg) translateY(-7px); }
    .filmStack img:nth-child(5) { transform: rotate(9deg); }
    .featureArt span { display: block; text-align: center; font-size: .62rem; letter-spacing: .14em; color: var(--muted2); margin-top: 10px; }

    .sectionline { display: flex; align-items: baseline; justify-content: space-between; border-top: 1px solid var(--line); padding: 26px 0 22px; gap: 12px; }
    .sectionline h2 { font: 400 1.9rem/1.1 var(--serif); letter-spacing: -0.02em; margin: 0; }
    .sectionline .toolbar { display: flex; align-items: center; gap: 10px; }
    .sortSelect { height: 34px; border: 1px solid var(--line); background: #fff; border-radius: 6px; color: var(--ink); font-size: .78rem; padding: 0 10px; }

    .story { display: grid; grid-template-columns: 180px 1fr; gap: 26px; border-bottom: 1px solid var(--line); padding: 20px 0 26px; align-items: start; }
    .story[hidden] { display: none; }
    .story .image { aspect-ratio: 2/3; border-radius: 4px; overflow: hidden; background: var(--soft); }
    .story .image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s ease; }
    .story > a:hover .image img { transform: scale(1.035); }
    .rank { font-size: .68rem; letter-spacing: .1em; color: #cf6246; font-weight: 800; }
    .story h3 { font: 400 1.7rem/1.12 var(--serif); letter-spacing: -0.02em; margin: 8px 0 7px; }
    .story h3 a:hover { color: #cf6246; }
    .info { font-size: .8rem; color: var(--muted2); }
    .exploreLink { display: inline-block; font-size: .76rem; font-weight: 700; border-bottom: 1px solid #cf6246; padding-bottom: 3px; margin-top: 10px; }

    .related { margin-top: 20px; padding-top: 30px; border-top: 1px solid var(--line); }
    /* Each "Keep exploring" entry mirrors this page's own hero: text on the
       left, a small fanned poster stack on the right — same idea as
       .heading/.filmStack above, scaled down into a row. */
    .relatedList { display: flex; flex-direction: column; gap: 14px; }
    .relatedRow { display: grid; grid-template-columns: minmax(0,1fr) 230px; align-items: center; gap: 26px; padding: 22px 26px; background: var(--soft); border: 1px solid var(--line); border-radius: 8px; transition: background .2s ease, border-color .2s ease; }
    .relatedRow:hover { background: #fff0e7; border-color: #e9c6b6; }
    .relLabel { font-size: .64rem; color: #cf6246; letter-spacing: .12em; text-transform: uppercase; }
    .relatedRow strong { font: 400 1.5rem/1.18 var(--serif); display: block; margin: 7px 0 8px; }
    .relatedRow .relMeta { font-size: .8rem; color: var(--muted2); }
    .relatedRow .relMeta b { color: #cf6246; margin-left: 2px; }
    .relStack { height: 108px; display: flex; justify-content: center; align-items: center; position: relative; }
    .relStack img { width: 26%; aspect-ratio: 2/3; object-fit: cover; box-shadow: 0 8px 16px rgba(0,0,0,.14); border: 2px solid #fff; border-radius: 3px; margin-left: -18px; }
    .relStack img:nth-child(1) { transform: rotate(-7deg); }
    .relStack img:nth-child(2) { transform: rotate(-3deg) translateY(-6px); }
    .relStack img:nth-child(3) { transform: rotate(2deg) translateY(4px); }
    .relStack img:nth-child(4) { transform: rotate(6deg) translateY(-5px); }
    .relStack img:nth-child(5) { transform: rotate(9deg); }

    @media (max-width: 860px) {
      .heading { grid-template-columns: 1fr; }
      .featureArt { display: none; }
      /* Keep the same fanned-poster card as desktop on mobile too — just
         stacked (text, then posters) instead of side-by-side, and sized
         down a bit. Previously this hid .relStack entirely, which left
         "Keep exploring" as plain text boxes with no film art at all. */
      .relatedRow { grid-template-columns: 1fr; gap: 10px; }
      .relStack { height: 86px; }
      .relStack img { width: 23%; }
    }
    @media (max-width: 620px) {
      .story { grid-template-columns: 120px 1fr; gap: 15px; }
      .story h3 { font-size: 1.2rem; }
    }
  </style>

  <p class="crumb"><a href="/">Home</a> / <a href="/lists">Lists</a> / {l.name}</p>
  <div class="eyebrow">AIMB · Curated Collection</div>

  <section class="heading">
    <div>
      <h1>{l.name}</h1>
      <p class="lead">{l.description}</p>
      <div class="byline">
        <b>AIMB{l.placeholder ? '' : ' Editorial'}</b>
        <span>{films.length} film{films.length === 1 ? '' : 's'}</span>
        <span>{l.placeholder ? 'Starter collection' : 'Editorial collection'}</span>
      </div>
    </div>
    {stackPosters.length >= 3 && (
      <div class="featureArt">
        <div class="filmStack">
          {stackPosters.map((f) => <img src={f.data.poster} alt="" loading="lazy" />)}
        </div>
        <span>{films.length} FILMS IN THIS COLLECTION</span>
      </div>
    )}
  </section>

  {l.placeholder && (
    <p class="pageLede" style="font-size:.84rem; margin:18px 0 0;">This is a starter list, grouped mechanically from existing catalog data rather than hand-curated by an editor — flagged here so it's clear which lists are real editorial picks. See the README for the full rundown.</p>
  )}

  {films.length > 0 ? (
    <>
      <div class="sectionline">
        <h2>The selection</h2>
        {l.placeholder && (
          <div class="toolbar">
            <select class="sortSelect" id="sortSelect">
              <option value="rank">List order</option>
              <option value="newest">Newest first</option>
              <option value="oldest">Oldest first</option>
              <option value="title">Title A–Z</option>
            </select>
          </div>
        )}
      </div>
      <div id="filmList">
        {films.map((f, i) => (
          <article class="story" data-year={f.data.year} data-title={f.data.title} data-rank={i + 1}>
            <a href={`/movies/${f.id}`} aria-label={f.data.title}>
              <div class="image">
                {f.data.poster ? <img src={f.data.poster} alt={f.data.title} loading={i < 4 ? 'eager' : 'lazy'} /> : <div class="posterFallback" style="width:100%;height:100%;">{f.data.title}</div>}
              </div>
            </a>
            <div>
              <span class="rank">SELECTION {String(i + 1).padStart(2, '0')} / {String(films.length).padStart(2, '0')}</span>
              <h3><a href={`/movies/${f.id}`}>{f.data.title}</a></h3>
              <p class="info">{meta(f)}</p>
              <a class="exploreLink" href={`/movies/${f.id}`}>Explore film ↗</a>
            </div>
          </article>
        ))}
      </div>
    </>
  ) : (
    <p class="pageLede">No films in this list yet.</p>
  )}

  {related.length > 0 && (
    <section class="related">
      <div class="sectionline" style="border-top:0; padding-top:0;"><h2>Keep exploring</h2></div>
      <div class="relatedList">
        {related.map(({ entry: r, filmCount, posters }) => (
          <a class="relatedRow" href={`/lists/${r.id}`}>
            <div>
              <span class="relLabel">Collection</span>
              <strong>{r.data.name}</strong>
              <span class="relMeta">{filmCount} film{filmCount === 1 ? '' : 's'} <b>↗</b></span>
            </div>
            {posters.length >= 3 && (
              <div class="relStack">
                {posters.map((p) => <img src={p} alt="" loading="lazy" />)}
              </div>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  {l.placeholder && (
    <script is:inline define:vars={{ count: films.length }}>
      (function () {
        var list = document.getElementById('filmList');
        var select = document.getElementById('sortSelect');
        if (!list || !select) return;
        var cards = [].slice.call(list.children);
        select.addEventListener('change', function () {
          var mode = select.value;
          var sorted = cards.slice().sort(function (a, b) {
            if (mode === 'newest') return Number(b.dataset.year) - Number(a.dataset.year) || Number(a.dataset.rank) - Number(b.dataset.rank);
            if (mode === 'oldest') return Number(a.dataset.year) - Number(b.dataset.year) || Number(a.dataset.rank) - Number(b.dataset.rank);
            if (mode === 'title') return a.dataset.title.localeCompare(b.dataset.title);
            return Number(a.dataset.rank) - Number(b.dataset.rank);
          });
          list.replaceChildren.apply(list, sorted);
        });
      })();
    </script>
  )}
</BaseLayout>
