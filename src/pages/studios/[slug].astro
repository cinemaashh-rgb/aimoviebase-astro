---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const studios = await getCollection('studios');
  const movies = await getCollection('movies');
  return studios.map((studio) => {
    const films = studio.data.films
      .map((slug) => movies.find((m) => m.id === slug))
      .filter((m): m is CollectionEntry<'movies'> => Boolean(m));
    return {
      params: { slug: studio.id },
      props: { studio, films },
    };
  });
}

interface Props {
  studio: CollectionEntry<'studios'>;
  films: CollectionEntry<'movies'>[];
}
const { studio, films } = Astro.props;
const s = studio.data;
---
<BaseLayout title={s.name} description={s.description}>
  <div class="personHero" style="display:flex; gap:22px; align-items:flex-start; margin:30px 0 8px; flex-wrap:wrap;">
    <div class="personPhoto" style="flex:0 0 150px; width:150px; aspect-ratio:3/4; border-radius:14px; overflow:hidden; background:linear-gradient(135deg,#4f46e5,#8b7bf0); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:800; font-size:2.3rem; font-family:Georgia,serif;">
      {s.name.split(' ').slice(0, 2).map((w) => w.charAt(0)).join('').toUpperCase()}
    </div>
    <div class="personInfo" style="flex:1; min-width:220px;">
      <h1 class="personName">{s.name}</h1>
      <div class="personRole" style="color:var(--fg); font-size:.92rem; font-weight:600; margin-bottom:2px;">Studio</div>
      {s.basedIn && <div class="personStudio" style="color:var(--muted); font-size:.85rem; margin-bottom:14px;">{s.basedIn}</div>}
      <p class="personBioShort">{s.description}</p>
      {s.descriptionMore && <p style="color:var(--fg); font-size:.88rem; line-height:1.55; max-width:600px; margin-top:10px;">{s.descriptionMore}</p>}
    </div>
  </div>

  {films.length > 0 && (
    <>
      <div class="filmsHeadRow" style="display:flex; align-items:baseline; justify-content:space-between; margin:34px 0 10px;">
        <h2 style="margin:0">Films</h2>
      </div>
      <div class="rowScroll" style="display:flex; gap:14px; overflow-x:auto; padding-bottom:8px;">
        {films.map((f) => (
          <a class="card" href={`/movies/${f.id}`} style="flex:0 0 220px; display:block; border:1px solid var(--border); border-radius:8px; overflow:hidden;">
            <div class="thumb" style="aspect-ratio:16/9; background:linear-gradient(135deg,#f0ebe0,#f7f3ee); overflow:hidden; display:flex; align-items:center; justify-content:center;">
              {f.data.poster ? (
                <img src={f.data.poster} alt={f.data.title} style="width:100%;height:100%;object-fit:cover;display:block;" />
              ) : (
                <span style="text-align:center; padding:6px; font-weight:600; font-size:.74rem; color:var(--muted);">{f.data.title}</span>
              )}
            </div>
            <div class="body" style="padding:12px;">
              <div class="title-row"><strong>{f.data.title}</strong></div>
              <div class="meta" style="color:var(--muted); font-size:.74rem;">{f.data.year} · {f.data.type === 'series' ? 'Series' : 'Movie'}</div>
            </div>
          </a>
        ))}
      </div>
    </>
  )}
</BaseLayout>
