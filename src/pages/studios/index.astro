---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { studioHasPage } from '../../lib/links';

// A studio with only one film doesn't get a page of its own (see
// src/lib/links.ts) — this directory links out to studio pages, so it
// only lists studios that have one, rather than a card with nowhere to go.
const allStudios = await getCollection('studios');
const studios = allStudios.filter(studioHasPage);
studios.sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<BaseLayout title="AI Studios" description="AI filmmaking studios on AI Movie Base.">
  <style>
    .studioCard { display: block; border: 1px solid var(--line); border-radius: 10px; padding: 18px; }
    .studioCard:hover { border-color: var(--blue); }
    .studioCard strong { font-size: 1rem; }
    .studioCard p { color: var(--muted); font-size: .84rem; margin: 8px 0 6px; line-height: 1.45; }
    .studioGrid { display: grid; grid-template-columns: repeat(auto-fill,minmax(230px,1fr)); gap: 14px; }
  </style>
  <Breadcrumbs items={[
    { name: 'Home', url: '/' },
    { name: 'Studios', url: '/studios' },
  ]} />
  <h1 style="margin-top:0">AI Studios</h1>
  <p class="pageLede" style="margin-bottom:28px">{studios.length} studio{studios.length === 1 ? '' : 's'} with two or more catalog titles so far — {allStudios.length} total studios are credited across the catalog, but a studio with a single film doesn't get its own page yet.</p>

  <div class="studioGrid">
    {studios.map((studio) => (
      <a class="studioCard" href={`/studios/${studio.id}`}>
        <strong>{studio.data.name}</strong>
        <p>{studio.data.description}</p>
        <div style="color:var(--blue); font-size:.78rem; font-weight:600;">{studio.data.films.length} {studio.data.films.length === 1 ? 'film' : 'films'}</div>
      </a>
    ))}
  </div>
</BaseLayout>
