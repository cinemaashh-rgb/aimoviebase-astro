---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getToolMeta } from '../../data/toolMeta';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const creators = await getCollection('creators');
  return creators.map((creator) => ({
    params: { slug: creator.id },
    props: { creator },
  }));
}

interface Props {
  creator: CollectionEntry<'creators'>;
}
const { creator } = Astro.props;
const c = creator.data;

const movies = await getCollection('movies');
const films = c.films
  .map((slug) => movies.find((m) => m.id === slug))
  .filter((m): m is CollectionEntry<'movies'> => Boolean(m));
const movieCount = films.filter((f) => f.data.type !== 'series').length;
const seriesCount = films.filter((f) => f.data.type === 'series').length;
const shortCount = 0; // no "short" sub-type in the schema yet — kept for parity with the mockup's filter pills

// "Creative stack" — the creator-page mockup's tool carousel, but counted
// from real per-film aiTools credits instead of hand-curated placeholder
// data. Aggregated across this creator's filmography, most-used first.
const toolCounts = new Map<string, number>();
for (const f of films) {
  for (const t of f.data.aiTools) {
    toolCounts.set(t, (toolCounts.get(t) || 0) + 1);
  }
}
const creativeStack = [...toolCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count, meta: getToolMeta(name) }));

// "Awards & Recognition" sidebar (ported from the real creator-page mockup,
// aimb_creator_kavan_cardoza_laurels_bw.html). The mockup's own award data
// is illustrative placeholder content, so rather than hand-maintain a
// separate awards list per creator (which drifts out of sync and is easy
// to leave empty — true of all 27 creator records before this change),
// it's aggregated the same way the creative stack already is: straight
// from each film's own `awards` credits, which are real and already
// verified on the movie pages. A creator record can still carry explicit
// director-level awards (not tied to one film) via its own `awards` field;
// those are shown first, film-derived ones after.
const awardsList = [
  ...(c.awards || []).map((a) => ({ title: a.title, note: a.note })),
  ...films.flatMap((f) => (f.data.awards || []).map((a) => ({ title: a, note: f.data.title }))),
];
---
<BaseLayout title={c.name} description={c.bio}>
  <style>
    .personHero { display: grid; grid-template-columns: 220px 1fr; gap: 26px; margin: 24px 0 10px; align-items: start; }
    .personHero.withAwards { grid-template-columns: 220px minmax(300px,1fr) 260px; }
    .personPhoto { width: 100%; aspect-ratio: 3/4; border-radius: 12px; overflow: hidden; background: linear-gradient(135deg,var(--blue),#5e85c9); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: 2.6rem; font-family: var(--serif); }
    .personPhoto img { width: 100%; height: 100%; object-fit: cover; display: block; }
    h1.name { font-size: clamp(28px,3.4vw,40px); margin: 0 0 2px; }
    .alias { color: var(--muted); font-size: .95rem; margin-bottom: 10px; }
    .rolebar { display: inline-flex; align-items: center; background: var(--soft); border-radius: 999px; padding: 5px 13px; font-size: .78rem; font-weight: 700; color: var(--ink); margin-bottom: 10px; }
    .social { display: inline-flex; gap: 10px; margin-left: 10px; vertical-align: middle; }
    .social a { color: var(--muted); font-size: .8rem; font-weight: 700; border: 1px solid var(--line); border-radius: 999px; padding: 4px 11px; }
    .facts { display: flex; gap: 18px; flex-wrap: wrap; color: var(--muted); font-size: .86rem; margin: 12px 0; }
    .awardsCol { border-left: 1px solid var(--line); padding-left: 20px; align-self: start; }
    .awardsCol h2 { font-size: 1rem; margin: 0 0 14px; }
    .awardsScroll { max-height: 340px; overflow-y: auto; padding-right: 4px; }
    .awardRow { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 14px; font-size: .82rem; }
    .awardRow .ico { flex: none; font-size: 1.1rem; color: var(--ink); margin-top: 1px; }
    .awardRow strong { display: block; font-size: .83rem; line-height: 1.3; }
    .awardRow span { color: var(--muted); font-size: .76rem; }
    .headingbar { display: flex; align-items: baseline; justify-content: space-between; margin: 36px 0 12px; flex-wrap: wrap; gap: 10px; }
    .controls { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .pill { border: 1px solid var(--line); background: #fff; border-radius: 20px; padding: 6px 14px; font-size: .8rem; font-weight: 600; color: var(--muted); cursor: pointer; }
    .pill[aria-pressed="true"] { background: var(--black); color: #fff; border-color: var(--black); }
    .sortSelect { height: 34px; border: 1px solid var(--line); background: #fff; border-radius: 6px; color: var(--ink); font-size: .8rem; padding: 0 10px; }
    .films-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(160px,1fr)); gap: 16px 14px; }
    .films-grid a[hidden] { display: none; }
    .films-grid .thumb { aspect-ratio: 2/3; background: var(--soft); border-radius: 6px; overflow: hidden; }
    .films-grid img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .films-grid h3 { font-size: .86rem; margin: 8px 0 2px; }
    .films-grid .meta { font-size: .76rem; color: var(--muted); }
    .stackSection { border-top: 1px solid var(--line); margin-top: 36px; padding-top: 24px; }
    .stackSection h2 { font-size: 1.5rem; margin: 0; }
    .stackSection .stackLede { font-size: .84rem; color: var(--muted); margin: 5px 0 14px; }
    .stackWrap { position: relative; }
    .toolScroll { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 2px 1px 15px; scrollbar-width: thin; scrollbar-color: #cfd3d9 transparent; }
    .toolCard { scroll-snap-align: start; flex: 0 0 148px; border: 1px solid var(--line); min-height: 118px; border-radius: 8px; padding: 12px; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 4px; text-align: center; }
    .toolCard:hover { border-color: #b3beca; }
    .toolCard strong { font-size: .78rem; }
    .toolCard small { font-size: .7rem; color: var(--muted); }
    .toolmark { width: 36px; height: 36px; border-radius: 8px; display: grid; place-items: center; font-size: 1.15rem; font-weight: 800; margin-bottom: 4px; }
    .carouselBtn { position: absolute; top: 36px; width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid var(--line); background: #fff; border-radius: 50%; z-index: 1; }
    .carouselBtn.left { left: -16px; }
    .carouselBtn.right { right: -16px; }
    @media (max-width: 760px) {
      .personHero, .personHero.withAwards { grid-template-columns: 1fr; }
      .personPhoto { width: 150px; }
      .awardsCol { border-left: 0; border-top: 1px solid var(--line); padding: 18px 0 0; margin-top: 6px; }
      .carouselBtn.left { left: 0; }
      .carouselBtn.right { right: 0; }
    }
  </style>

  <div class={`personHero ${awardsList.length > 0 ? 'withAwards' : ''}`}>
    <div class="personPhoto">
      {c.photo ? <img src={c.photo} alt={c.name} /> : c.name.split(' ').slice(0, 2).map((w) => w.charAt(0)).join('').toUpperCase()}
    </div>
    <div>
      <h1 class="name">{c.name}</h1>
      {c.alias && <div class="alias">“{c.alias}”</div>}
      {c.role && <div class="rolebar">{c.role}
        {c.socialLinks && (c.socialLinks.youtube || c.socialLinks.x) && (
          <span class="social">
            {c.socialLinks.youtube && <a href={c.socialLinks.youtube} target="_blank" rel="noopener">YouTube</a>}
            {c.socialLinks.x && <a href={c.socialLinks.x} target="_blank" rel="noopener">X</a>}
          </span>
        )}
      </div>}
      <p class="pageLede" style="max-width:640px;">{c.bio}</p>
      {c.bioMore && <p style="color:var(--ink); font-size:.92rem; line-height:1.6; max-width:620px; margin-top:8px;">{c.bioMore}</p>}
      <div class="facts">
        {c.basedIn && <span style="display:inline-flex; align-items:center; gap:5px;"><Icon name="pin" size={14} /> {c.basedIn}</span>}
        {c.studio && <span>Studio: {c.studio.slug ? <a href={`/studios/${c.studio.slug}`} style="color:var(--blue); font-weight:600;">{c.studio.name}</a> : c.studio.name}</span>}
        {c.knownFor.length > 0 && <span>Known for: {c.knownFor.join(', ')}</span>}
        <span>{films.length} film{films.length === 1 ? '' : 's'} in catalog</span>
      </div>
    </div>

    {awardsList.length > 0 && (
      <aside class="awardsCol" aria-label="Awards">
        <h2>Awards &amp; Recognition</h2>
        <div class="awardsScroll">
          {awardsList.map((a) => (
            <div class="awardRow"><span class="ico"><Icon name="laurel" size={16} /></span><div><strong>{a.title}</strong>{a.note && <span>{a.note}</span>}</div></div>
          ))}
        </div>
      </aside>
    )}
  </div>

  {films.length > 0 && (
    <>
      <div class="headingbar">
        <h2 style="margin:0;">Filmography <span style="color:var(--muted);font-weight:400;">({films.length})</span></h2>
        <div class="controls">
          <button class="pill" data-kind="all" aria-pressed="true">All ({films.length})</button>
          <button class="pill" data-kind="movie" aria-pressed="false">Movie ({movieCount})</button>
          <button class="pill" data-kind="series" aria-pressed="false">Series ({seriesCount})</button>
          <select class="sortSelect" id="filmSort">
            <option value="newest">Newest</option>
            <option value="oldest">Oldest</option>
            <option value="title">A–Z</option>
          </select>
        </div>
      </div>
      <div class="films-grid" id="filmsGrid">
        {films.map((f) => (
          <a href={`/movies/${f.id}`} data-kind={f.data.type} data-year={f.data.year} data-title={f.data.title}>
            <div class="thumb">{f.data.poster ? <img src={f.data.poster} alt={f.data.title} loading="lazy" /> : <div class="posterFallback" style="width:100%;height:100%;">{f.data.title}</div>}</div>
            <h3>{f.data.title}</h3>
            <div class="meta">{f.data.year} · {f.data.type === 'series' ? 'Series' : 'Movie'}</div>
          </a>
        ))}
      </div>
    </>
  )}

  {creativeStack.length > 0 && (
    <section class="stackSection" aria-labelledby="stack-heading">
      <h2 id="stack-heading">Creative stack</h2>
      <p class="stackLede">Tools used across {c.name}'s films, aggregated from AIMB catalog credits.</p>
      <div class="stackWrap">
        <button class="carouselBtn left" id="prevTool" aria-label="Scroll tools left" type="button">←</button>
        <div class="toolScroll" id="toolScroll">
          {creativeStack.map((t) => (
            <div class="toolCard">
              <span class="toolmark" style={`background:${t.meta.bg};color:${t.meta.fg};${t.meta.border ? `border:1px solid ${t.meta.border};` : ''}`}>{t.meta.icon}</span>
              <strong>{t.name}</strong>
              <small>{t.count} film{t.count === 1 ? '' : 's'}</small>
            </div>
          ))}
        </div>
        <button class="carouselBtn right" id="nextTool" aria-label="Scroll tools right" type="button">→</button>
      </div>
    </section>
  )}

  <script is:inline>
    (function () {
      var grid = document.getElementById('filmsGrid');
      if (!grid) return;
      var cards = [].slice.call(grid.children);
      var pills = [].slice.call(document.querySelectorAll('.pill'));
      var sortSelect = document.getElementById('filmSort');
      var kind = 'all';

      function render() {
        var list = cards.filter(function (c) { return kind === 'all' || c.dataset.kind === kind; });
        var mode = sortSelect.value;
        list.sort(function (a, b) {
          if (mode === 'oldest') return Number(a.dataset.year) - Number(b.dataset.year);
          if (mode === 'title') return a.dataset.title.localeCompare(b.dataset.title);
          return Number(b.dataset.year) - Number(a.dataset.year);
        });
        cards.forEach(function (c) { c.hidden = true; });
        list.forEach(function (c) { c.hidden = false; });
        grid.replaceChildren.apply(grid, list.concat(cards.filter(function (c) { return list.indexOf(c) === -1; })));
      }
      pills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          kind = pill.dataset.kind;
          pills.forEach(function (p) { p.setAttribute('aria-pressed', String(p === pill)); });
          render();
        });
      });
      sortSelect.addEventListener('change', render);
      render();
    })();
  </script>

  <script is:inline>
    (function () {
      var scroll = document.getElementById('toolScroll');
      if (!scroll) return;
      var prev = document.getElementById('prevTool');
      var next = document.getElementById('nextTool');
      prev.addEventListener('click', function () { scroll.scrollBy({ left: -340, behavior: 'smooth' }); });
      next.addEventListener('click', function () { scroll.scrollBy({ left: 340, behavior: 'smooth' }); });
    })();
  </script>
</BaseLayout>
