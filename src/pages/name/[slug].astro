---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const creators = await getCollection('creators');
  return creators.map((creator) => ({
    params: { slug: creator.id },
    props: { creator },
  }));
}

interface Props {
  creator: CollectionEntry<'creators'>;
}
const { creator } = Astro.props;
const c = creator.data;

const movies = await getCollection('movies');
const films = c.films
  .map((slug) => movies.find((m) => m.id === slug))
  .filter((m): m is CollectionEntry<'movies'> => Boolean(m));
---
<BaseLayout title={c.name} description={c.bio}>
  <div class="personTop" style="display:grid; grid-template-columns: 1fr; gap:28px; margin: 30px 0 8px;">
    <div class="personPhoto" style="width:100%; max-width:260px; aspect-ratio:3/4; border-radius:14px; overflow:hidden; background:linear-gradient(135deg,#4f46e5,#8b7bf0); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:800; font-size:3rem; font-family:Georgia,serif;">
      {c.photo ? <img src={c.photo} alt={c.name} style="width:100%;height:100%;object-fit:cover;display:block;" /> : c.name.split(' ').slice(0,2).map((w) => w.charAt(0)).join('').toUpperCase()}
    </div>
    <div class="personInfo">
      <h1 class="personName">{c.name}</h1>
      <h2 class="personAboutH">About</h2>
      <dl class="personKv" style="display:grid; grid-template-columns:150px 1fr; row-gap:12px; column-gap:16px; font-size:.88rem;">
        {c.role && (<><dt style="color:var(--muted);">Career</dt><dd>{c.role}</dd></>)}
        {c.studio && (
          <>
            <dt style="color:var(--muted);">Studio</dt>
            <dd>{c.studio.slug ? <a href={`/studios/${c.studio.slug}`} style="color:var(--accent); font-weight:600;">{c.studio.name}</a> : c.studio.name}</dd>
          </>
        )}
        {c.basedIn && (<><dt style="color:var(--muted);">Based in</dt><dd>{c.basedIn}</dd></>)}
        {c.knownFor.length > 0 && (
          <>
            <dt style="color:var(--muted);">Known for</dt>
            <dd>{c.knownFor.join(', ')}</dd>
          </>
        )}
        <dt style="color:var(--muted);">Films in catalog</dt><dd>{films.length}</dd>
      </dl>
      <p class="personBioShort">{c.bio}</p>
      {c.bioMore && <p style="color:var(--fg); font-size:.88rem; line-height:1.55; max-width:600px; margin-top:10px;">{c.bioMore}</p>}
    </div>
  </div>

  {films.length > 0 && (
    <>
      <div class="filmsHeadRow" style="display:flex; align-items:baseline; justify-content:space-between; margin:34px 0 10px;">
        <h2 style="margin:0">Films</h2>
      </div>
      <div class="cardGrid" style="display:flex; flex-wrap:wrap; gap:14px;">
        {films.map((f) => (
          <a class="card" href={`/movies/${f.id}`} style="flex:0 1 220px; display:block; border:1px solid var(--border); border-radius:8px; overflow:hidden;">
            <div class="thumb" style="aspect-ratio:16/9; background:linear-gradient(135deg,#f0ebe0,#f7f3ee); overflow:hidden; display:flex; align-items:center; justify-content:center;">
              {f.data.poster ? (
                <img src={f.data.poster} alt={f.data.title} style="width:100%;height:100%;object-fit:cover;display:block;" />
              ) : (
                <span style="text-align:center; padding:6px; font-weight:600; font-size:.74rem; color:var(--muted);">{f.data.title}</span>
              )}
            </div>
            <div class="body" style="padding:12px;">
              <div class="title-row"><strong>{f.data.title}</strong></div>
              <div class="meta" style="color:var(--muted); font-size:.74rem;">{f.data.year} · {f.data.type === 'series' ? 'Series' : 'Movie'}</div>
            </div>
          </a>
        ))}
      </div>
    </>
  )}
</BaseLayout>
