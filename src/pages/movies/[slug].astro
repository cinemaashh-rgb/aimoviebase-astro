---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getToolMeta } from '../../data/toolMeta';
import { widePoster } from '../../lib/images';
import { resolveCreatorSlug, resolveStudioSlug } from '../../lib/links';

export async function getStaticPaths() {
  const movies = await getCollection('movies');
  const lists = await getCollection('lists');

  return movies.map((movie) => {
    // "More like this" / "Related" — picked at build time from other
    // movies sharing a genre, per the brief ("automatically picked random
    // movies of the same genre, computed at build time, not stored data").
    const sameGenre = movies.filter(
      (other) => other.id !== movie.id && other.data.genres.some((g) => movie.data.genres.includes(g))
    );
    const pool = sameGenre.length > 0 ? sameGenre : movies.filter((other) => other.id !== movie.id);
    const related = [...pool].sort(() => Math.random() - 0.5).slice(0, 4);

    const inLists = lists.filter((l) => l.data.movies.includes(movie.id));

    return {
      params: { slug: movie.id },
      props: { movie, related, inLists },
    };
  });
}

interface Props {
  movie: CollectionEntry<'movies'>;
  related: CollectionEntry<'movies'>[];
  inLists: CollectionEntry<'lists'>[];
}
const { movie, related, inLists } = Astro.props;
const m = movie.data;
const isSeries = m.type === 'series';

// `director.slug` / a studio catalog page aren't always hand-filled on the
// movie record itself (24 of 37 movies have no director.slug even where a
// matching creator page exists) — resolve by name against the creators/
// studios collections so the sidebar links whenever a real page exists,
// falling back to any explicit slug already set.
const allCreators = await getCollection('creators');
const allStudios = await getCollection('studios');
const directorSlug = m.director?.slug ?? resolveCreatorSlug(m.director?.name, allCreators);
const studioSlug = resolveStudioSlug(m.studio, allStudios);

// The film-page mockup's ".details" line reads "2026 · 24 min · Sci-Fi ·
// Drama" — year, runtime/season info, then every genre inline (not just a
// country). We don't carry a separate marketing "tags" list (only
// `genres`), so the .tags row below the synopsis reuses genres too — same
// as the previous version of this page.
const detailsParts: string[] = [String(m.year)];
if (isSeries) {
  const seasonLabel = m.seasons ? `${m.seasons} Season${m.seasons > 1 ? 's' : ''}` : '1 Season';
  detailsParts.push(m.episodes && m.episodes.length > 0 ? `${seasonLabel} (${m.episodes.length} episodes)` : seasonLabel);
} else if (m.duration) {
  detailsParts.push(m.duration);
}
if (m.country) detailsParts.push(m.country);
detailsParts.push(...m.genres);
---
<BaseLayout title={m.title} description={m.synopsis}>
  <style>
    .crumb { font-size: .78rem; color: var(--muted); margin: 0 0 20px; }
    .crumb a:hover { color: var(--blue); }
    .crumb span { padding: 0 8px; color: var(--muted2); }
    .columns { display: grid; grid-template-columns: minmax(0,1fr) 250px; gap: 32px; align-items: start; }
    .hero { display: grid; grid-template-columns: 200px minmax(0,1fr); gap: 26px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
    .heroPoster { width: 200px; aspect-ratio: 207/344; object-fit: cover; border-radius: 5px; border: 1px solid var(--line); box-shadow: 0 1px 3px rgba(0,0,0,.08); display: block; background: var(--soft); }
    .eyebrow { color: var(--muted2); font-size: .8rem; margin: 6px 0 2px; }
    h1.title { font-size: clamp(30px,3.8vw,48px); margin: 3px 0 6px; letter-spacing: -0.03em; line-height: 1.08; }
    .factsLine { color: var(--muted); margin-bottom: 14px; }
    .factsLine span { padding: 0 6px; color: var(--muted2); }
    .synopsis { color: #566177; font-size: .96rem; line-height: 1.55; max-width: 540px; margin-bottom: 15px; }
    .tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 17px; }
    .tag { background: var(--soft); color: var(--muted); border-radius: 4px; font-size: .76rem; padding: 5px 11px; }
    .actions { display: flex; align-items: center; gap: 10px; }
    .watch { display: inline-flex; align-items: center; justify-content: center; gap: 11px; background: var(--black); border: 1px solid var(--black); color: #fff; border-radius: 5px; min-width: 185px; height: 46px; font-weight: 600; font-size: .9rem; }
    .watch:hover { opacity: .88; color: #fff; }
    .watch[disabled] { opacity: .5; cursor: default; }
    .play { width: 0; height: 0; border-left: 11px solid currentColor; border-top: 6px solid transparent; border-bottom: 6px solid transparent; }
    .shareBtn { width: 46px; height: 46px; border-radius: 6px; border: 1px solid var(--line); background: #fff; color: var(--ink); display: inline-flex; align-items: center; justify-content: center; }
    .shareBtn:hover { border-color: #aab2bd; color: var(--ink); }
    #shareStatus { font-size: .78rem; color: var(--muted); margin-top: 8px; min-height: 1em; }

    .block { padding: 24px 0 26px; border-top: 1px solid var(--line); margin-top: 26px; }
    .block h2 { font-size: 1.5rem; margin: 0 0 14px; }
    .reactions { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; }
    .reaction { min-height: 140px; border: 1px solid var(--line); border-radius: 6px; padding: 15px 14px 12px; display: flex; flex-direction: column; gap: 12px; }
    .reactionTop { display: flex; align-items: flex-start; gap: 12px; }
    .ytBadge { display: inline-flex; width: 26px; min-width: 26px; height: 18px; border-radius: 5px; align-items: center; justify-content: center; background: var(--black); color: #fff; font-size: 10px; margin-top: 2px; }
    .reaction .quote { color: #566177; font-size: .9rem; line-height: 1.55; margin: 0; }
    .reaction .author { color: var(--muted); font-size: .78rem; margin-top: auto; padding-left: 38px; }

    .review h2 { display: flex; align-items: center; gap: 13px; }
    .seal { width: 30px; height: 30px; flex: 0 0 auto; border: 2px solid var(--ink); border-radius: 50%; display: grid; place-items: center; font-size: 19px; }
    .review p { color: #657086; font-size: .95rem; line-height: 1.6; max-width: 680px; margin: 0 0 14px; }
    .verdict { display: grid; grid-template-columns: 105px 1fr; gap: 20px; align-items: center; background: var(--soft); border-radius: 5px; padding: 17px 19px; margin-top: 16px; max-width: 680px; }
    .verdict strong { font-weight: 600; border-right: 1px solid var(--line); padding-right: 20px; }
    .verdict p { color: var(--ink); margin: 0; font-size: .92rem; }

    .related { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; }
    /* 16/9 matches the real -wide.webp crops on disk (960x540/1200x675);
       the previous 2/1 ratio forced them into a shape they aren't, cropping
       off real image content on every poster that has a wide version. */
    .related img, .related .posterFallback { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 5px; margin-bottom: 8px; display: block; background: var(--soft); }
    .related strong { display: block; font-family: var(--serif); font-size: .95rem; line-height: 1.28; color: var(--ink); font-weight: 700; }
    .related small { color: var(--muted2); display: block; margin-top: 4px; font-size: .78rem; }

    .sidebar { border: 1px solid var(--line); border-radius: 6px; padding: 0 16px; background: #fff; }
    .sideSection { padding: 16px 0; border-bottom: 1px solid var(--line); }
    .sideSection:last-child { border-bottom: 0; }
    .sideSection h3 { font-size: 1.05rem; margin: 0 0 12px; }
    .sideLink { display: flex; align-items: center; justify-content: space-between; gap: 10px; color: var(--ink); font-weight: 600; font-size: .92rem; }
    .sideLink .arrow { font-size: 1.4rem; font-weight: 300; color: var(--muted2); }
    .person b { font-family: var(--serif); font-weight: 700; display: block; }
    .crewRow { margin: 0 0 11px; }
    .crewRow:last-child { margin-bottom: 0; }
    .crewRow strong { font-family: var(--serif); font-size: .9rem; font-weight: 600; display: block; }
    .crewRow .role { display: block; color: var(--muted2); margin-top: 1px; font-size: .78rem; }
    .toolRow { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; font-size: .82rem; }
    .toolRow:last-child { margin-bottom: 0; }
    .toolIcon { width: 30px; height: 30px; border-radius: 7px; display: grid; place-items: center; font-weight: 750; font-size: .95rem; flex-shrink: 0; }
    .toolRow strong { display: block; font-weight: 600; }
    .toolRow small { display: block; font-size: .72rem; color: var(--muted2); }
    .awardChip { font-size: .82rem; padding: 6px 0; color: var(--ink); border-top: 1px dashed var(--line); }
    .awardChip:first-child { border-top: 0; }
    .listRow { display: block; font-size: .82rem; padding: 9px 0; color: var(--ink); border-top: 1px solid var(--line); }
    .listRow:first-child { border-top: 0; }
    .listRow strong { display: block; font-weight: 600; }
    .listRow small { color: var(--muted2); font-size: .76rem; }

    @media (max-width: 860px) {
      .columns { grid-template-columns: 1fr; }
      .hero { grid-template-columns: 150px minmax(0,1fr); gap: 18px; }
      .heroPoster { width: 150px; }
      .related { grid-template-columns: repeat(2,minmax(0,1fr)); }
      .reactions { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .watch { min-width: 0; flex: 1; }
      .verdict { grid-template-columns: 1fr; gap: 8px; }
      .verdict strong { border-right: 0; padding-right: 0; }
    }
  </style>

  <p class="crumb"><a href="/">Home</a><span>›</span><a href="/movies">AI Movies</a><span>›</span>{m.title}</p>

  <div class="columns">
    <div>
      <div class="hero">
        {m.poster ? <img class="heroPoster" src={m.poster} alt={m.title} /> : <div class="heroPoster posterFallback">{m.title}</div>}
        <div>
          <div class="eyebrow">{isSeries ? 'AI Series' : 'AI Movie'}</div>
          <h1 class="title">{m.title}</h1>
          <div class="factsLine">{detailsParts.map((part, i) => <>{i > 0 && <span>·</span>}{part}</>)}</div>
          {m.synopsis && <p class="synopsis">{m.synopsis}</p>}
          {m.genres.length > 0 && (
            <div class="tags">{m.genres.map((g) => <span class="tag">{g}</span>)}</div>
          )}
          <div class="actions">
            {m.youtubeId ? (
              <button class="watch" type="button" onclick={`openTrailer('${m.youtubeId}')`}><span class="play"></span> Watch</button>
            ) : (
              <button class="watch" type="button" disabled title="No trailer linked yet"><span class="play"></span> Watch</button>
            )}
            <button class="shareBtn" data-share data-title={m.title} aria-label="Share this film" title="Share this film">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.7 10.7 6.6-4.3M8.7 13.3l6.6 4.3"/></svg>
            </button>
          </div>
          <p id="shareStatus" role="status"></p>
        </div>
      </div>

      {m.audienceReactions && m.audienceReactions.length > 0 && (
        <section class="block">
          <h2>Audience reactions</h2>
          <div class="reactions">
            {m.audienceReactions.map((r) => (
              <div class="reaction">
                <div class="reactionTop">
                  <span class="ytBadge" aria-hidden="true">▶</span>
                  <p class="quote">"{r.quote}"</p>
                </div>
                <div class="author">— {r.author}</div>
              </div>
            ))}
          </div>
        </section>
      )}

      {m.editorialReview && (
        <section class="block review">
          <h2><span class="seal" aria-hidden="true">★</span>AIMB editorial review</h2>
          {m.editorialReview.paragraphs.map((p) => <p>{p}</p>)}
          <div class="verdict"><strong>Verdict</strong><p>{m.editorialReview.verdict}</p></div>
        </section>
      )}

      {related.length > 0 && (
        <section class="block">
          <h2>{isSeries ? 'Related' : 'More like this'}</h2>
          <div class="related">
            {related.map((f) => (
              <a href={`/movies/${f.id}`} style="display:block;">
                {f.data.poster ? (
                  <img src={widePoster(f.data.poster)} alt={f.data.title} loading="lazy" />
                ) : (
                  <div class="posterFallback">{f.data.title}</div>
                )}
                <strong>{f.data.title}</strong>
                <small>{f.data.year} · {f.data.type === 'series' ? 'AI Series' : 'AI Movie'}</small>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <aside class="sidebar">
      {m.director && (
        <div class="sideSection">
          <h3>{isSeries ? 'Creator' : 'Director'}</h3>
          {directorSlug ? (
            <a class="sideLink" href={`/name/${directorSlug}`}><span class="person"><b>{m.director.name}</b></span><span class="arrow">›</span></a>
          ) : (
            <div class="sideLink">{m.director.name}</div>
          )}
        </div>
      )}

      {m.studio && (
        <div class="sideSection">
          <h3>Studio</h3>
          {studioSlug ? (
            <a class="sideLink" href={`/studios/${studioSlug}`}><span class="person"><b>{m.studio}</b></span><span class="arrow">›</span></a>
          ) : (
            <div class="sideLink">{m.studio}</div>
          )}
        </div>
      )}

      {m.crew && m.crew.length > 0 && (
        <div class="sideSection">
          <h3>{isSeries ? 'Team' : 'Crew'}</h3>
          {m.crew.map((c) => (
            <div class="crewRow">
              <strong>{c.slug ? <a href={`/name/${c.slug}`} style="color:var(--ink);">{c.name}</a> : c.name}</strong>
              <span class="role">{c.role}</span>
            </div>
          ))}
        </div>
      )}

      {m.aiTools.length > 0 && (
        <div class="sideSection">
          <h3>Production tools</h3>
          {m.aiTools.map((t) => {
            const meta = getToolMeta(t);
            return (
              <div class="toolRow">
                <span class="toolIcon" style={`background:${meta.bg};color:${meta.fg};${meta.border ? `border:1px solid ${meta.border};` : ''}`}>{meta.image ? <img src={meta.image} alt="" width="20" height="20" style="border-radius:5px;" /> : meta.icon}</span>
                <span><strong>{t}</strong><small>{meta.category}</small></span>
              </div>
            );
          })}
        </div>
      )}

      {m.awards.length > 0 && (
        <div class="sideSection">
          <h3>Awards</h3>
          {m.awards.map((a) => <div class="awardChip">{a}</div>)}
        </div>
      )}

      {inLists.length > 0 && (
        <div class="sideSection">
          <h3>Lists</h3>
          {inLists.map((l) => (
            <a class="listRow" href={`/lists/${l.id}`}><strong>{l.data.name}</strong><small>{l.data.movies.length} films</small></a>
          ))}
        </div>
      )}
    </aside>
  </div>

  {isSeries && m.episodes && m.episodes.length > 0 && (
    <section class="block">
      <h2>Episodes</h2>
      <ul style="padding-left:1.1rem;">
        {m.episodes.map((ep) => (
          <li style="margin-bottom:6px;">
            {ep.title}
            {ep.youtubeId && (
              <button onclick={`openTrailer('${ep.youtubeId}')`} style="margin-left:8px;background:none;border:1px solid var(--blue);color:var(--blue);border-radius:4px;cursor:pointer;padding:1px 8px;font-size:.78rem;">▶</button>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <script is:inline define:vars={{ title: m.title }}>
    document.addEventListener('DOMContentLoaded', function () {
      var btn = document.querySelector('[data-share]');
      var status = document.getElementById('shareStatus');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var url = window.location.href;
        if (navigator.share) {
          navigator.share({ title: title, url: url }).catch(function () {});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(function () {
            if (status) status.textContent = 'Link copied to clipboard';
          });
        }
      });
    });
  </script>
</BaseLayout>
