---
interface Props {
  title: string;
  description?: string;
  // AI Short Drama pages run their own independent catalog (see
  // search-data.js.ts) and are deliberately left out of the global
  // search index, so the global search box is hidden on those pages
  // rather than offered with results it can never actually return.
  hideSearch?: boolean;
  // Open Graph preview image. Accepts a site-root-relative path (e.g. a
  // catalog poster, "/images/posters/x-wide.webp") or an absolute URL.
  // Falls back to the site-wide default below — every page gets a real
  // OG image, not just the ones that pass one in. VK, Telegram and
  // Facebook all read the same og:* tags (no separate VK/Telegram meta
  // format needed); Telegram additionally wants an absolute image URL,
  // which is why this is always resolved against Astro.site below rather
  // than left relative.
  image?: string;
  imageAlt?: string;
  // "article" for movie/news detail pages gives richer unfurls on
  // platforms that branch on og:type (Telegram in particular shows a
  // bigger preview card for "article" than for "website" in some
  // clients); everything else stays "website".
  ogType?: 'website' | 'article';
}
const {
  title,
  description = 'AI Movie Base — catalog of AI-generated films.',
  hideSearch = false,
  image = '/images/og/default.jpg',
  imageAlt = 'AI Movie Base',
  ogType = 'website',
} = Astro.props;

const ogImageURL = new URL(image, Astro.site).href;
const fullTitle = `${title} | AI Movie Base`;

// Canonical URL, derived automatically for every page that renders this layout.
// Astro.site comes from astro.config.mjs ("https://aimoviebase.com", non-www —
// this is the single canonical domain form for the whole site; see README for
// the GA4 www discrepancy that needs aligning separately in Vercel/DNS/GA4).
// Astro.url.pathname always has no trailing slash here because
// trailingSlash:false is set in both vercel.json and this site's routing, so
// every internal link and every canonical tag agree on the same format.
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = new URL(canonicalPath, Astro.site).href;

const currentPath = canonicalPath;
function isActive(prefix: string) {
  return currentPath === prefix || currentPath.startsWith(prefix + '/');
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/favicon.ico" />

  <!-- Open Graph: read by VK, Telegram, Facebook (and most other
       unfurlers) off the same tag set, no platform-specific variants
       needed. og:image is always an absolute URL (see ogImageURL above) —
       Telegram in particular won't resolve a relative one. -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="AI Movie Base" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter/X falls back to the og:* tags above for title/description/
       image when summary_large_image is declared, so no duplicate
       og:title-equivalent is needed here. -->
  <meta name="twitter:card" content="summary_large_image" />
  <!-- Inter: the sans-serif the real mockups themselves specify in their own
       --sans token, swapped in for the Arial/Helvetica fallback stack. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-P7NMTTEBQ6"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-P7NMTTEBQ6');
  </script>
  <!-- Microsoft Clarity -->
  <script is:inline>
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "z9vu5wi0bs");
  </script>
  <style>
    /*
      Canonical design tokens for the whole site, consolidated from the 12
      HTML mockups supplied for the redesign (each file defined a slightly
      different :root — different variable names, different near-black
      header hex values, different blue-accent hex). This set follows the
      About-page mockup's own tokens, since that file was explicitly called
      out as the global theme source; every other page's design is mapped
      onto these names rather than keeping each mockup's local variables.
      See README "Design tokens" section for the full reconciliation notes.
    */
    :root {
      --ink: #17191d;      /* body text */
      --muted: #5d6776;    /* secondary text */
      --muted2: #727d8e;   /* tertiary / lighter secondary text */
      --line: #e5e7eb;     /* borders, rules */
      --black: #080b0d;    /* header / footer background */
      --blue: #245bb9;     /* accent / links */
      --bg: #fff;          /* page background */
      --soft: #f6f7f9;     /* light panel / card background */
      --serif: Georgia, 'Times New Roman', serif;
      --sans: 'Inter', Arial, Helvetica, sans-serif;

      /* Back-compat aliases: most page templates (and the browser-side
         search box below) were written against this variable naming from
         the pre-redesign dark theme. Keeping the names and repointing the
         values is far less error-prone than rewriting every inline style
         in the same pass as the rest of this task. */
      --fg: var(--ink);
      --accent: var(--blue);
      --bg-elev: var(--soft);
      --border: var(--line);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      -webkit-font-smoothing: antialiased;
    }
    :global(h1), :global(h2), :global(h3) { font-family: var(--serif); line-height: 1.12; letter-spacing: -0.02em; }
    :global(a) { color: inherit; text-decoration: none; }
    :global(a:hover) { color: var(--blue); }
    :global(p) { line-height: 1.55; }

    /* Shared full-bleed utility: breaks a section out of <main>'s
       1200px max-width to the true viewport edge, regardless of screen
       width. Add class="full-bleed" to any section that needs to span
       the full page (dark hero/CTA bands, etc.) instead of re-deriving
       this 100vw/-50vw math per page — that duplication is what let the
       homepage hero, newsletter band, genre hero and awards hero drift
       into four slightly different copies of the same six properties.
       :global() is required: each page's hero/banner lives in that
       page's own scoped <style>, not in BaseLayout's. A full-bleed
       section still needs its own margin-top/bottom, min-height,
       background and color — this utility only owns the horizontal
       break-out. */
    :global(.full-bleed) { width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; }

    .darkHeader {
      background: var(--black);
      color: #fff;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 24px;
      padding: 0 2rem;
      min-height: 62px;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .darkHeader .brand { font-family: var(--serif); font-size: 1.5rem; font-weight: 800; color: #fff; letter-spacing: -0.02em; }
    .darkHeader nav { display: flex; align-items: center; gap: 1.6rem; flex: 1; justify-content: center; flex-wrap: wrap; }
    .darkHeader nav a { color: #d7dae0; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; white-space: nowrap; }
    .darkHeader nav a:hover, .darkHeader nav a.active { color: #fff; }
    .darkHeader .headerRight { display: flex; align-items: center; gap: 14px; margin-left: auto; }
    /* Ember-gold gradient treatment for the header CTA, matching the new
       homepage reference's warm accent palette (sampled from the hero's
       eclipse artwork) rather than a plain white button. */
    .submitBtn {
      position: relative; isolation: isolate; overflow: hidden;
      display: inline-flex; align-items: center; justify-content: center;
      border: 1px solid #c85e43; color: #25100e; font-size: 0.72rem; font-weight: 700;
      padding: 9px 14px; border-radius: 4px; white-space: nowrap;
      background: linear-gradient(112deg,#9f392f 0%,#db6944 22%,#ffbd85 44%,#ee8a55 62%,#b44736 82%,#e9784d 100%);
      background-size: 260% 100%;
      box-shadow: 0 0 0 1px rgba(224,99,63,.16), 0 0 12px rgba(235,108,68,.28);
      animation: aimbGoldSweep 6s ease-in-out infinite;
      transition: box-shadow .25s ease, transform .25s ease;
    }
    .submitBtn:hover, .submitBtn:focus-visible {
      color: #25100e; opacity: 1; transform: translateY(-1px);
      box-shadow: 0 0 0 1px rgba(237,122,80,.42), 0 0 18px rgba(242,115,73,.44);
    }
    @keyframes aimbGoldSweep { 0%, 12% { background-position: 100% 50%; } 54%, 80% { background-position: 0 50%; } 100% { background-position: 100% 50%; } }
    @media (prefers-reduced-motion: reduce) { .submitBtn { animation: none; transition: none; } }

    /* Mobile search: a magnifying-glass trigger opens a full-screen panel,
       matching the reference's mobile header (no hamburger menu — the nav
       itself drops to a horizontally-scrollable second row instead, see
       the max-width:650px block below). Hidden on desktop; the panel
       reuses the same /search-data.js index as the desktop dropdown. */
    .mobileSearchTrigger, .mobileSearchPanel { display: none; }
    .mobileSearchPanel {
      flex-direction: column; position: fixed; inset: 0; z-index: 10000;
      background: #fff; color: var(--ink);
      visibility: hidden; opacity: 0; transform: translateY(8px);
      transition: opacity .17s, transform .17s, visibility .17s;
      padding-top: env(safe-area-inset-top);
    }
    .mobileSearchPanel.is-open { visibility: visible; opacity: 1; transform: none; }
    .mobileSearchTop { display: flex; gap: 12px; align-items: center; padding: 12px 16px; background: #fff; border-bottom: 1px solid var(--line); flex: none; }
    .mobileSearchInputWrap { flex: 1; min-width: 0; display: flex; align-items: center; height: 48px; border: 1px solid var(--line); background: var(--soft); border-radius: 8px; padding: 0 12px; gap: 10px; }
    .mobileSearchInputWrap:focus-within { border-color: var(--ink); background: #fff; box-shadow: 0 0 0 1px var(--ink); }
    .mobileSearchInputWrap svg { width: 20px; height: 20px; stroke: var(--muted); stroke-width: 2; fill: none; flex: none; }
    #mobileSearchInput { border: 0; background: transparent; outline: 0; font-size: 16px; color: var(--ink); min-width: 0; flex: 1; width: 100%; }
    #mobileSearchInput::placeholder { color: var(--muted2); }
    #mobileSearchClear { border: 0; background: none; color: var(--muted); font-size: 22px; line-height: 1; min-width: 28px; cursor: pointer; display: none; }
    #mobileSearchClear.show { display: block; }
    .mobileSearchClose { flex: none; background: transparent; border: 0; padding: 8px 0 8px 4px; font: 600 13px var(--sans); color: var(--ink); cursor: pointer; }
    .mobileSearchScroll { overflow-y: auto; overscroll-behavior: contain; flex: 1; padding-bottom: calc(24px + env(safe-area-inset-bottom)); }
    .mobileSearchLabel { font: 700 11px var(--sans); letter-spacing: .05em; color: var(--muted2); margin: 20px 16px 8px; }
    :global(.mobileSearchResults a) { display: flex; align-items: center; gap: 12px; padding: 12px 16px; min-height: 58px; border-bottom: 1px solid var(--line); color: var(--ink); }
    :global(.mobileSearchResults a:active) { background: var(--soft); }
    .mobileSearchEmpty { padding: 20px 16px; color: var(--muted); font-size: .9rem; }

    .siteSearch { position: relative; width: 210px; flex: none; }
    .searchInput { width: 100%; font-size: .78rem; border-radius: 6px; padding: 8px 12px; outline: none; background: #20252d; border: 1px solid #343b45; color: #fff; }
    .searchInput::placeholder { color: #9aa0ad; }
    .searchResults { display: none; position: absolute; right: 0; left: auto; width: 320px; margin-top: 8px; border-radius: 10px; overflow: hidden; z-index: 60; max-height: 420px; overflow-y: auto; background: #fff; border: 1px solid var(--line); box-shadow: 0 16px 40px rgba(20,25,35,.18); }
    /* :global() required: these nodes are injected into .searchResults via
       innerHTML at runtime (see the search script below), so they never
       carry Astro's build-time style-scoping attribute — unscoped rules
       silently never matched them, letting the thumbnail <img> render at
       native size with no layout at all. Same root cause as the movie-card
       fix above, different trigger (client-side JS instead of a child
       page's <slot /> content). */
    :global(.searchItem) { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-top: 1px solid var(--line); }
    :global(.searchItem:first-child) { border-top: none; }
    :global(.searchItem:hover) { background: var(--soft); }
    :global(.searchThumb) { flex: 0 0 42px; width: 42px; height: 58px; border-radius: 5px; overflow: hidden; background: var(--soft); display: flex; align-items: center; justify-content: center; font-size: .74rem; font-weight: 700; color: var(--muted); border: 1px solid var(--line); }
    :global(.searchThumb img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    :global(.searchInfo) { min-width: 0; flex: 1; }
    :global(.searchTitle) { font-weight: 600; font-size: .85rem; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    :global(.searchSub) { font-size: .72rem; color: var(--muted); margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    :global(.searchEmpty) { padding: 14px 12px; font-size: .85rem; color: var(--muted); }

    main { max-width: 1200px; margin: 0 auto; padding: 2rem; }
    /* Single source of truth for the gap above the footer: ordinary pages
       get it from <main>'s own bottom padding (2rem desktop, 1.25rem
       mobile — see the breakpoint below). A page containing the
       full-bleed .newsletter band needs zero gap there instead, since
       that band's dark background must sit flush against the footer's.
       (Not :last-child — the homepage's inline <script> is main's actual
       last element, so this matches .newsletter anywhere in main, which
       is safe since no other page uses that class.) Zeroing
       padding-bottom here — rather than a compensating negative margin
       on .newsletter or the footer — needs no matching change anywhere
       else: the :has() selector outranks the plain `main` rule above
       (and the mobile override below) by specificity, so it wins at
       every breakpoint without being repeated per page. */
    main:has(> .newsletter) { padding-bottom: 0; }

    .siteFooter { background: var(--black); color: #d2d5d9; padding: 40px 0 24px; }
    .footInner { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
    .footGrid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 32px; }
    .footGrid .footBrand { font-family: var(--serif); font-size: 1.4rem; font-weight: 800; color: #fff; }
    .footGrid p { color: #a3aab5; font-size: .82rem; max-width: 230px; line-height: 1.55; }
    .footGrid h4 { font-size: .74rem; letter-spacing: .05em; text-transform: uppercase; color: #fff; margin: 0 0 10px; font-family: var(--sans); }
    .footGrid a { display: block; font-size: .82rem; margin: 6px 0; color: #bec3ca; }
    .footGrid a:hover { color: #fff; }
    .copyrightBar { color: #9ca2ab; font-size: .74rem; margin-top: 26px; border-top: 1px solid #262a2e; padding-top: 16px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }

    /* Shared catalog card styles reused across homepage, movies index, genre
       and studio pages — ported from the mockups' `.film-card` pattern.
       :global() is required here: this markup is rendered by child pages
       through <slot />, and Astro scopes each component's <style> block to
       elements it renders itself — without :global these rules silently
       never matched the slotted cards (harmless while posters were missing
       placeholders, but it meant real poster images rendered at native
       pixel size with no object-fit once added — see README). */
    :global(.movieGrid) { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 1.1rem 1rem; }
    :global(.movieCard) { display: block; min-width: 0; }
    :global(.movieCard img), :global(.movieCard .posterFallback) { width: 100%; aspect-ratio: 2/3; object-fit: cover; display: block; border-radius: 5px; background: var(--soft); }
    :global(.posterFallback) { display: flex; align-items: center; justify-content: center; text-align: center; padding: 10px; font-weight: 600; font-size: .78rem; color: var(--muted); font-family: var(--serif); }
    :global(.movieCard .cardBody) { padding-top: .5rem; }
    :global(.movieCard h3) { font-size: .95rem; font-family: var(--sans); font-weight: 700; margin: 0 0 .2rem; color: var(--ink); letter-spacing: 0; }
    :global(.movieCard .meta) { color: var(--muted); font-size: .78rem; }

    :global(.pageEyebrow) { font-size: .72rem; font-weight: 700; letter-spacing: .09em; color: var(--muted2); text-transform: uppercase; }
    :global(.pageLede) { color: var(--muted); max-width: 680px; line-height: 1.6; font-size: 1.02rem; }

    #videoModalOverlay {
      display: none;
      position: fixed; inset: 0; background: rgba(10,12,16,0.82);
      z-index: 100; align-items: center; justify-content: center;
    }
    #videoModalOverlay.open { display: flex; }
    #videoModalOverlay .modalInner { width: min(900px, 90vw); aspect-ratio: 16/9; }
    /* :global(): openTrailer() injects this <iframe> via innerHTML at
       runtime, so — same reasoning as the search dropdown above — it
       never carries the scoping attribute an unscoped rule would need. */
    :global(#videoModalOverlay iframe) { width: 100%; height: 100%; border: 0; }

    @media (max-width: 900px) {
      .footGrid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    }
    @media (max-width: 900px) and (min-width: 651px) {
      .siteSearch { width: 170px; }
    }
    /* Reference's own mobile header breakpoint: nav drops to a second,
       horizontally-scrollable row (no hamburger, always visible) and the
       inline search box is replaced by the full-screen panel trigger. */
    @media (max-width: 650px) {
      .darkHeader { padding: 12px 1rem; gap: 10px; }
      .darkHeader nav {
        order: 3; flex: 1 1 100%; width: 100%; justify-content: flex-start;
        overflow-x: auto; flex-wrap: nowrap; gap: 1.1rem;
        margin: 2px -1rem -2px; padding: 4px 1rem 0;
        scrollbar-width: none;
      }
      .darkHeader nav::-webkit-scrollbar { display: none; }
      .siteSearch { display: none; }
      .mobileSearchTrigger {
        display: flex; align-items: center; justify-content: center;
        border: 0; background: transparent; color: #fff;
        width: 38px; height: 38px; min-width: 38px; cursor: pointer;
      }
      .mobileSearchPanel { display: flex; }
      .submitBtn { padding: 7px 10px; font-size: 10px; }
      main { padding: 1.25rem; }
      /* .footInner's padding was still the desktop 2rem here, 12px wider
         than main's 1.25rem above, so "AIMB" sat 12px to the right of
         content like "You might also like" directly above the footer. */
      .footInner { padding-left: 1.25rem; padding-right: 1.25rem; }
    }
  </style>
</head>
<body>
  <header class="darkHeader" id="aimb-page-top">
    <a href="/" class="brand" aria-label="AIMB home">AIMB</a>
    <nav id="mainNav" aria-label="Main navigation">
      <a href="/movies" class={isActive('/movies') ? 'active' : ''}>AI Movies &amp; Series</a>
      <a href="/short-drama" class={isActive('/short-drama') || isActive('/shortdrama') ? 'active' : ''}>AI Short Drama</a>
      <a href="/lists" class={isActive('/lists') ? 'active' : ''}>Lists</a>
      <a href="/news" class={isActive('/news') ? 'active' : ''}>Journal</a>
      <a href="/awards" class={isActive('/awards') ? 'active' : ''}>Awards</a>
    </nav>
    <div class="headerRight">
      {!hideSearch && (
        <Fragment>
          <div class="siteSearch">
            <input class="searchInput" type="text" placeholder="Search films, creators…" />
            <div class="searchResults"></div>
          </div>
          <a aria-controls="mobileSearchPanel" aria-expanded="false" aria-label="Open search" class="mobileSearchTrigger" href="#mobileSearchPanel" id="mobileSearchTrigger" role="button">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10.8" cy="10.8" r="7.3"></circle><path d="m16.2 16.2 5 5"></path></svg>
          </a>
        </Fragment>
      )}
      <a class="submitBtn" href="/submit-film">Submit a Film</a>
    </div>
  </header>

  {!hideSearch && (
    <div aria-hidden="true" aria-label="Search AIMB" aria-modal="true" class="mobileSearchPanel" id="mobileSearchPanel" role="dialog">
      <div class="mobileSearchTop">
        <div class="mobileSearchInputWrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10.8" cy="10.8" r="7.2"></circle><path d="m16.2 16.2 5.1 5.1"></path></svg>
          <input aria-label="Search films and lists" autocomplete="off" id="mobileSearchInput" inputmode="search" placeholder="Search films, creators, studios…" spellcheck="false" type="search" />
          <button aria-label="Clear search" id="mobileSearchClear" type="button">×</button>
        </div>
        <a aria-label="Close search" class="mobileSearchClose" href="#aimb-page-top" id="mobileSearchClose" role="button">Cancel</a>
      </div>
      <div class="mobileSearchScroll">
        <div class="mobileSearchLabel" hidden id="mobileSearchStatus">SEARCH RESULTS</div>
        <div class="mobileSearchResults" id="mobileSearchResults"></div>
      </div>
    </div>
  )}

  <main>
    <slot />
  </main>
  <footer class="siteFooter">
    <div class="footInner footGrid">
      <div>
        <a class="footBrand" href="/">AIMB</a>
        <p>AI Movie Base — an independent platform to discover AI-generated movies, AI series and the people behind them.</p>
      </div>
      <div>
        <h4>Explore</h4>
        <a href="/movies">AI Movies &amp; Series</a>
        <a href="/short-drama">AI Short Drama</a>
        <a href="/lists">Lists</a>
        <a href="/news">Journal</a>
      </div>
      <div>
        <h4>Community</h4>
        <a href="/awards">Festivals &amp; Awards</a>
        <a href="/about">About AIMB</a>
        <a href="/submit-film">Submit a Film</a>
        <a href="/quality-index">Quality Index</a>
      </div>
      <div>
        <h4>Information</h4>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </div>
    </div>
    <div class="footInner copyrightBar">
      <span>© {new Date().getFullYear()} AIMB. All rights reserved.</span>
      <span>Independent discovery and editorial platform.</span>
    </div>
  </footer>

  <div id="videoModalOverlay">
    <div class="modalInner" id="modalInner"></div>
  </div>
  <script src="/search-data.js" is:inline></script>
  <script is:inline>
    (function () {
      function initials(t) {
        var w = t.replace(/[^\p{L}\p{N} ]/gu, '').trim().split(/\s+/);
        return ((w[0] || '').charAt(0) + (w[1] || '').charAt(0)).toUpperCase();
      }
      function init(root) {
        var input = root.querySelector('.searchInput');
        var box = root.querySelector('.searchResults');
        if (!input || !box) return;
        function render() {
          var q = input.value.trim().toLowerCase();
          box.innerHTML = '';
          if (q.length < 2 || typeof DATA === 'undefined') { box.style.display = 'none'; return; }
          var res = DATA.filter(function (d) { return d.title.toLowerCase().indexOf(q) >= 0; }).slice(0, 12);
          if (res.length === 0) {
            box.innerHTML = '<div class="searchEmpty">No results found</div>';
          } else {
            box.innerHTML = res.map(function (d) {
              var thumb = d.img ? '<img src="' + d.img + '" alt="">' : initials(d.title);
              return '<a class="searchItem" href="' + d.href + '"><div class="searchThumb">' + thumb + '</div><div class="searchInfo"><div class="searchTitle">' + d.title + '</div><div class="searchSub">' + d.sub + '</div></div></a>';
            }).join('');
          }
          box.style.display = 'block';
        }
        input.addEventListener('input', render);
        input.addEventListener('focus', render);
        input.addEventListener('blur', function () { setTimeout(function () { box.style.display = 'none'; }, 150); });
      }
      document.querySelectorAll('.siteSearch').forEach(init);
    })();
  </script>
  <script is:inline>
    function openTrailer(id) {
      var inner = document.getElementById('modalInner');
      inner.innerHTML = '<iframe src="https://www.youtube.com/embed/' + id + '?autoplay=1" allow="autoplay; encrypted-media" allowfullscreen></iframe>';
      document.getElementById('videoModalOverlay').classList.add('open');
    }
    function closeTrailer() {
      document.getElementById('videoModalOverlay').classList.remove('open');
      document.getElementById('modalInner').innerHTML = '';
    }
    document.addEventListener('DOMContentLoaded', function () {
      document.getElementById('videoModalOverlay').addEventListener('click', function (e) {
        if (e.target.id === 'videoModalOverlay') closeTrailer();
      });
    });
  </script>
  <script is:inline>
    (function () {
      var panel = document.getElementById('mobileSearchPanel');
      var trigger = document.getElementById('mobileSearchTrigger');
      var close = document.getElementById('mobileSearchClose');
      var input = document.getElementById('mobileSearchInput');
      var clear = document.getElementById('mobileSearchClear');
      var results = document.getElementById('mobileSearchResults');
      var status = document.getElementById('mobileSearchStatus');
      if (!panel || !trigger) return;

      function initials(t) {
        var w = t.replace(/[^\p{L}\p{N} ]/gu, '').trim().split(/\s+/);
        return ((w[0] || '').charAt(0) + (w[1] || '').charAt(0)).toUpperCase();
      }
      function row(item) {
        var a = document.createElement('a');
        a.href = item.href;
        var thumb = document.createElement('div');
        thumb.className = 'searchThumb';
        if (item.img) { var img = document.createElement('img'); img.src = item.img; img.alt = ''; thumb.appendChild(img); }
        else { thumb.textContent = initials(item.title); }
        var label = document.createElement('div');
        label.className = 'searchInfo';
        var name = document.createElement('div');
        name.className = 'searchTitle';
        name.textContent = item.title;
        var sub = document.createElement('div');
        sub.className = 'searchSub';
        sub.textContent = item.sub;
        label.append(name, sub);
        a.append(thumb, label);
        return a;
      }
      function render() {
        var q = input.value.trim().toLowerCase();
        clear.classList.toggle('show', Boolean(q));
        results.replaceChildren();
        status.hidden = !q;
        if (!q || typeof DATA === 'undefined') return;
        var matches = DATA.filter(function (d) { return d.title.toLowerCase().indexOf(q) >= 0; }).slice(0, 15);
        status.textContent = matches.length ? 'SEARCH RESULTS' : 'NO RESULTS';
        if (!matches.length) {
          var msg = document.createElement('p');
          msg.className = 'mobileSearchEmpty';
          msg.textContent = 'No matches found.';
          results.append(msg);
        } else {
          matches.forEach(function (d) { results.append(row(d)); });
        }
      }
      function sync() {
        var isOpen = location.hash === '#mobileSearchPanel';
        panel.classList.toggle('is-open', isOpen);
        panel.setAttribute('aria-hidden', String(!isOpen));
        trigger.setAttribute('aria-expanded', String(isOpen));
        document.body.style.overflow = isOpen ? 'hidden' : '';
        if (isOpen) { render(); setTimeout(function () { input.focus(); }, 0); }
      }
      window.addEventListener('hashchange', sync);
      trigger.addEventListener('click', function () { setTimeout(sync, 0); });
      close.addEventListener('click', function () { setTimeout(sync, 0); });
      clear.addEventListener('click', function () { input.value = ''; render(); input.focus(); });
      input.addEventListener('input', render);
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          var first = results.querySelector('a');
          if (first) location.href = first.href;
        }
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && location.hash === '#mobileSearchPanel') location.hash = 'aimb-page-top';
      });
      sync();
    })();
  </script>
</body>
</html>
