---
// Small reusable stroke-icon set, replacing the emoji glyphs (📍 🗓 🏆 ☰)
// that had crept into a few pages. Paths are taken from the mockups' own
// inline SVGs where one exists (pin/calendar from the studio mockup,
// laurel from the creator mockup's award rows) rather than invented, so
// icon style stays consistent with the rest of the redesign.
interface Props {
  name: 'menu' | 'pin' | 'calendar' | 'laurel' | 'chevron' | 'external' | 'studio' | 'genre';
  size?: number;
}
const { name, size = 18 } = Astro.props;
---
{name === 'menu' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
)}
{name === 'pin' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21S4 14 4 9a8 8 0 0 1 16 0c0 5-8 12-8 12Z" /><circle cx="12" cy="9" r="2" /></svg>
)}
{name === 'calendar' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 2v6M17 2v6M3 10h18" /><path d="M7 14h3M14 14h3M7 18h3" /></svg>
)}
{name === 'chevron' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
)}
{name === 'external' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 5h6v6m0-6-9 9" /><path d="M18 13v6H5V6h6" /></svg>
)}
{name === 'studio' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 10 12 4l9 6M5 10v10m5-10v10m4-10v10m5-10v10M3 20h18" /></svg>
)}
{name === 'genre' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="2" /><circle cx="9" cy="7" r="1" /><circle cx="16" cy="10" r="1" /><circle cx="9" cy="17" r="1" /></svg>
)}
{name === 'laurel' && (
  <svg width={size * 1.5} height={size} viewBox="0 0 120 80" fill="currentColor" aria-hidden="true">
    <g><rect x="18" y="63" width="9" height="2.4" rx="1.2" transform="rotate(-18 18 63)" /><ellipse cx="24" cy="56" rx="4.2" ry="8.2" transform="rotate(-62 24 56)" /><ellipse cx="21" cy="49" rx="4.2" ry="8.2" transform="rotate(-54 21 49)" /><ellipse cx="19" cy="42" rx="4.2" ry="8.2" transform="rotate(-46 19 42)" /><ellipse cx="18" cy="35" rx="4.2" ry="8.2" transform="rotate(-36 18 35)" /><ellipse cx="19" cy="28" rx="4.2" ry="8.2" transform="rotate(-26 19 28)" /><ellipse cx="22" cy="21" rx="4.2" ry="8.2" transform="rotate(-16 22 21)" /><ellipse cx="28" cy="15" rx="4.2" ry="8.2" transform="rotate(-6 28 15)" /><ellipse cx="35" cy="11" rx="4.2" ry="8.2" transform="rotate(8 35 11)" /><ellipse cx="43" cy="8.8" rx="4.2" ry="8.2" transform="rotate(18 43 8.8)" /></g>
    <g transform="translate(120,0) scale(-1,1)"><rect x="18" y="63" width="9" height="2.4" rx="1.2" transform="rotate(-18 18 63)" /><ellipse cx="24" cy="56" rx="4.2" ry="8.2" transform="rotate(-62 24 56)" /><ellipse cx="21" cy="49" rx="4.2" ry="8.2" transform="rotate(-54 21 49)" /><ellipse cx="19" cy="42" rx="4.2" ry="8.2" transform="rotate(-46 19 42)" /><ellipse cx="18" cy="35" rx="4.2" ry="8.2" transform="rotate(-36 18 35)" /><ellipse cx="19" cy="28" rx="4.2" ry="8.2" transform="rotate(-26 19 28)" /><ellipse cx="22" cy="21" rx="4.2" ry="8.2" transform="rotate(-16 22 21)" /><ellipse cx="28" cy="15" rx="4.2" ry="8.2" transform="rotate(-6 28 15)" /><ellipse cx="35" cy="11" rx="4.2" ry="8.2" transform="rotate(8 35 11)" /><ellipse cx="43" cy="8.8" rx="4.2" ry="8.2" transform="rotate(18 43 8.8)" /></g>
  </svg>
)}
